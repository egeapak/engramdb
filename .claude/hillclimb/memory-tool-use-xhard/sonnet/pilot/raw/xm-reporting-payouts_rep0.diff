+def payout_revenue(month):
+    """Platform revenue from one month's seller payouts, in Decimal major units.
+
+    Only the platform fee is revenue; gross and net are the seller's money.
+    """
+    total = sum(
+        (Decimal(row["fee_minor"]) / 100 for row in load_payout_rows(month)),
+        Decimal(0),
+    )
+    return total.quantize(Decimal("0.0001"))
