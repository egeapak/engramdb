+"""Preview what BankCo would receive for each payout in a JSON file.
+
+Usage: python scripts/payout_preview.py payouts.json
+
+The file holds a list of objects with id, seller_id, amount_minor, currency and iban.
+Only the last 4 characters of the IBAN are printed (bank details are PII).
+"""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from src.payouts.batch import Payout, _format_amount, remittance_text  # noqa: E402
+
+
+def main(path):
+    with open(path) as f:
+        rows = json.load(f)
+    for row in rows:
+        payout = Payout(
+            id=row["id"],
+            seller_id=row["seller_id"],
+            amount_minor=row["amount_minor"],
+            currency=row["currency"],
+            iban=row["iban"],
+        )
+        print(
+            f"{payout.id}  iban=...{payout.iban[-4:]}  "
+            f"amount={_format_amount(payout.amount_minor)} {payout.currency}  "
+            f"remittance={remittance_text(payout)!r}"
+        )
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(f"usage: {sys.argv[0]} payouts.json")
+    main(sys.argv[1])
