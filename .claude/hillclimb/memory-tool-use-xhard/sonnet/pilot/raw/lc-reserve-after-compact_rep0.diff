new file mode 100644
index 0000000..de1fa5f
--- /dev/null
+++ b/scripts/payout_forecast.py
@@ -0,0 +1,37 @@
+"""Forecast what a seller would be paid in today's payout run, given their cleared balance."""
+import argparse
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from src.payouts.batch import MIN_PAYOUT_MINOR, should_pay_out
+
+RESERVE_BPS = 750  # 7.5% rolling reserve, held 14 days (Treasury)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("balance_minor", type=int, help="cleared balance in minor units")
+    parser.add_argument("--currency", default="USD")
+    args = parser.parse_args()
+    if args.balance_minor < 0:
+        parser.error("balance_minor must not be negative")
+
+    # Round the reserve up so we never forecast paying more than Treasury would release.
+    reserve = -(-args.balance_minor * RESERVE_BPS // 10_000)
+    payable = args.balance_minor - reserve
+
+    if should_pay_out(payable, args.currency):
+        print(f"pay out {payable} minor units {args.currency} (balance {args.balance_minor} - reserve {reserve})")
+    else:
+        print(
+            f"pay out 0: payable {payable} (balance {args.balance_minor} - reserve {reserve}) "
+            f"is below the minimum of {MIN_PAYOUT_MINOR}; it carries over to the next run"
+        )
+    print("assumes the seller's KYC check is complete; an unverified seller is never paid", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
