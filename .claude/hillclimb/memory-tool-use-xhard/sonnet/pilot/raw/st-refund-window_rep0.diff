+from datetime import datetime, timedelta, timezone
+
 from .invoices import Invoice
 
-# Days after finalization during which an invoice can be refunded.
-REFUND_WINDOW_DAYS = 180
+# Days after finalization during which an invoice can be refunded (13 months, per the October 2026 terms).
+REFUND_WINDOW_DAYS = 395
 
 
 def refund(invoice: Invoice, amount_cents: int):
+    if invoice.finalized_at is None:
+        raise ValueError("cannot refund an invoice that was never finalized")
+    if datetime.now(timezone.utc) - invoice.finalized_at > timedelta(days=REFUND_WINDOW_DAYS):
+        raise ValueError(f"invoice is outside the {REFUND_WINDOW_DAYS}-day refund window")
     if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
     return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
