 def retry_failed_renewal(sub, invoice, attempt):
-    """Called when the renewal charge for `invoice` failed on `attempt` (1-based)."""
-    raise NotImplementedError
+    """Called when the renewal charge for `invoice` failed on `attempt` (1-based).
+
+    Attempt 1 is the original charge; each failure schedules the next of the
+    three retries (1 h, 6 h, 24 h after the failure). When the last retry
+    fails, the subscription goes `past_due` and the invoice goes to dunning.
+    """
+    if attempt > len(RENEWAL_RETRY_DELAYS_S):
+        sub.status = "past_due"
+        schedule_retries(invoice)
+        log.info("renewal_past_due", subscription_id=sub.id, invoice_id=invoice.id)
+        return
+    # The retry job has its own policy: the backend must not retry a charge itself.
+    enqueue(
+        "subscriptions.retry_charge",
+        {"subscription_id": sub.id, "invoice_id": invoice.id, "attempt": attempt + 1},
+        dedupe_key=f"renewal_retry:{invoice.id}:{attempt + 1}",
+        delays_s=[RENEWAL_RETRY_DELAYS_S[attempt - 1]],
+        max_attempts=1,
+    )
 
 
