 def retry_failed_renewal(sub, invoice, attempt):
-    """Called when the renewal charge for `invoice` failed on `attempt` (1-based)."""
-    raise NotImplementedError
+    """Called when the renewal charge for `invoice` failed on `attempt` (1-based).
+
+    Attempt 1 is the original renewal charge; attempts 2-4 are the retries. Once
+    every retry has failed, the subscription goes `past_due` and the invoice is
+    handed to dunning.
+    """
+    if attempt <= len(RENEWAL_RETRY_DELAYS_S):
+        enqueue(
+            "subscriptions.retry_charge",
+            {"subscription_id": sub.id, "invoice_id": invoice.id, "attempt": attempt + 1},
+            dedupe_key=f"renewal_retry:{invoice.id}:{attempt + 1}",
+            delay_s=RENEWAL_RETRY_DELAYS_S[attempt - 1],
+            # The retry schedule above is the policy; the backend must not add its own.
+            max_attempts=1,
+        )
+        return
+
+    sub.status = "past_due"
+    schedule_retries(invoice)
 
 
