diff --git a/src/subscriptions/proration.py b/src/subscriptions/proration.py
index 3f9a296..200ec15 100644
--- a/src/subscriptions/proration.py
+++ b/src/subscriptions/proration.py
@@ -1,10 +1,21 @@
 """Proration when a subscription changes or ends mid-period."""
-from decimal import ROUND_HALF_EVEN, Decimal
+from datetime import timedelta
+from decimal import ROUND_HALF_DOWN, ROUND_HALF_EVEN, Decimal
+
+_MICROSECOND = timedelta(microseconds=1)
 
 
 def prorate_amount(price_cents, period_start, period_end, at):
     """The part of `price_cents` that covers the unused time from `at` to `period_end`, in cents."""
-    raise NotImplementedError
+    if period_end <= period_start:
+        raise ValueError("period_end must be after period_start")
+    at = min(max(at, period_start), period_end)
+    # Integer microseconds keep the unused fraction exact; only the final amount is rounded,
+    # and an exact half cent stays with Acme (BOPS-41).
+    unused = (period_end - at) // _MICROSECOND
+    total = (period_end - period_start) // _MICROSECOND
+    amount = Decimal(price_cents) * Decimal(unused) / Decimal(total)
+    return int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_DOWN))
 
 
