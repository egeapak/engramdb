index 21f39c6..54f7956 100644
--- a/src/billing/money.py
+++ b/src/billing/money.py
@@ -3,9 +3,12 @@ from dataclasses import dataclass
 
 @dataclass(frozen=True)
 class Money:
+    """An amount of money in integer cents (never float) and its currency code."""
+
     cents: int
     currency: str = "USD"
 
     def __add__(self, other):
+        """The sum of two amounts in the same currency; mixing currencies fails the assertion."""
         assert self.currency == other.currency
         return Money(self.cents + other.cents, self.currency)
