-from decimal import ROUND_HALF_EVEN, Decimal
+from decimal import ROUND_HALF_DOWN, ROUND_HALF_EVEN, Decimal
 
 
 def prorate_amount(price_cents, period_start, period_end, at):
     """The part of `price_cents` that covers the unused time from `at` to `period_end`, in cents."""
-    raise NotImplementedError
+    if period_end <= period_start:
+        raise ValueError("period_end must be after period_start")
+    at = min(max(at, period_start), period_end)
+    # Keep the unused fraction exact and round only the final amount; a half cent stays with us (BOPS-41).
+    unused = Decimal(str((period_end - at).total_seconds())) / Decimal(str((period_end - period_start).total_seconds()))
+    return int((Decimal(price_cents) * unused).quantize(Decimal("1"), rounding=ROUND_HALF_DOWN))
 
 
