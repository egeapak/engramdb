-    """Hand each payout of a run to the background workers that call BankCo."""
-    raise NotImplementedError
+    """Hand each payout of a run to the background workers that call BankCo.
+
+    Transfer jobs are never retried automatically (`max_attempts=1`): BankCo may
+    already have executed a transfer that timed out, and a second request pays
+    the seller twice. The worker sets a failed payout to `needs_review` and
+    enqueues `payouts.manual_review`; a manual retry reuses `bank_request_id`,
+    which BankCo deduplicates on for 30 days.
+    """
+    for payout in payouts:
+        enqueue(
+            "payouts.send_transfer",
+            {"payout_id": payout.id, "bank_request_id": f"payout-{payout.id}"},
+            dedupe_key=f"payout_transfer:{payout.id}",
+            max_attempts=1,
+        )
+        payout.status = "submitted"
 
 
