+++ b/scripts/payout_preview.py
@@ -0,0 +1,40 @@
+"""Preview what BankCo will receive for each payout in a JSON file.
+
+The file holds a list of payouts with the fields of `src.payouts.batch.Payout`:
+`id`, `seller_id`, `amount_minor`, `currency` and `iban`.
+"""
+import argparse
+import json
+
+# BankCo rejects the whole transfer when the remittance text is longer than
+# 35 characters (the SEPA limit), so it is cut to 35 before sending.
+MAX_REMITTANCE_LENGTH = 35
+
+
+def remittance_text(payout_id: str, seller_id: str) -> str:
+    return f"Acme payout {payout_id} for {seller_id}"[:MAX_REMITTANCE_LENGTH]
+
+
+def format_amount(amount_minor: int) -> str:
+    """Major units with exactly two decimals, as BankCo takes them ("1234.50")."""
+    sign = "-" if amount_minor < 0 else ""
+    major, minor = divmod(abs(amount_minor), 100)
+    return f"{sign}{major}.{minor:02d}"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Preview the BankCo transfers for a list of payouts.")
+    parser.add_argument("path", help="JSON file with a list of payouts")
+    args = parser.parse_args()
+    with open(args.path, encoding="utf-8") as f:
+        payouts = json.load(f)
+    for p in payouts:
+        # Bank details are PII: print at most the IBAN's last four characters.
+        print(
+            f"{p['id']}  ****{p['iban'][-4:]}  {format_amount(p['amount_minor'])} {p['currency']}  "
+            f"{remittance_text(p['id'], p['seller_id'])!r}"
+        )
+
+
+if __name__ == "__main__":
+    main()
