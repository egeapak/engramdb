@@ -0,0 +1,30 @@
+import unittest
+from datetime import date
+
+from ingest.source import list_new_files
+
+
+class ListNewFilesTest(unittest.TestCase):
+    def test_lists_the_days_files_in_the_month_folder(self):
+        calls = []
+
+        def list_keys(bucket, prefix):
+            calls.append((bucket, prefix))
+            return [
+                "settlements/2026/10/",
+                "settlements/2026/10/settlement_2026-10-05.csv",
+                "settlements/2026/10/settlement_20261005_2.csv",
+                "settlements/2026/10/settlement_2026-10-04.csv",
+            ]
+
+        keys = list_new_files(date(2026, 10, 5), list_keys)
+
+        self.assertEqual(calls, [("acme-psp-inbound", "settlements/2026/10/")])
+        self.assertEqual(keys, [
+            "settlements/2026/10/settlement_2026-10-05.csv",
+            "settlements/2026/10/settlement_20261005_2.csv",
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
