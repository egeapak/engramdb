@@ -0,0 +1,28 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from src.billing.invoices import Invoice
+from src.billing.refunds import REFUND_WINDOW_DAYS, refund
+
+FINALIZED = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def _invoice(finalized_at=FINALIZED):
+    return Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=200, finalized_at=finalized_at)
+
+
+def test_refund_inside_window():
+    now = FINALIZED + timedelta(days=REFUND_WINDOW_DAYS)
+    assert refund(_invoice(), 500, now=now) == {"invoice_id": "inv_1", "refunded_cents": 500}
+
+
+def test_refund_outside_window_is_refused():
+    now = FINALIZED + timedelta(days=REFUND_WINDOW_DAYS, seconds=1)
+    with pytest.raises(ValueError, match=f"{REFUND_WINDOW_DAYS} days"):
+        refund(_invoice(), 500, now=now)
+
+
+def test_refund_of_unfinalized_invoice_is_refused():
+    with pytest.raises(ValueError, match="not been finalized"):
+        refund(_invoice(finalized_at=None), 500)
