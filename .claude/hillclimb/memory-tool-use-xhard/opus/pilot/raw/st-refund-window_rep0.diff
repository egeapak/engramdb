+# Days after finalization during which an invoice can be refunded (13 months, October 2026 terms).
+REFUND_WINDOW_DAYS = 395
 
 
-def refund(invoice: Invoice, amount_cents: int):
+def refund(invoice: Invoice, amount_cents: int, *, now: datetime | None = None):
+    if invoice.finalized_at is None:
+        raise ValueError("cannot refund an invoice that has not been finalized")
+    now = now or datetime.now(timezone.utc)
+    if now > invoice.finalized_at + timedelta(days=REFUND_WINDOW_DAYS):
+        raise ValueError(f"refund window of {REFUND_WINDOW_DAYS} days after finalization has passed")
     if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
     return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
