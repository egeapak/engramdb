 """Load one settlement file into the billing database."""
 import csv
+import hashlib
 import io
 
 from .parse import parse_row
 
 
 def load_file(name, data, db):
-    """Parse settlement file `name` (its bytes are `data`) and insert its rows through `db`."""
+    """Parse settlement file `name` (its bytes are `data`) and insert its rows through `db`.
+
+    The PSP redelivers files and reuses names with corrected content, so a file
+    counts as already loaded when the SHA-256 of its bytes is in
+    `loaded_files.content_sha256`, whatever its name. Already loaded files are
+    skipped and 0 is returned.
+    """
+    content_sha256 = hashlib.sha256(data).hexdigest()
+    if db.is_file_loaded(content_sha256):
+        return 0
     rows = [parse_row(r) for r in csv.DictReader(io.StringIO(data.decode("utf-8")))]
     db.insert_settlements(rows)
+    db.mark_file_loaded(name, content_sha256)
     return len(rows)
diff --git a/services/ingest/tests/test_loader.py b/services/ingest/tests/test_loader.py
new file mode 100644
index 0000000..1a565bc
--- /dev/null
+++ b/services/ingest/tests/test_loader.py
@@ -0,0 +1,44 @@
+import unittest
+
+from ingest.loader import load_file
+
+HEADER = b"reference,merchant_reference,currency,amount,status\n"
+
+
+class FakeDb:
+    def __init__(self):
+        self.loaded = {}
+        self.inserts = 0
+
+    def is_file_loaded(self, content_sha256):
+        return content_sha256 in self.loaded
+
+    def mark_file_loaded(self, name, content_sha256):
+        self.loaded[content_sha256] = name
+
+    def insert_settlements(self, rows):
+        self.inserts += 1
+
+
+class LoadFileDedupeTest(unittest.TestCase):
+    def test_same_bytes_are_loaded_once(self):
+        db = FakeDb()
+        load_file("settlement_2026-10-01.csv", HEADER, db)
+        load_file("settlement_2026-10-01.csv", HEADER, db)
+        self.assertEqual(db.inserts, 1)
+
+    def test_same_bytes_under_another_name_are_skipped(self):
+        db = FakeDb()
+        load_file("settlement_2026-10-01.csv", HEADER, db)
+        load_file("settlement_2026-10-01_resent.csv", HEADER, db)
+        self.assertEqual(db.inserts, 1)
+
+    def test_same_name_with_new_content_is_loaded(self):
+        db = FakeDb()
+        load_file("settlement_2026-10-01.csv", HEADER, db)
+        load_file("settlement_2026-10-01.csv", HEADER + b"\n", db)
+        self.assertEqual(db.inserts, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
