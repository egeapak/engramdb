+# Finance's import tool runs with a German locale: ';' delimiter, DD.MM.YYYY dates,
+# UTF-8 without BOM, amounts as integer cents.
+COLUMNS = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+
+def load_finalized_invoices(month):
+    """Finalized invoices of one month (YYYY-MM): dicts with id, customer_id,
+    subtotal_cents, tax_cents and finalized_on (a date).
+
+    TODO: the invoices table has no finalized date/status column yet.
+    """
+    raise NotImplementedError("no finalized date in the invoices schema")
+
+
+def write_csv(invoices, path):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\n")
+        writer.writerow(COLUMNS)
+        for inv in invoices:
+            subtotal, tax = inv["subtotal_cents"], inv["tax_cents"]
+            writer.writerow([
+                inv["id"],
+                inv["customer_id"],
+                subtotal,
+                tax,
+                subtotal + tax,
+                inv["finalized_on"].strftime("%d.%m.%Y"),
+            ])
+    return path
 
 
