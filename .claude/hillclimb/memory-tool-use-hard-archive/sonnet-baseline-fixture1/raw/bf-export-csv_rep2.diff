+import sys
+from datetime import date
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
+
+import export  # noqa: E402
+
+
+def test_write_csv_matches_finance_format(tmp_path):
+    invoices = [
+        {"id": "inv_1", "customer_id": "c1", "subtotal_cents": 1000, "tax_cents": 190, "finalized_on": date(2026, 9, 3)},
+        {"id": "inv_2", "customer_id": "c2", "subtotal_cents": 0, "tax_cents": 0, "finalized_on": date(2026, 9, 30)},
+    ]
+    path = export.write_csv(invoices, tmp_path / "2026-09" / "invoices.csv")
+    raw = path.read_bytes()
+    assert not raw.startswith(b"\xef\xbb\xbf")
+    assert raw.decode("utf-8").splitlines() == [
+        "invoice_id;customer_id;subtotal;tax;total;finalized_date",
+        "inv_1;c1;1000;190;1190;03.09.2026",
+        "inv_2;c2;0;0;0;30.09.2026",
+    ]
