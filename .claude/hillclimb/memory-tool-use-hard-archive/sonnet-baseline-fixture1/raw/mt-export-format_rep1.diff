@@ -0,0 +1,24 @@
+import datetime
+import importlib.util
+import io
+import pathlib
+
+spec = importlib.util.spec_from_file_location("export", pathlib.Path(__file__).parent.parent / "scripts" / "export.py")
+export = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(export)
+
+
+def test_write_csv_uses_finance_format():
+    out = io.StringIO()
+    export.write_csv([("inv_1", "cus_1", 1000, 190, datetime.date(2026, 9, 3)), ("inv_2", "cus_2", 0, 0, datetime.date(2026, 9, 30))], out)
+    assert out.getvalue().splitlines() == [
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date",
+        "inv_1,cus_1,1000,190,1190,2026-09-03",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_helpers():
+    assert export.previous_month(datetime.date(2026, 10, 2)) == "2026-09"
+    assert export.previous_month(datetime.date(2026, 1, 2)) == "2025-12"
+    assert export.month_bounds("2026-12") == (datetime.date(2026, 12, 1), datetime.date(2027, 1, 1))
