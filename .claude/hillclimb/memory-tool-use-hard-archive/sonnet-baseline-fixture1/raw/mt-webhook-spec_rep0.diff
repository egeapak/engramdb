+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
 
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_signature():
+    """Return an error response if the request is not a valid PSP event, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not secret or not signature or not timestamp:
+        return problem(401, "Unauthorized", "Missing webhook signature")
+
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        return problem(401, "Unauthorized", "Invalid webhook timestamp")
+    if age > MAX_EVENT_AGE_SECONDS:
+        return problem(401, "Unauthorized", "Webhook timestamp too old")
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return problem(401, "Unauthorized", "Invalid webhook signature")
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    error = _verify_psp_signature()
+    if error is not None:
+        return error
+
