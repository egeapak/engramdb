+import os
+
+import psycopg
+
+
+def get_conn():
+    # Deployed envs connect through a transaction-mode pooler (port 6432), which
+    # breaks server-side prepared statements, so automatic preparing is disabled.
+    return psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None)
