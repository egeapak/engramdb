+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api.errors import problem
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verify_psp_request():
+    """Check signature and freshness against the raw body, before any parsing."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return False
+    signature = request.headers.get("Psp-Signature", "")
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return False
+    try:
+        timestamp = int(request.headers.get("Psp-Timestamp", ""))
+    except ValueError:
+        return False
+    return abs(time.time() - timestamp) <= MAX_EVENT_AGE_SECONDS
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
-    event = request.get_json()
-    # TODO: verify the event, then dispatch on event["type"]
+    if not _verify_psp_request():
+        return problem(401, "Invalid webhook signature")
+
+    event = request.get_json(silent=True)
+    if not isinstance(event, dict):
+        return problem(400, "Malformed event")
+
+    if event.get("type") == "payment.failed":
+        invoice_id = (event.get("data") or {}).get("invoice_id")
+        if not invoice_id:
+            return problem(400, "payment.failed event has no invoice_id")
+        # Redeliveries of the same failure collapse via dedupe_key.
+        queue.enqueue(
+            "dunning.schedule_retries",
+            {"invoice_id": invoice_id},
+            dedupe_key=f"dunning:{invoice_id}:0",
+        )
+        log.info("dunning_enqueued", invoice_id=invoice_id)
+
     return "", 204
