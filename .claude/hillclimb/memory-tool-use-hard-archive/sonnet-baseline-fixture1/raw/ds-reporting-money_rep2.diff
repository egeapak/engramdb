+def revenue_by_customer(rows):
+    """Sum each customer's revenue for the month, in Decimal major units."""
+    totals = {}
+    for row in rows:
+        amount = Decimal(row["total_cents"]) / 100
+        totals[row["customer_id"]] = totals.get(row["customer_id"], Decimal(0)) + amount
+    return {cid: total.quantize(Decimal("0.0001")) for cid, total in totals.items()}
