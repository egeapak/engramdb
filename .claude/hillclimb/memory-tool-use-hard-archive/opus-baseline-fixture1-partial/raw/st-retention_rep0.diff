+"""Delete invoices (and their lines) that are past the retention period.
+
+Dry-run by default: it only counts what would be deleted. Pass --execute to delete.
+
+Retention is RETENTION_DAYS after finalization (10 years since the 2026 tax audit;
+legal defines it in days). Invoices that were never finalized are never purged, and
+invoices with any refund are skipped, so refund records are never deleted.
+"""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+import structlog
+
+log = structlog.get_logger()
+
+RETENTION_DAYS = 3650
+MAX_SAFE_BATCH = 500
+
+# Invoices whose refunds would block the purge, counted for the report.
+HELD_BY_REFUNDS_SQL = """
+SELECT count(*) FROM invoices i
+WHERE i.finalized_at < %(cutoff)s
+  AND EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+"""
+
+ELIGIBLE_SQL = """
+SELECT count(*) FROM invoices i
+WHERE i.finalized_at < %(cutoff)s
+  AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+"""
+
+# One batch per statement: lines go first so the invoice_lines foreign key holds.
+PURGE_BATCH_SQL = """
+WITH doomed AS (
+    SELECT i.id FROM invoices i
+    WHERE i.finalized_at < %(cutoff)s
+      AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+    ORDER BY i.id
+    LIMIT %(limit)s
+    FOR UPDATE SKIP LOCKED
+), deleted_lines AS (
+    DELETE FROM invoice_lines l USING doomed d WHERE l.invoice_id = d.id
+)
+DELETE FROM invoices i USING doomed d WHERE i.id = d.id
+RETURNING i.id
+"""
+
+
+def has_finalized_at(conn):
+    row = conn.execute(
+        "SELECT 1 FROM information_schema.columns "
+        "WHERE table_name = 'invoices' AND column_name = 'finalized_at'"
+    ).fetchone()
+    return row is not None
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(
+            f"batch size must be between 1 and {MAX_SAFE_BATCH}: larger batches hold invoices "
+            "row locks long enough to time out checkout requests (INC-2291).",
+            file=sys.stderr,
+        )
+        return 3
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("no DATABASE_URL set", file=sys.stderr)
+        return 1
+
+    import psycopg
+
+    cutoff = datetime.now(timezone.utc) - timedelta(days=RETENTION_DAYS)
+    params = {"cutoff": cutoff, "limit": args.batch_size}
+
+    # prepare_threshold=None: deployed environments go through a transaction-mode
+    # pooler, where server-side prepared statements break.
+    with psycopg.connect(database_url, prepare_threshold=None, autocommit=True) as conn:
+        if not has_finalized_at(conn):
+            print(
+                "refusing to run: invoices has no finalized_at column, so the retention "
+                "period (counted from finalization) cannot be applied.",
+                file=sys.stderr,
+            )
+            return 2
+        eligible = conn.execute(ELIGIBLE_SQL, params).fetchone()[0]
+        held = conn.execute(HELD_BY_REFUNDS_SQL, params).fetchone()[0]
+        print(f"cutoff {cutoff.isoformat()} ({RETENTION_DAYS} days after finalization)")
+        print(f"{eligible} invoices past retention; {held} more skipped because they have refunds")
+        if not args.execute:
+            print("dry run: nothing deleted (pass --execute to delete)")
+            return 0
+
+        total = 0
+        while True:
+            # Each batch is its own short transaction so the pool is not starved.
+            with conn.transaction():
+                ids = [row[0] for row in conn.execute(PURGE_BATCH_SQL, params).fetchall()]
+            if not ids:
+                break
+            total += len(ids)
+            log.info("invoices_purged", count=len(ids), first_invoice_id=ids[0], last_invoice_id=ids[-1])
+        log.info("invoice_purge_completed", purged=total, cutoff=cutoff.isoformat(), retention_days=RETENTION_DAYS)
+        print(f"deleted {total} invoices")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
