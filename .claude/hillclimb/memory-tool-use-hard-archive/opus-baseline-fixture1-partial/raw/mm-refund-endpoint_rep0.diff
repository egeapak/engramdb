+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_HEADER = "X-Acme-Idempotency"
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+def _serialize(result, currency="USD"):
+    return {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": currency},
+        "status": result["status"],
+    }
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get(IDEMPOTENCY_HEADER)
+    if not key:
+        return errors.problem(428, "Precondition Required", f"{IDEMPOTENCY_HEADER} header is required")
+
+    cache_key = (invoice_id, key)
+    stored = _RESPONSES.get(cache_key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, body, status = stored
+        return jsonify(body), status
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Not Found", f"invoice {invoice_id} not found")
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(401, "Unauthorized", "X-Acme-Actor-Id header is required")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool):
+        return errors.problem(400, "Bad Request", "amount_cents must be an integer")
+
+    try:
+        result = refund(invoice, amount_cents, actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Unprocessable Entity", str(exc))
+
+    body = _serialize(result)
+    status = 201 if result["status"] == "issued" else 202
+    _RESPONSES[cache_key] = (time.time(), body, status)
+    return jsonify(body), status
