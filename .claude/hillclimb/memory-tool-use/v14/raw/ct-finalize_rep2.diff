+def _post_to_ledger(invoice):
+    # Safe to retry: the ledger deduplicates postings on invoice id.
+    for attempt in range(1, LEDGER_MAX_ATTEMPTS + 1):
+        try:
+            resp = requests.post(LEDGER_URL, json={"invoice": invoice.id, "amount": invoice.subtotal_cents + invoice.tax_cents}, timeout=10)
+            resp.raise_for_status()
+            return resp
+        except requests.RequestException as exc:
+            # Only retry transient failures: network errors and 5xx. 4xx won't succeed on retry.
+            status = exc.response.status_code if exc.response is not None else None
+            if attempt == LEDGER_MAX_ATTEMPTS or (status is not None and status < 500):
+                raise
+            log.warning("ledger_post_retry", invoice_id=invoice.id, attempt=attempt, error=str(exc))
+
