    log.info(\"invoice_finalized\", invoice_id=invoice.id)\n    return invoice\n\n\ndef finalize_once(invoice):\n    if invoice.ledger_ref:\n        return invoice\n    return finalize(invoice)\n", "structuredPatch": [{"oldStart": 18, "oldLines": 8, "newStart": 18, "newLines": 19, "lines": ["     lines: list = field(default_factory=list)", " ", " ", "+MAX_ATTEMPTS = 3", "+", "+", " def finalize(invoice):", "-    resp = requests.post(LEDGER_URL, json={\"invoice\": invoice.id, \"amount\": invoice.subtotal_cents + invoice.tax_cents}, timeout=10)", "+    payload = {\"invoice\": invoice.id, \"amount\": invoice.subtotal_cents + invoice.tax_cents}", "+    for attempt in range(1, MAX_ATTEMPTS + 1):", "+        try:", "+            resp = requests.post(LEDGER_URL, json=payload, timeout=10)", "+            break", "+        except (requests.ConnectionError, requests.Timeout):", "+            if attempt == MAX_ATTEMPTS:", "+                raise", "+            log.warning(\"finalize_retry\", invoice_id=invoice.id, attempt=attempt)", "     resp.raise_for_status()", "     invoice.ledger_ref = resp.json()[\"ref\"]", "     log.info(\"invoice_finalized\", invoice_id=invoice.id)"]}], "userModified": false, "replaceAll": false}}
