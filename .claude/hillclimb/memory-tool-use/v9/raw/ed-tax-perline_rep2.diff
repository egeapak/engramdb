 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    """Tax in whole cents for one amount, rounded half-even."""
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate):
+    """Total invoice tax in cents.
+
+    Tax is rounded per line (banker's rounding) and the rounded line taxes
+    are summed; the invoice total is never rounded.
+    """
+    return sum(
+        tax_for(line["quantity"] * line["unit_cents"], rate) for line in lines
+    )
