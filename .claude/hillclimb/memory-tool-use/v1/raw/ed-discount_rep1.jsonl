n()[\"ref\"]\n    log.info(\"invoice_finalized\", invoice_id=invoice.id)\n    return invoice\n\n\ndef finalize_once(invoice):\n    if invoice.ledger_ref:\n        return invoice\n    return finalize(invoice)\n", "numLines": 33, "startLine": 1, "totalLines": 33}}}
