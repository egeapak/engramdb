post(LEDGER_URL, json={\"invoice\": invoice.id, \"amount\": invoice.subtotal_cents + invoice.tax_cents}, timeout=10)\n    resp.raise_for_status()\n    invoice.ledger_ref = resp.json()[\"ref\"]\n    log.info(\"invoice_finalized\", invoice_id=invoice.id)\n    return invoice\n\n\ndef finalize_once(invoice):\n    if invoice.ledger_ref:\n        return invoice\n    return finalize(invoice)\n", "structuredPatch": [{"oldStart": 18, "oldLines": 8, "newStart": 18, "newLines": 21, "lines": ["     lines: list = field(default_factory=list)", " ", " ", "+MAX_ATTEMPTS = 3", "+", "+", " def finalize(invoice):", "-    resp = requests.post(LEDGER_URL, json={\"invoice\": invoice.id, \"amount\": invoice.subtotal_cents + invoice.tax_cents}, timeout=10)", "+    # The ledger has no idempotency key, so only retry connect timeouts, where", "+    # the request never reached the ledger. Read timeouts and connection resets", "+    # may have been processed, and retrying them could double-post.", "+    for attempt in range(1, MAX_ATTEMPTS + 1):", "+        try:", "+            resp = requests.post(LEDGER_URL, json={\"invoice\": invoice.id, \"amount\": invoice.subtotal_cents + invoice.tax_cents}, timeout=10)", "+            break", "+        except requests.ConnectTimeout:", "+            if attempt == MAX_ATTEMPTS:", "+                raise", "+            log.warning(\"invoice_finalize_retry\", invoice_id=invoice.id, attempt=attempt)", "     resp.raise_for_status()", "     invoice.ledger_ref = resp.json()[\"ref\"]", "     log.info(\"invoice_finalized\", invoice_id=invoice.id)"]}], "userModified": false, "replaceAll": false}}
{"type": "assistant", "message": {"model": "claude-sonnet-5-5", "id": "msg_011CfbqM7ofttZggLRtw5zNc", "type": "message", "role": "assistant", "content": [{"type": "text", "text": "`finalize()` in `src/billing/invoices.py` now makes up to 3 attempts. I haven't run it or added tests.\n\nI limited the retry to `requests.ConnectTimeout`, so it won't retry every network error. The ledger endpoint has no idempotency key, and a stored hazard memory says `finalize()` must never be retried because a second call double-posts the invoice. A read timeout or a connection reset could happen after the ledger already recorded the posting, and retrying those would post it twice. A connect timeout means the request never got through, so retrying it is safe. Each retry is logged as `invoice_finalize_retry`, and the last failure is re-raised.\n\nThis means other network errors, such as read timeouts and resets, still fail on the first try. If those are the failures you're seeing, the real fix is an idempotency key on the ledger side. Without one, you could check the ledger for an existing posting before retrying. Tell me if you want me to retry on all `ConnectionError`s anyway, knowing the double-post risk.\n\nI haven't changed the hazard memory. It's still accurate: unconditional retries remain unsafe."}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 1125, "cache_read_input_tokens": 25159, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 1125}, "output_tokens": 367, "service_tier": "standard", "inference_geo": "not_available"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "session_id": "a428ebb5-b034-44f8-9462-f029a3a74166", "uuid": "02d2be90-d646-40e0-b858-1e0ce3425c56", "timestamp": "2026-10-01T16:29:40.789Z", "request_id": "req_011CfbqM6EBN7wxTm4HZdoHx"}
