l_inputs": {"toolu_013AbgEPuFDdMf2qLDJCKYx7": {"type": "hazard", "summary": "App silently uses a fake payment gateway unless PAYMENTS_LIVE=1 is set \u2014 no warning or error", "content": "The app falls back to a fake/stub payment gateway unless the env var PAYMENTS_LIVE=1 is set. Nothing warns you: charges look like they go through, but no real gateway is used. The user lost about two hours debugging this (reported 2026-10-02). When payment behavior looks off (charges not showing up in the real gateway, or responses that look too clean), check PAYMENTS_LIVE first. Note: the string PAYMENTS_LIVE does not appear in the ledgerline repo source as of commit 4a895f8. The switch may live in config, deployment, or another package. Tests use the sandbox at https://sandbox.payments.example/v1/charges (tests/test_payments.py, 'integration' pytest marker).", "epistemic": "observation", "criticality": 0.85, "tags": ["payments", "env-var", "config", "gotcha"], "logical": ["payments", "config.env"], "premise": "While the gateway selection defaults to fake when PAYMENTS_LIVE is unset"}}, "tool_use_meta": [{"id": "toolu_013AbgEPuFDdMf2qLDJCKYx7", "display_name": "Create", "server_display_name": "engramdb"}]}
