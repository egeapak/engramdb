 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    """Tax on a single line's amount, in integer cents.
+
+    Uses banker's rounding (ROUND_HALF_EVEN). Call once per line item and sum
+    the results; never apply this to an invoice total.
+    """
+    # str() so a float rate like 0.0825 becomes Decimal("0.0825") exactly.
+    tax = Decimal(amount_cents) * Decimal(str(rate))
