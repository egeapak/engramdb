 def line_total(lines):
@@ -9,4 +9,14 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    # Banker's rounding; str() keeps float rates like 0.0825 exact.
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate):
+    # Round each line's tax separately, then sum; never round the total.
+    total = 0
+    for line in lines:
+        total += tax_for(line["quantity"] * line["unit_cents"], rate)
+    return total
