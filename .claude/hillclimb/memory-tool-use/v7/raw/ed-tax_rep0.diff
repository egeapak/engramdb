 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    """Return tax in integer cents for amount_cents at rate (e.g. "0.0825").
+
+    Rounds with banker's rounding (ROUND_HALF_EVEN) per finance policy.
+    """
+    if isinstance(amount_cents, bool) or not isinstance(amount_cents, int):
