 def load_rows(month):
     """Rows for one month: dicts with customer_id, currency and total_cents."""
     raise NotImplementedError("reads from the billing warehouse")
+
+
+def revenue_by_customer(rows):
+    """Sum each customer's revenue for the month, per currency.
+
+    Returns {customer_id: {currency: Decimal}} in major units, quantized to
+    4 places. Currencies are kept apart because rows are not FX-converted.
+    """
+    totals = {}
+    for row in rows:
+        by_currency = totals.setdefault(row["customer_id"], {})
+        currency = row["currency"]
+        amount = Decimal(row["total_cents"]) / 100
+        by_currency[currency] = by_currency.get(currency, Decimal("0")) + amount
+    return {
+        customer_id: {
+            currency: amount.quantize(Decimal("0.0001"))
+            for currency, amount in by_currency.items()
+        }
+        for customer_id, by_currency in totals.items()
+    }
