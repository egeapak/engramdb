diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..e9fa63b
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,66 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.api.errors import problem
+from src.api.invoices import _INVOICES
+from src.billing import refunds
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored["at"] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored["body"]), stored["status"]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return problem(401, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    if not isinstance(amount, dict):
+        return problem(422, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<ISO 4217>"}.')
+    minor, ccy = amount.get("minor"), amount.get("ccy")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if ccy != invoice.currency:
+        return problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}, refund is in {ccy}.")
+
+    already_refunded = sum(r["refunded_cents"] for r in _REFUNDS.values() if r["invoice_id"] == invoice.id)
+    if already_refunded + minor > invoice.subtotal_cents + invoice.tax_cents:
+        return problem(422, "Refund exceeds invoice total", "The refund would exceed the amount left to refund on this invoice.")
+    result = refunds.refund(invoice, minor)
+
+    refund_id = str(uuid.uuid4())
+    _REFUNDS[refund_id] = {"invoice_id": invoice.id, "refunded_cents": minor, "status": result["status"]}
+
+    event = "ledger.refund_issued" if result["status"] == "issued" else "ledger.refund_requested"
+    log.info(event, refund_id=refund_id, invoice_id=invoice.id, amount_cents=minor, currency=ccy, actor_id=actor_id)
+
+    response = {
+        "id": refund_id,
+        "invoice_id": invoice.id,
+        "amount": {"minor": minor, "ccy": ccy},
+        "status": result["status"],
+    }
+    _IDEMPOTENT_RESPONSES[key] = {"at": time.time(), "status": 201, "body": response}
+    return jsonify(response), 201
