+import time
+from functools import wraps
+
+from flask import request
+
+from . import errors
+
+HEADER = "X-Acme-Idempotency"
+TTL_SECONDS = 24 * 60 * 60
+
+# In-process store: (method, path, key) -> (stored_at, response).
+# Not shared across workers; swap for a shared store before running more than one process.
+_RESPONSES = {}
+
+
+def idempotent(view):
+    """Require the idempotency header and replay the stored response for a repeated key."""
+
+    @wraps(view)
+    def wrapper(*args, **kwargs):
+        key = request.headers.get(HEADER)
+        if not key:
+            return errors.problem(428, "Idempotency key required", f"Send a {HEADER} header.")
+        now = time.time()
+        cache_key = (request.method, request.path, key)
+        stored = _RESPONSES.get(cache_key)
+        if stored and now - stored[0] < TTL_SECONDS:
+            return stored[1]
+        resp = view(*args, **kwargs)
+        _RESPONSES[cache_key] = (now, resp)
+        return resp
+
+    return wrapper
