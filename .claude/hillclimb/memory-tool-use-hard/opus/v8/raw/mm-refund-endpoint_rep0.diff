+++ b/tests/test_refunds_api.py
@@ -0,0 +1,57 @@
+import pytest
+from flask import Flask
+
+from src.api import idempotency, invoices, refunds
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds.bp)
+    invoices._INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="c_1", subtotal_cents=90_000, tax_cents=10_000)
+    yield app.test_client()
+    invoices._INVOICES.clear()
+    idempotency._RESPONSES.clear()
+
+
+def post(client, amount, key="k1", invoice_id="inv_1"):
+    headers = {"X-Acme-Idempotency": key} if key else {}
+    body = {"amount": {"minor": amount, "ccy": "USD"}, "actor_id": "u_1"}
+    return client.post(f"/invoices/{invoice_id}/refunds", json=body, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, 5_000)
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "amount": {"minor": 5_000, "ccy": "USD"}, "status": "issued"}
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, 50_001)
+    assert resp.status_code == 202
+    assert resp.get_json()["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key(client):
+    resp = post(client, 5_000, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_repeated_key_replays_response(client, monkeypatch):
+    calls = []
+    real = refunds.refund
+    monkeypatch.setattr(refunds, "refund", lambda *a, **kw: calls.append(1) or real(*a, **kw))
+    first = post(client, 5_000)
+    second = post(client, 5_000)
+    assert len(calls) == 1
+    assert second.get_json() == first.get_json()
+
+
+def test_refund_over_total_rejected(client):
+    assert post(client, 100_001).status_code == 422
+
+
+def test_unknown_invoice(client):
+    assert post(client, 100, invoice_id="nope").status_code == 404
