+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The sandbox answers 202 but silently drops anything not addressed to the
+# sink domain, so delivery can only be asserted for @sink.acme.test recipients.
+SINK_RECIPIENT = "receipts@sink.acme.test"
+SINK_URL = os.environ.get("MAIL_SINK_URL")
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and SINK_URL),
+        reason="needs MAIL_API_KEY (sandbox key) and MAIL_SINK_URL",
+    ),
+]
+
+
+def _wait_for_message(message_id, timeout=30.0, interval=2.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            f"{SINK_URL}/messages",
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_RECIPIENT},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json()["messages"]:
+            if msg["id"] == message_id:
+                return msg
+        time.sleep(interval)
+    return None
+
+
+def test_send_receipt_is_delivered_to_sink():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    # render() is not implemented yet; stub it with a body we can recognise.
+    body = f"<p>Receipt for {invoice_id}</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_RECIPIENT, 1200)
+
+    assert message_id
+
+    msg = _wait_for_message(message_id)
+    assert msg is not None, f"message {message_id} never reached the sink inbox"
+    assert msg["subject"] == "Your receipt"
+    assert invoice_id in msg["html"]
