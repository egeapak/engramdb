index 0000000..33c3715
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,54 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.api import errors
+from src.api.invoices import _INVOICES
+from src.billing.refunds import refund
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, status, body)
+_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[2]), stored[1]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice {invoice_id}.")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount") or {}
+    minor = amount.get("minor") if isinstance(amount, dict) else None
+    actor_id = body.get("actor_id")
+    if not isinstance(minor, int) or isinstance(minor, bool):
+        return errors.problem(400, "Invalid amount", 'Send amount as {"minor": <integer>, "ccy": "<currency>"}.')
+    if amount.get("ccy") != invoice.currency:
+        return errors.problem(400, "Currency mismatch", f"Invoice {invoice_id} is in {invoice.currency}.")
+    if not actor_id:
+        return errors.problem(400, "Missing actor", "Send the actor_id of the user requesting the refund.")
+
+    try:
+        result = refund(invoice, minor, actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    response = {
+        "id": result["id"],
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status = 201 if result["status"] == "issued" else 202
+    _RESPONSES[key] = (time.time(), status, response)
+    return jsonify(response), status
