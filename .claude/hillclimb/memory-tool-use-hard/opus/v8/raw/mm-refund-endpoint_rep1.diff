+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_HEADER = "X-Acme-Idempotency"
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get(IDEMPOTENCY_HEADER)
+    if not key:
+        return errors.problem(428, "Idempotency key required", f"Send a {IDEMPOTENCY_HEADER} header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    data = request.get_json(silent=True) or {}
+    amount = data.get("amount")
+    minor = amount.get("minor") if isinstance(amount, dict) else None
+    if type(minor) is not int or minor <= 0:
+        return errors.problem(422, "Invalid amount", 'amount must be {"minor": <positive integer>, "ccy": "USD"}.')
+    if amount.get("ccy", "USD") != "USD":
+        return errors.problem(422, "Invalid amount", "Only USD refunds are supported.")
+    actor_id = data.get("actor_id")
+    if not actor_id:
+        return errors.problem(422, "Missing actor_id", "actor_id is required for the audit trail.")
+
+    try:
+        result = refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    _RESPONSES[key] = (time.time(), body, 201)
+    return jsonify(body), 201
