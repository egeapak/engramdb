+import structlog
+
 from .invoices import Invoice
 
+log = structlog.get_logger()
+
+# Refunds above this need a second approver in the admin tool (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+
 
-def refund(invoice: Invoice, amount_cents: int):
+def refund(invoice: Invoice, amount_cents: int, actor_id: str):
     if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
-    return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        status = "pending_approval"
+    else:
+        status = "issued"
+        log.info("ledger.refund_issued", invoice_id=invoice.id, refunded_cents=amount_cents, actor_id=actor_id)
+    return {"invoice_id": invoice.id, "refunded_cents": amount_cents, "status": status}
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..cf2ae03
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,60 @@
+import pytest
+from flask import Flask
+
+from src.api import invoices, refunds
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds.bp)
+    invoices._INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    refunds._RESPONSES.clear()
+    yield app.test_client()
+    invoices._INVOICES.clear()
+
+
+def post(client, key="k1", minor=1_000, invoice_id="inv_1"):
+    headers = {"X-Acme-Idempotency": key} if key else {}
+    return client.post(
+        f"/invoices/{invoice_id}/refunds",
+        json={"amount": {"minor": minor, "ccy": "USD"}, "actor_id": "usr_1"},
+        headers=headers,
+    )
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client)
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "amount": {"minor": 1_000, "ccy": "USD"}, "status": "issued"}
+
+
+def test_large_refund_needs_approval(client):
+    assert post(client, minor=50_001).get_json()["status"] == "pending_approval"
+    assert post(client, key="k2", minor=50_000).get_json()["status"] == "issued"
+
+
+def test_missing_idempotency_key(client):
+    resp = post(client, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_response(client, monkeypatch):
+    first = post(client).get_json()
+    monkeypatch.setattr(refunds, "refund", lambda *a, **k: pytest.fail("refund called twice"))
+    assert post(client).get_json() == first
+
+
+def test_refund_over_total_rejected(client):
+    assert post(client, minor=100_001).status_code == 422
+
+
+def test_unknown_invoice(client):
+    assert post(client, invoice_id="nope").status_code == 404
+
+
+@pytest.mark.parametrize("minor", [0, -5, 10.5, "100", True])
+def test_invalid_amount(client, minor):
+    assert post(client, minor=minor).status_code == 422
