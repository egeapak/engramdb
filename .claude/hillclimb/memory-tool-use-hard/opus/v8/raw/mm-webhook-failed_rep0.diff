+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+from src.jobs.queue import enqueue
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verify_signature():
+    """Check the PSP signature and timestamp against the raw body; return True if valid."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Timestamp")
+    if not secret or not signature or not timestamp:
+        return False
+    try:
+        age = time.time() - int(timestamp)
+    except ValueError:
+        return False
+    if abs(age) > MAX_EVENT_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret.encode(), request.get_data(), hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, signature)
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
-    event = request.get_json()
-    # TODO: verify the event, then dispatch on event["type"]
+    if not _verify_signature():
+        return errors.problem(401, "Invalid webhook signature")
+
+    event = request.get_json(silent=True)
+    if not isinstance(event, dict):
+        return errors.problem(400, "Malformed webhook body")
+
+    if event.get("type") == "payment.failed":
+        invoice_id = (event.get("data") or {}).get("invoice_id")
+        if not invoice_id:
+            return errors.problem(400, "payment.failed event has no invoice_id")
+        # The PSP redelivers events; dedupe on its event id so a retry
+        # schedule is only started once per failure.
+        enqueue(
+            "dunning.schedule_retries",
+            {"invoice_id": invoice_id},
+            dedupe_key=f"dunning:{invoice_id}:{event.get('id')}",
+        )
+        log.info("payment_failed_received", invoice_id=invoice_id, event_id=event.get("id"))
+
     return "", 204
