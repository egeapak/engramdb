+"""Export one month's finalized invoices as the CSV Finance imports.
+
+Format is fixed by Finance's import tool (German locale): semicolon delimiter,
+dates as DD.MM.YYYY, integer cents, UTF-8 without BOM. Columns, in order:
+invoice id, customer id, subtotal, tax, total, finalized date.
+"""
 import argparse
+import csv
 import os
+import sqlite3
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DEV_DB = ROOT / "var" / "dev.sqlite3"
+HEADER = ("invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date")
+# Drafts have no finalized_at; zero-amount invoices are included on purpose.
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices"
+    " WHERE finalized_at IS NOT NULL AND finalized_at >= {p} AND finalized_at < {p} ORDER BY finalized_at, id"
+)
+
+
+def previous_month(today):
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def bounds(month):
+    """[start, end) of a month as naive UTC datetimes, matching finalized_at."""
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_invoices(month):
+    start, end = bounds(month)
+    url = os.environ.get("DATABASE_URL")
+    if url:
+        import psycopg
+
+        # Deployed envs go through a transaction-mode pooler: no prepared statements.
+        with psycopg.connect(url, prepare_threshold=None) as conn:
+            return conn.execute(QUERY.format(p="%s"), (start, end)).fetchall()
+    conn = sqlite3.connect(DEV_DB)
+    try:
+        rows = conn.execute(QUERY.format(p="?"), (start.isoformat(" "), end.isoformat(" "))).fetchall()
+    finally:
+        conn.close()
+    return [(*r[:4], datetime.fromisoformat(r[4])) for r in rows]
+
+
+def to_csv_rows(invoices):
+    for invoice_id, customer_id, subtotal, tax, finalized_at in invoices:
+        subtotal, tax = int(subtotal), int(tax)
+        yield (invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y"))
+
+
+def write_csv(path, rows):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(HEADER)
+        writer.writerows(rows)
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month, UTC)")
+    parser.add_argument("--out", type=Path, help="output file (default: var/exports/<env>/<month>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+    month = args.month or previous_month(datetime.now(timezone.utc))
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    out = args.out or ROOT / "var" / "exports" / args.env / month / "invoices.csv"
+
+    rows = list(to_csv_rows(fetch_invoices(month)))
+    total = sum(r[4] for r in rows)
+    print(f"{args.env} {month}: {len(rows)} finalized invoices, total {total} cents (target {bucket}/{key})")
+    if args.dry_run:
+        print("dry run: nothing written")
+        return 0
+    write_csv(out, rows)
+    print(f"wrote {out}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
