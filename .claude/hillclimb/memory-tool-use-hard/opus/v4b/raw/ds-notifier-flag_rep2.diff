diff --git a/services/notifier/notifier/email.py b/services/notifier/notifier/email.py
index 0627713..f41e2c3 100644
--- a/services/notifier/notifier/email.py
+++ b/services/notifier/notifier/email.py
@@ -1,9 +1,15 @@
+import os
+
 from .provider import send
 from .render import render
 
 
 def send_receipt(invoice_id, to_addr, total_minor):
-    body = render("receipt", invoice_id=invoice_id, total_minor=total_minor)
+    if os.environ.get("NOTIFIER_FF_RECEIPT_V2") == "1":
+        template = "receipt_v2"
+    else:
+        template = "receipt"
+    body = render(template, invoice_id=invoice_id, total_minor=total_minor)
     return send(to_addr, "Your receipt", body)
 
 
diff --git a/services/notifier/tests/test_email.py b/services/notifier/tests/test_email.py
index 19300da..8a6f6d4 100644
--- a/services/notifier/tests/test_email.py
+++ b/services/notifier/tests/test_email.py
