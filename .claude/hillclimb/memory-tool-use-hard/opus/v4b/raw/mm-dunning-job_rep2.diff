diff --git a/src/billing/dunning.py b/src/billing/dunning.py
index 5fd24da..43cc414 100644
--- a/src/billing/dunning.py
+++ b/src/billing/dunning.py
@@ -1,6 +1,45 @@
 """Follow-up when a customer's payment fails."""
 
+from datetime import datetime, timedelta, timezone
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Days after the failed charge on which to retry (finance policy FP-12).
+# If the last retry also fails, the retry job marks the invoice `uncollectible`.
+RETRY_DAYS = (1, 3, 7, 14)
+RETRY_JOB = "invoices.retry_charge"
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `invoices.retry_charge` job per retry day and returns the
+    list of planned (attempt, run_at) pairs. Nothing is scheduled while a
+    refund is in progress on the invoice.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    planned = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        queue.enqueue(
+            RETRY_JOB,
+            {
+                "invoice_id": invoice.id,
+                "attempt": attempt,
+                "final": attempt == len(RETRY_DAYS),
+            },
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at.isoformat(),
+        )
+        planned.append((attempt, run_at))
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, attempts=len(planned))
+    return planned
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..85646c3
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,44 @@
+from datetime import datetime, timezone
+
+import pytest
+
+from src.billing import dunning
+from src.billing.invoices import Invoice
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+def test_schedules_retries_on_days_1_3_7_14(backend):
+    failed_at = datetime(2026, 10, 1, 12, tzinfo=timezone.utc)
+    dunning.schedule_retries(Invoice("inv_1", "cus_1", 1000), failed_at=failed_at)
+
+    assert [p["attempt"] for _, p, _ in backend.jobs] == [1, 2, 3, 4]
+    assert [o["run_at"][:10] for _, _, o in backend.jobs] == [
+        "2026-10-02", "2026-10-04", "2026-10-08", "2026-10-15",
+    ]
+    assert [o["dedupe_key"] for _, _, o in backend.jobs] == [
+        "dunning:inv_1:1", "dunning:inv_1:2", "dunning:inv_1:3", "dunning:inv_1:4",
+    ]
+    assert [p["final"] for _, p, _ in backend.jobs] == [False, False, False, True]
+    assert all(name == "invoices.retry_charge" for name, _, _ in backend.jobs)
+
+
+def test_no_retries_while_refund_in_progress(backend):
+    planned = dunning.schedule_retries(Invoice("inv_1", "cus_1", 1000), refund_in_progress=True)
+    assert planned == []
+    assert backend.jobs == []
