+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
 
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verified():
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return False
+    try:
+        timestamp = int(request.headers.get("Psp-Timestamp", ""))
+    except ValueError:
+        return False
+    if abs(time.time() - timestamp) > MAX_EVENT_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret.encode(), request.get_data(), hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, request.headers.get("Psp-Signature", ""))
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    if not _verified():
+        return errors.problem(401, "Invalid webhook signature")
