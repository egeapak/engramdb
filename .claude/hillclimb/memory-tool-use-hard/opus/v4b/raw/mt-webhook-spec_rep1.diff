+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Events older than this are rejected to block replays.
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return an error detail string if the request fails verification, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return "webhook secret is not configured"
+
+    signature = request.headers.get("Psp-Signature", "")
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "invalid signature"
+
+    try:
+        timestamp = int(request.headers.get("Psp-Signature-Timestamp", ""))
+    except ValueError:
+        return "missing or malformed timestamp"
+    if abs(time.time() - timestamp) > MAX_EVENT_AGE_SECONDS:
+        return "timestamp outside the allowed window"
+
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure:
+        return errors.problem(401, "Unauthorized", failure)
+
