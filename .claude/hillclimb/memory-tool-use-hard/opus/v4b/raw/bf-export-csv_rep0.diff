+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Finance's import tool runs with a German locale: semicolon-delimited, dates as
+DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# Every finalized invoice of the month exactly once (id is the primary key),
+# including zero-amount ones; drafts have no finalized_at and are excluded.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month():
+    now = datetime.now(timezone.utc)
+    return f"{now.year - 1}-12" if now.month == 1 else f"{now.year}-{now.month - 1:02d}"
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC, so the window is naive UTC as well;
+    # nothing here depends on the host's local zone (docs/ops/backfills.md).
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_invoices(database_url, start, end):
+    import psycopg
+
+    # Deployed environments go through a transaction-mode pooler: no server-side
+    # prepared statements, and keep the transaction to this single SELECT.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        rows = conn.execute(QUERY, (start, end)).fetchall()
+    return rows
+
+
+def to_record(row):
+    invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at = row
+    return [
+        invoice_id,
+        customer_id,
+        int(subtotal_cents),
+        int(tax_cents),
+        int(subtotal_cents) + int(tax_cents),
+        finalized_at.strftime("%d.%m.%Y"),
+    ]
+
+
+def write_csv(path, records):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    # "utf-8" (not "utf-8-sig") so no BOM is written.
+    with open(tmp, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(COLUMNS)
+        writer.writerows(records)
+    # Rename into place so a failed run never leaves a half-written file behind.
+    os.replace(tmp, path)
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", default=previous_month(), help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", type=Path, help="output file (default: exports/<YYYY-MM>/invoices.csv)")
+    parser.add_argument("--dry-run", action="store_true", help="query and report, but write nothing")
     args = parser.parse_args()
+
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    start, end = month_window(args.month)
+    out = args.out or Path("exports") / args.month / "invoices.csv"
+    records = [to_record(row) for row in fetch_invoices(database_url, start, end)]
+    total = sum(r[4] for r in records)
+    print(f"{args.env}: {len(records)} finalized invoices for {args.month}, total {total} cents "
+          f"(bucket {bucket}, dry_run={args.dry_run})")
+    if args.dry_run:
+        return 0
+    write_csv(out, records)
+    print(f"wrote {out}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
