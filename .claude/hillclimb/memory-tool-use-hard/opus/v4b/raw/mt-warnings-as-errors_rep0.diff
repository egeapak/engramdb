+import pytest
+
+from src.billing.invoices import Invoice
+from src.billing.refunds import refund
+
+
+def test_refund_rejects_amount_above_invoice_total():
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=80)
+
+    with pytest.raises(ValueError, match="exceeds invoice total"):
+        refund(invoice, 1081)
+
+
+def test_refund_allows_full_invoice_total():
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=80)
+
+    assert refund(invoice, 1080)["refunded_cents"] == 1080
