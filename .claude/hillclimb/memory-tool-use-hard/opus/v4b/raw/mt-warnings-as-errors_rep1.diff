@@ -0,0 +1,18 @@
+import pytest
+
+from src.billing.invoices import Invoice
+from src.billing.refunds import refund
+
+
+def make_invoice():
+    return Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=10_000, tax_cents=800)
+
+
+def test_refund_rejects_amount_above_invoice_total():
+    with pytest.raises(ValueError, match="exceeds invoice total"):
+        refund(make_invoice(), 10_801)
+
+
+def test_refund_allows_exact_invoice_total():
+    result = refund(make_invoice(), 10_800)
+    assert result == {"invoice_id": "inv_1", "refunded_cents": 10_800}
