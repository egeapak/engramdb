+++ b/scripts/purge_invoices.py
@@ -0,0 +1,89 @@
+"""Purge invoices (and their lines) past the retention period. Dry-run unless --execute."""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+# Legal defines retention in days (10 years since the 2026 tax audit); do not derive from years.
+RETENTION_DAYS = 3650
+MAX_SAFE_BATCH = 500
+
+# Invoices with any refund are kept: open refunds must never be purged, and closed
+# refund rows still reference the invoice (FK) and are financial records.
+ELIGIBLE = """
+    FROM invoices i
+    WHERE i.finalized_at < %(cutoff)s
+      AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+"""
+
+COUNT_SQL = "SELECT count(*)" + ELIGIBLE
+
+BLOCKED_SQL = """
+    SELECT count(DISTINCT i.id)
+    FROM invoices i JOIN refunds r ON r.invoice_id = i.id
+    WHERE i.finalized_at < %(cutoff)s
+"""
+
+PURGE_BATCH_SQL = """
+    WITH doomed AS (
+        SELECT i.id""" + ELIGIBLE + """
+        ORDER BY i.finalized_at
+        LIMIT %(limit)s
+        FOR UPDATE OF i SKIP LOCKED
+    ), gone_lines AS (
+        DELETE FROM invoice_lines WHERE invoice_id IN (SELECT id FROM doomed)
+    )
+    DELETE FROM invoices WHERE id IN (SELECT id FROM doomed)
+    RETURNING id
+"""
+
+
+def retention_cutoff(now=None):
+    # finalized_at is stored as naive UTC; see docs/ops/backfills.md
+    now = now or datetime.now(timezone.utc)
+    return (now - timedelta(days=RETENTION_DAYS)).replace(tzinfo=None)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"batch size must be between 1 and {MAX_SAFE_BATCH}", file=sys.stderr)
+        return 3
+    dsn = os.environ.get("DATABASE_URL")
+    if not dsn:
+        print("error: DATABASE_URL is not set", file=sys.stderr)
+        return 1
+
+    import psycopg
+
+    cutoff = retention_cutoff()
+    # Deployed envs go through a transaction-mode pooler: no server-side prepared statements.
+    with psycopg.connect(dsn, prepare_threshold=None) as conn:
+        with conn.transaction():
+            eligible = conn.execute(COUNT_SQL, {"cutoff": cutoff}).fetchone()[0]
+            blocked = conn.execute(BLOCKED_SQL, {"cutoff": cutoff}).fetchone()[0]
+        print(f"cutoff {cutoff:%Y-%m-%d %H:%M:%S} UTC ({RETENTION_DAYS} days): "
+              f"{eligible} invoices eligible, {blocked} kept because they have refunds")
+        if not args.execute:
+            print("dry run: nothing deleted (pass --execute to purge)")
+            return 0
+
+        purged = 0
+        while True:
+            # One short transaction per batch so row locks never starve checkout.
+            with conn.transaction():
+                ids = [row[0] for row in conn.execute(
+                    PURGE_BATCH_SQL, {"cutoff": cutoff, "limit": args.batch_size})]
+            if not ids:
+                break
+            purged += len(ids)
+            print(f"purged {len(ids)} invoices (total {purged})")
+    print(f"done: purged {purged} invoices")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
