 """Follow-up when a customer's payment fails."""
 
+from datetime import datetime, timedelta, timezone
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Days after the failed charge on which to retry (finance policy FP-12, contractual).
+RETRY_DAYS = (1, 3, 7, 14)
+
+RETRY_JOB = "invoices.retry_charge"
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one retry job per entry in RETRY_DAYS, counted from `failed_at`.
+    The last job carries `final=True`: if that retry also fails, the handler
+    marks the invoice `uncollectible` and stops. Nothing is scheduled while a
+    refund is in progress. Returns the list of scheduled (attempt, run_at).
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id, customer_id=invoice.customer_id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    scheduled = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        queue.enqueue(
+            RETRY_JOB,
+            {"invoice_id": invoice.id, "attempt": attempt, "final": attempt == len(RETRY_DAYS)},
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        scheduled.append((attempt, run_at))
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id, attempts=len(scheduled))
+    return scheduled
