diff --git a/src/billing/invoices.py b/src/billing/invoices.py
index 3148b58..20786aa 100644
--- a/src/billing/invoices.py
+++ b/src/billing/invoices.py
@@ -3,6 +3,8 @@ from dataclasses import dataclass, field
 import requests
 import structlog
 
+from src.jobs.queue import enqueue
+
 log = structlog.get_logger()
 
 LEDGER_URL = "https://ledger.internal.acme.example/v1/postings"
@@ -27,6 +29,10 @@ def finalize(invoice):
 
 
 def finalize_once(invoice):
-    if invoice.ledger_ref:
-        return invoice
-    return finalize(invoice)
+    if not invoice.ledger_ref:
+        finalize(invoice)
+    # Enqueued on every call, not just the first: if a previous call posted to
+    # the ledger but failed before enqueueing, the retry still sends the
+    # receipt. The dedupe_key stops a second email.
+    enqueue("invoices.send_receipt", {"invoice_id": invoice.id}, dedupe_key=f"receipt:{invoice.id}")
+    return invoice
