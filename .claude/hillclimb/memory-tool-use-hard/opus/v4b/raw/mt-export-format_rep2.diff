+"""Export one month's finalized invoices as the CSV Finance imports.
+
+Format is dictated by Finance's accounting tool: comma delimiter,
+ISO YYYY-MM-DD dates, integer cents, UTF-8 without BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date, datetime
+
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is stored as naive UTC. Drafts have no finalized_at, so the
+# window excludes them; zero-amount invoices are deliberately not filtered.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    """Naive-UTC [start, end) bounds for a YYYY-MM month."""
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
 
+def render_csv(rows):
+    """rows: (id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal),
+            int(tax),
+            int(subtotal) + int(tax),
+            finalized_at.strftime("%Y-%m-%d"),
+        ])
+    return buf.getvalue()
 
-def main():
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    # prepare_threshold=None: deployed envs go through a transaction-mode pooler.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def main(argv=None):
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
-    args = parser.parse_args()
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
+    parser.add_argument("--out-dir", default=".", help="directory to write exports/<YYYY-MM>/invoices.csv under")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV instead of writing it")
+    args = parser.parse_args(argv)
+
+    month = args.month or previous_month(date.today())
+    start, end = month_window(month)
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    rows = fetch_rows(database_url, start, end)
+    content = render_csv(rows)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+
+    if args.dry_run:
+        sys.stdout.write(content)
+        print(f"dry run: {len(rows)} invoices for {month}, would write {bucket}/{key}", file=sys.stderr)
+        return 0
+
+    path = os.path.join(args.out_dir, key)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as fh:
+        fh.write(content)
+    print(f"exported {len(rows)} invoices for {month} ({args.env}) to {path}; destination {bucket}/{key}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..ece1d07
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,28 @@
+from datetime import date, datetime
+
+from scripts.export import month_window, previous_month, render_csv
+
+
+def test_render_csv_uses_finance_format():
+    rows = [
+        ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    assert render_csv(rows) == (
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date\n"
+        "inv_1,cus_1,1000,190,1190,2026-09-03\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\n"
+    )
+
+
+def test_render_csv_has_no_bom():
+    assert not render_csv([]).startswith("﻿")
+
+
+def test_month_window_wraps_december():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month():
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
