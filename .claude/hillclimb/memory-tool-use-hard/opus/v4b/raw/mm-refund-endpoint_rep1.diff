@@ -0,0 +1,58 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, body, status = stored
+        return jsonify(body), status
+
+    # TODO: take the actor from the authenticated principal once the API has auth.
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(401, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    minor = amount.get("minor") if isinstance(amount, dict) else None
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return errors.problem(422, "Invalid amount", 'Send "amount": {"minor": <positive integer>, "ccy": "USD"}.')
+    if amount.get("ccy", "USD") != "USD":
+        return errors.problem(422, "Invalid currency", "Refunds must be in the invoice currency (USD).")
+
+    try:
+        result = refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    status = 201
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), body, status)
+    return jsonify(body), status
