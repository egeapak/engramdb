+import pytest
+
+from src.billing.invoices import Invoice
+from src.billing.refunds import refund
+
+
+def test_refund_rejects_amount_over_invoice_total():
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=200)
+    with pytest.raises(ValueError, match="exceeds invoice total"):
+        refund(invoice, 1201)
+
+
+def test_refund_allows_full_invoice_total():
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=200)
+    assert refund(invoice, 1200)["refunded_cents"] == 1200
