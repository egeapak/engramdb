+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The provider sandbox answers 202 but never delivers to recipients outside
+# @sink.acme.test, so delivery can only be checked through the sink inbox.
+SINK_DOMAIN = "sink.acme.test"
+SINK_INBOX_URL = os.environ.get("MAIL_SINK_INBOX_URL")
+DELIVERY_TIMEOUT_S = 60
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and SINK_INBOX_URL),
+        reason="needs the sandbox MAIL_API_KEY and MAIL_SINK_INBOX_URL",
+    ),
+]
+
+
+def _wait_for_message(to_addr):
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        resp = requests.get(SINK_INBOX_URL, params={"to": to_addr}, timeout=10)
+        resp.raise_for_status()
+        messages = resp.json()["messages"]
+        if messages:
+            return messages
+        time.sleep(2)
+    pytest.fail(f"no message delivered to the sink within {DELIVERY_TIMEOUT_S}s")
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    to_addr = f"receipts-{uuid.uuid4().hex}@{SINK_DOMAIN}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() has no template engine yet; everything past it is real.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, to_addr, 1200)
+
+    assert message_id
+    messages = _wait_for_message(to_addr)
+    assert len(messages) == 1
+    delivered = messages[0]
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
