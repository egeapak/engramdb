+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_TIMESTAMP_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return None if the request is authentic, else a short failure reason."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return "secret_not_configured"
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+    if not signature or not timestamp:
+        return "missing_headers"
+
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return "bad_timestamp"
+    if abs(time.time() - sent_at) > MAX_TIMESTAMP_AGE_SECONDS:
+        return "stale_timestamp"
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(cache=True), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "bad_signature"
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    reason = _verify_psp_request()
+    if reason:
+        log.warning("psp_webhook_rejected", reason=reason)
+        return errors.problem(401, "Unauthorized", "Webhook signature verification failed.")
+
