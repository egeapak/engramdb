@@ -0,0 +1,89 @@
+import threading
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}  # invoice_id -> list of refund records
+_IDEMPOTENT_RESPONSES = {}  # idempotency key -> (stored_at, invoice_id, body, status)
+_LOCK = threading.Lock()
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    with _LOCK:
+        stored = _IDEMPOTENT_RESPONSES.get(key)
+        if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+            _, stored_invoice_id, body, status = stored
+            if stored_invoice_id != invoice_id:
+                return problem(422, "Idempotency key reused", "This key was already used for another invoice.")
+            if status >= 400:
+                return problem(status, body["title"], body.get("detail"))
+            return jsonify(body), status
+
+        body, status = _create_refund(invoice_id)
+        _IDEMPOTENT_RESPONSES[key] = (time.time(), invoice_id, body, status)
+
+    if status >= 400:
+        return problem(status, body["title"], body.get("detail"))
+    return jsonify(body), status
+
+
+def _create_refund(invoice_id):
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return {"title": "Invoice not found"}, 404
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    actor_id = payload.get("actor_id")
+    if not actor_id:
+        return {"title": "Invalid refund", "detail": "actor_id is required."}, 422
+    if (
+        not isinstance(amount, dict)
+        or type(amount.get("minor")) is not int
+        or amount.get("ccy") != invoice.currency
+    ):
+        detail = f'amount must be {{"minor": <integer>, "ccy": "{invoice.currency}"}}.'
+        return {"title": "Invalid refund", "detail": detail}, 422
+
+    previous = _REFUNDS.setdefault(invoice_id, [])
+    try:
+        result = refund(invoice, amount["minor"], sum(r["refunded_cents"] for r in previous))
+    except ValueError as exc:
+        return {"title": "Invalid refund", "detail": str(exc)}, 422
+
+    record = {**result, "id": f"rf_{uuid.uuid4().hex}"}
+    previous.append(record)
+
+    event = "ledger.refund_issued" if record["status"] == "issued" else "ledger.refund_requested"
+    log.info(
+        event,
+        refund_id=record["id"],
+        invoice_id=invoice_id,
+        customer_id=invoice.customer_id,
+        amount_cents=record["refunded_cents"],
+        actor_id=actor_id,
+    )
+
+    return {
+        "id": record["id"],
+        "invoice_id": invoice_id,
+        "amount": {"minor": record["refunded_cents"], "ccy": invoice.currency},
+        "status": record["status"],
+    }, 201
