+APPROVAL_THRESHOLD_CENTS = 50_000
 
-def refund(invoice: Invoice, amount_cents: int):
-    if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+
+def refund(invoice: Invoice, amount_cents: int, already_refunded_cents: int = 0):
+    if amount_cents <= 0:
+        raise ValueError("refund must be positive")
+    if already_refunded_cents + amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
-    return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    return {"invoice_id": invoice.id, "refunded_cents": amount_cents, "status": status}
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..404d309
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,69 @@
+import pytest
+from flask import Flask
+
+from src.api import invoices, refunds
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    invoices._INVOICES.clear()
+    refunds._REFUNDS.clear()
+    refunds._IDEMPOTENT_RESPONSES.clear()
+    invoices._INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=100_000)
+    app = Flask(__name__)
+    app.register_blueprint(refunds.bp)
+    return app.test_client()
+
+
+def post(client, minor, key="k1", invoice_id="inv_1", ccy="USD"):
+    return client.post(
+        f"/invoices/{invoice_id}/refunds",
+        json={"amount": {"minor": minor, "ccy": ccy}, "actor_id": "usr_1"},
+        headers={"X-Acme-Idempotency": key} if key else {},
+    )
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, 2_500)
+    assert resp.status_code == 201
+    assert resp.json["status"] == "issued"
+    assert resp.json["amount"] == {"minor": 2_500, "ccy": "USD"}
+
+
+def test_refund_at_threshold_is_issued(client):
+    assert post(client, 50_000).json["status"] == "issued"
+
+
+def test_large_refund_needs_approval(client):
+    assert post(client, 50_001).json["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key_is_428(client):
+    resp = post(client, 100, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_without_refunding_twice(client):
+    first = post(client, 2_500)
+    second = post(client, 2_500)
+    assert second.status_code == 201
+    assert second.json == first.json
+    assert len(refunds._REFUNDS["inv_1"]) == 1
+
+
+def test_cumulative_refunds_cannot_exceed_total(client):
+    assert post(client, 40_000, key="a").status_code == 201
+    assert post(client, 40_000, key="b").status_code == 201
+    resp = post(client, 40_000, key="c")
+    assert resp.status_code == 422
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_wrong_currency_is_rejected(client):
+    assert post(client, 100, ccy="EUR").status_code == 422
+
+
+def test_unknown_invoice_is_404(client):
+    assert post(client, 100, invoice_id="nope").status_code == 404
