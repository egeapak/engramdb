+"""Sends one real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (the sandbox key from the dev secrets store) and
+MAIL_SINK_INBOX_URL (the sink inbox API). The sandbox accepts mail for any
+address but only delivers to @sink.acme.test, so the recipient must be on
+that domain or the delivery check can never pass.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_INBOX_URL")),
+        reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_INBOX_URL",
+    ),
+]
+
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+
+def _sink_messages(to_addr):
+    resp = requests.get(
+        os.environ["MAIL_SINK_INBOX_URL"],
+        headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+        params={"to": to_addr},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    return resp.json()["messages"]
+
+
+def _wait_for_delivery(to_addr, message_id):
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        for msg in _sink_messages(to_addr):
+            if msg["id"] == message_id:
+                return msg
+        time.sleep(POLL_INTERVAL_S)
+    pytest.fail(f"message {message_id} not delivered within {DELIVERY_TIMEOUT_S}s")
+
+
+def test_send_receipt_is_delivered():
+    # Unique recipient per run so earlier runs' mail can't satisfy the check.
+    to_addr = f"receipts-{uuid.uuid4().hex[:12]}@sink.acme.test"
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:8]}"
+
+    # render() is not implemented yet; stub it so this test exercises delivery.
+    body = f"<p>Receipt for {invoice_id}: 12.00</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, to_addr, 1200)
+
+    assert message_id
+    delivered = _wait_for_delivery(to_addr, message_id)
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
