+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+# Replay protection: reject events signed more than this many seconds ago.
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_signature(raw_body, signature, timestamp):
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return False
+    if not signature or not timestamp:
+        return False
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return False
+    if abs(time.time() - sent_at) > MAX_EVENT_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret.encode(), raw_body, hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, signature)
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    # Verify against the raw bytes before parsing anything.
+    raw_body = request.get_data(cache=True)
+    if not _verify_psp_signature(
+        raw_body,
+        request.headers.get("Psp-Signature"),
+        request.headers.get("Psp-Signature-Timestamp"),
+    ):
+        log.warning("psp_webhook_rejected")
+        return errors.problem(401, "Invalid webhook signature")
+
