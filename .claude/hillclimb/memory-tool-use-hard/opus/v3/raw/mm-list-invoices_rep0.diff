@@ -0,0 +1,47 @@
+import pytest
+from flask import Flask
+
+from src.api import invoices
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(invoices.bp)
+    invoices._INVOICES.clear()
+    for inv in [
+        Invoice("inv_1", "cus_a", 1000, 80),
+        Invoice("inv_2", "cus_a", 2500, 0),
+        Invoice("inv_3", "cus_b", 999, 1),
+        Invoice("inv_4", "cus_a", 50, 5),
+    ]:
+        invoices._INVOICES[inv.id] = inv
+    yield app.test_client()
+    invoices._INVOICES.clear()
+
+
+def test_lists_customer_invoices_with_totals(client):
+    body = client.get("/customers/cus_a/invoices").get_json()
+    assert [i["id"] for i in body["items"]] == ["inv_1", "inv_2", "inv_4"]
+    assert body["items"][0]["total"] == {"minor": 1080, "ccy": "USD"}
+    assert body["next_cursor"] is None
+
+
+def test_paginates_with_cursor(client):
+    first = client.get("/customers/cus_a/invoices?page_size=2").get_json()
+    assert [i["id"] for i in first["items"]] == ["inv_1", "inv_2"]
+    second = client.get(f"/customers/cus_a/invoices?page_size=2&cursor={first['next_cursor']}").get_json()
+    assert [i["id"] for i in second["items"]] == ["inv_4"]
+    assert second["next_cursor"] is None
+
+
+def test_unknown_customer_returns_empty_list(client):
+    assert client.get("/customers/cus_x/invoices").get_json() == {"items": [], "next_cursor": None}
+
+
+@pytest.mark.parametrize("qs", ["page_size=0", "page_size=251", "page_size=abc", "cursor=%%%"])
+def test_rejects_bad_params(client, qs):
+    resp = client.get(f"/customers/cus_a/invoices?{qs}")
+    assert resp.status_code == 400
+    assert resp.mimetype == "application/problem+json"
