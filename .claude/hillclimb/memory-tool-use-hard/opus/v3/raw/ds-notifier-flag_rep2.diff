         assert email.send_receipt("inv_1", "a@example.com", 1200) == "msg_1"
     render.assert_called_once_with("receipt", invoice_id="inv_1", total_minor=1200)
+
+
+def test_send_receipt_uses_v2_template_when_flag_on():
+    with mock.patch.dict("os.environ", {"NOTIFIER_FF_RECEIPT_V2": "1"}), \
+            mock.patch.object(email, "render", return_value="<p>hi</p>") as render, \
+            mock.patch.object(email, "send", return_value="msg_1"):
+        assert email.send_receipt("inv_1", "a@example.com", 1200) == "msg_1"
+    render.assert_called_once_with("receipt_v2", invoice_id="inv_1", total_minor=1200)
+
+
+def test_send_receipt_ignores_flag_values_other_than_1():
+    with mock.patch.dict("os.environ", {"NOTIFIER_FF_RECEIPT_V2": "true"}), \
+            mock.patch.object(email, "render", return_value="<p>hi</p>") as render, \
+            mock.patch.object(email, "send", return_value="msg_1"):
+        email.send_receipt("inv_1", "a@example.com", 1200)
+    render.assert_called_once_with("receipt", invoice_id="inv_1", total_minor=1200)
