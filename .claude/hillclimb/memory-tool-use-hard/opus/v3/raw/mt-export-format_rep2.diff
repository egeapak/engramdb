@@ -0,0 +1,43 @@
+import importlib.util
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+_spec = importlib.util.spec_from_file_location("export", Path(__file__).parent.parent / "scripts" / "export.py")
+export = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(export)
+
+
+def test_render_csv_uses_finance_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 1, 0, 0)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    data = export.render_csv(rows)
+    assert not data.startswith(b"\xef\xbb\xbf")
+    assert data.decode("utf-8").splitlines() == [
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date",
+        "inv_1,cus_1,10000,1900,11900,2026-09-01",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_render_csv_rejects_duplicate_invoices():
+    row = ("inv_1", "cus_1", 100, 0, datetime(2026, 9, 1))
+    with pytest.raises(ValueError):
+        export.render_csv([row, row])
+
+
+def test_month_window_is_utc_calendar_month():
+    assert export.month_window("2026-09") == (datetime(2026, 9, 1), datetime(2026, 10, 1))
+    assert export.month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month_wraps_year():
+    assert export.previous_month(datetime(2026, 10, 2)) == "2026-09"
+    assert export.previous_month(datetime(2027, 1, 2)) == "2026-12"
+
+
+def test_export_key():
+    assert export.export_key("2026-09") == "exports/2026-09/invoices.csv"
