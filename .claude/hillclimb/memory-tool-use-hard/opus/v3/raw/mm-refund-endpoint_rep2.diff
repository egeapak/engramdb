new file mode 100644
index 0000000..f96e60b
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,66 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.money import Money
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_HEADER = "X-Acme-Idempotency"
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _serialize(result):
+    money = Money(result["refunded_cents"])
+    return {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": money.cents, "ccy": money.currency},
+        "status": result["status"],
+    }
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get(IDEMPOTENCY_HEADER)
+    if not key:
+        return problem(428, "Precondition Required", f"{IDEMPOTENCY_HEADER} header is required")
+
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Not Found", f"invoice {invoice_id} not found")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    actor_id = body.get("actor_id")
+    if not isinstance(amount, dict) or amount.get("ccy") != "USD":
+        return problem(400, "Bad Request", 'amount must be {"minor": <int>, "ccy": "USD"}')
+    minor = amount.get("minor")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return problem(400, "Bad Request", "amount.minor must be a positive integer")
+    if not actor_id:
+        return problem(400, "Bad Request", "actor_id is required")
+
+    try:
+        result = refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Unprocessable Entity", str(exc))
+
+    payload = _serialize(result)
+    status = 201 if result["status"] == "issued" else 202
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), payload, status)
+    resp = jsonify(payload)
+    resp.status_code = status
+    return resp
