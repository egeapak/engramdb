+"""Export one month's finalized invoices as the CSV Finance imports.
+
+Format is fixed by Finance's import tool (German locale): semicolon-delimited,
+dates as DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sqlite3
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DEV_DB = ROOT / "var" / "dev.sqlite3"
+
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# Drafts have no finalized_at. Zero-amount invoices are included on purpose:
+# Finance reconciles totals against the ledger and needs every finalized invoice.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= {p} AND finalized_at < {p}
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    year, month = (now.year - 1, 12) if now.month == 1 else (now.year, now.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC, so the window is naive UTC too and
+    # never goes through the host's local zone (see docs/ops/backfills.md).
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_rows(start, end):
+    url = os.environ.get("DATABASE_URL")
+    if url:
+        import psycopg
+
+        # One short read-only query; don't hold a pooled connection longer than needed.
+        with psycopg.connect(url) as conn:
+            return conn.execute(QUERY.format(p="%s"), (start, end)).fetchall()
+    conn = sqlite3.connect(DEV_DB)
+    try:
+        return conn.execute(QUERY.format(p="?"), (start.isoformat(" "), end.isoformat(" "))).fetchall()
+    finally:
+        conn.close()
+
+
+def to_datetime(value):
+    if isinstance(value, datetime):
+        return value
+    return datetime.fromisoformat(str(value))
+
+
+def write_csv(rows, out):
+    out.parent.mkdir(parents=True, exist_ok=True)
+    # encoding="utf-8" (not "utf-8-sig") so no BOM is written.
+    with out.open("w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\n")
+        writer.writerow(HEADER)
+        for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+            subtotal_cents, tax_cents = int(subtotal_cents), int(tax_cents)
+            writer.writerow([
+                invoice_id,
+                customer_id,
+                subtotal_cents,
+                tax_cents,
+                subtotal_cents + tax_cents,
+                to_datetime(finalized_at).strftime("%d.%m.%Y"),
+            ])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=previous_month(), help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", type=Path, help="output file (default: exports/<YYYY-MM>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    out = args.out or ROOT / "exports" / args.month / "invoices.csv"
+
+    start, end = month_window(args.month)
+    rows = fetch_rows(start, end)
+    print(f"exporting {len(rows)} finalized invoices for {args.month} ({args.env}, bucket {bucket}, dry_run={args.dry_run})")
+    if args.dry_run:
+        return 0
+    write_csv(rows, out)
+    print(f"wrote {out}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
