+"""Export one month's finalized invoices as the CSV Finance imports.
+
+The Finance accounting tool wants plain comma-separated files: ISO dates
+(YYYY-MM-DD), amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date, datetime
+
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is stored as naive UTC; the window bounds below are naive UTC too.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL
+      AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
 
+def render_csv(rows):
+    """rows: (id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\r\n")
+    writer.writerow(HEADER)
+    seen = set()
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        if invoice_id in seen:
+            raise ValueError(f"invoice {invoice_id} appears twice in the export")
+        seen.add(invoice_id)
+        subtotal, tax = int(subtotal), int(tax)
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%Y-%m-%d")])
+    return buf.getvalue()
 
-def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+
+def fetch_rows(database_url, month):
+    import psycopg
+
+    start, end = month_window(month)
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
-    args = parser.parse_args()
+    parser.add_argument("--month", default=previous_month(date.today()), help="YYYY-MM (default: previous month)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV instead of writing it")
+    args = parser.parse_args(argv)
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{args.month}/invoices.csv"
+
+    rows = fetch_rows(database_url, args.month)
+    body = render_csv(rows)
+
+    if args.dry_run:
+        sys.stdout.write(body)
+        print(f"dry run: {len(rows)} invoices for {args.month}, would write {bucket}/{key}", file=sys.stderr)
+        return 0
+
+    path = os.path.join(bucket, key)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    # newline="" keeps the CRLF from csv.writer as is; plain "utf-8" writes no BOM.
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        f.write(body)
+    print(f"exported {len(rows)} invoices for {args.month} ({args.env}) to {path}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
