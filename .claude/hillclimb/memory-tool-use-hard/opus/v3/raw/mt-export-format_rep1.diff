+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Finance's accounting tool expects plain comma-separated values, ISO dates
+(YYYY-MM-DD), amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime, timezone
+
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is stored as naive UTC, so the window bounds are naive UTC too.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    year, month = (now.year - 1, 12) if now.month == 1 else (now.year, now.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def render_csv(rows):
+    """rows: (id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime("%Y-%m-%d"),
+        ])
+    return buf.getvalue()
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    # Deployed environments go through a transaction-mode pooler: no prepared statements.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=None, help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", default=None, help="local path (default: exports/<YYYY-MM>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+
+    month = args.month or previous_month()
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    rows = fetch_rows(database_url, start, end)
+    data = render_csv(rows)
+    print(f"exporting {len(rows)} finalized invoices for {month} ({args.env}) to {bucket}/{key} (dry_run={args.dry_run})")
+    if args.dry_run:
+        return 0
+
+    out = args.out or key
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    # newline="" so the csv module's line endings are written as-is; utf-8 (not utf-8-sig) means no BOM.
+    with open(out, "w", encoding="utf-8", newline="") as f:
+        f.write(data)
+    print(f"wrote {out}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
