@@ -0,0 +1,23 @@
+from datetime import datetime, timezone
+
+from scripts.export import month_window, previous_month, render_csv
+
+
+def test_render_csv_uses_finance_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 23, 30)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 8, 0)),
+    ]
+    assert render_csv(rows).splitlines() == [
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date",
+        "inv_1,cus_1,10000,1900,11900,2026-09-03",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_window_is_half_open():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month_wraps_year():
+    assert previous_month(datetime(2026, 1, 2, 6, tzinfo=timezone.utc)) == "2025-12"
