diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..b1ef9b2
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,61 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# key -> (stored_at, body, status_code)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_minor")
+    if type(amount_cents) is not int or amount_cents <= 0:
+        return errors.problem(422, "Invalid amount", "amount_minor must be a positive integer.")
+
+    try:
+        result = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return errors.problem(422, "Invalid refund", str(exc))
+
+    if result["status"] == "issued":
+        log.info("ledger.refund_issued", invoice_id=invoice.id, customer_id=invoice.customer_id,
+                 refunded_cents=amount_cents, actor_id=actor_id)
+    else:
+        log.info("ledger.refund_requested", invoice_id=invoice.id, customer_id=invoice.customer_id,
+                 refunded_cents=amount_cents, actor_id=actor_id)
+
+    body = {
+        "invoice_id": invoice.id,
+        "amount": {"minor": amount_cents, "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), body, 201)
+    return jsonify(body), 201
