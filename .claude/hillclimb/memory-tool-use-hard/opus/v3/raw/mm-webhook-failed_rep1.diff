+def _handle_payment_failed(event):
+    invoice_id = event["data"]["invoice_id"]
+    # The PSP redelivers webhooks; keying on the event id makes redeliveries no-ops.
+    queue.enqueue(
+        "dunning.schedule_retries",
+        {"invoice_id": invoice_id},
+        dedupe_key=f"dunning:{invoice_id}:{event['id']}",
+    )
+    log.info("payment_failed_retries_enqueued", invoice_id=invoice_id, event_id=event["id"])
+
+
+HANDLERS = {
+    "payment.failed": _handle_payment_failed,
+}
