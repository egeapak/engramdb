@@ -0,0 +1,24 @@
+from datetime import date, datetime
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_csv_matches_finance_import_format(tmp_path):
+    path = tmp_path / "exports" / "2026-09" / "invoices.csv"
+    write_csv(path, [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ])
+    raw = path.read_bytes()
+    assert not raw.startswith(b"\xef\xbb\xbf")
+    assert raw.decode("utf-8").splitlines() == [
+        "invoice_id;customer_id;subtotal_cents;tax_cents;total_cents;finalized_date",
+        "inv_1;cus_1;10000;1900;11900;03.09.2026",
+        "inv_2;cus_2;0;0;0;30.09.2026",
+    ]
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
