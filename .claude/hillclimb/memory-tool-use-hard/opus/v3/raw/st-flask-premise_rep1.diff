diff --git a/src/api/invoices.py b/src/api/invoices.py
index 543713d..5792bd2 100644
--- a/src/api/invoices.py
+++ b/src/api/invoices.py
@@ -1,5 +1,10 @@
+import structlog
 from flask import Blueprint, jsonify
 
+from . import errors
+
+log = structlog.get_logger()
+
 bp = Blueprint("invoices", __name__)
 
 _INVOICES = {}
@@ -9,3 +14,17 @@ _INVOICES = {}
 def get_invoice(invoice_id):
     invoice = _INVOICES.get(invoice_id)
     return jsonify(invoice.__dict__)
+
+
+@bp.route("/invoices/<invoice_id>", methods=["DELETE"])
+def delete_invoice(invoice_id):
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+    # Finalized invoices are posted to the ledger and fall under the 10-year
+    # retention rule, so only drafts can be deleted.
+    if invoice.ledger_ref:
+        return errors.problem(409, "Invoice is finalized", "Finalized invoices cannot be deleted.")
+    del _INVOICES[invoice_id]
+    log.info("invoice_deleted", invoice_id=invoice_id, customer_id=invoice.customer_id)
+    return "", 204
