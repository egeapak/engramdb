@@ -0,0 +1,90 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}
+_IDEMPOTENCY = {}
+
+
+def _money(cents, ccy):
+    return {"minor": cents, "ccy": ccy}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    stored = _IDEMPOTENCY.get(key)
+    if stored and time.time() - stored["at"] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored["body"])
+        resp.status_code = stored["status"]
+        return resp
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(401, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    if not isinstance(amount, dict) or type(amount.get("minor")) is not int:
+        return errors.problem(422, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<code>"}.')
+    if amount.get("ccy") != invoice.currency:
+        return errors.problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    already = sum(r["refunded_cents"] for r in _REFUNDS.values() if r["invoice_id"] == invoice_id)
+    try:
+        result = refund(invoice, amount["minor"], already_refunded_cents=already)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    refund_id = str(uuid.uuid4())
+    _REFUNDS[refund_id] = result
+
+    if result["status"] == "issued":
+        log.info(
+            "ledger.refund_issued",
+            refund_id=refund_id,
+            invoice_id=invoice_id,
+            customer_id=invoice.customer_id,
+            amount_cents=result["refunded_cents"],
+            actor_id=actor_id,
+        )
+    else:
+        log.info(
+            "refund_pending_approval",
+            refund_id=refund_id,
+            invoice_id=invoice_id,
+            customer_id=invoice.customer_id,
+            amount_cents=result["refunded_cents"],
+            actor_id=actor_id,
+        )
+
+    response_body = {
+        "id": refund_id,
+        "invoice_id": invoice_id,
+        "amount": _money(result["refunded_cents"], invoice.currency),
+        "status": result["status"],
+    }
+    _IDEMPOTENCY[key] = {"at": time.time(), "status": 201, "body": response_body}
+    resp = jsonify(response_body)
+    resp.status_code = 201
+    return resp
