 from .invoices import Invoice
 
+# Refunds above this need a second approver in the admin tool (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
 
-def refund(invoice: Invoice, amount_cents: int):
-    if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+
+def refund(invoice: Invoice, amount_cents: int, already_refunded_cents: int = 0):
+    if amount_cents <= 0:
+        raise ValueError("refund amount must be positive")
+    if amount_cents + already_refunded_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
-    return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    return {"invoice_id": invoice.id, "refunded_cents": amount_cents, "status": status}
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..1f14d17
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,75 @@
+import pytest
+from flask import Flask
+
+from src.api import refunds as refunds_api
+from src.api.invoices import _INVOICES
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds_api.bp)
+    _INVOICES.clear()
+    refunds_api._REFUNDS.clear()
+    refunds_api._IDEMPOTENCY.clear()
+    _INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    return app.test_client()
+
+
+def post(client, minor, key="k1", ccy="USD", invoice_id="inv_1", actor="usr_1"):
+    headers = {}
+    if key:
+        headers["X-Acme-Idempotency"] = key
+    if actor:
+        headers["X-Acme-Actor-Id"] = actor
+    return client.post(f"/invoices/{invoice_id}/refunds", json={"amount": {"minor": minor, "ccy": ccy}}, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, 50_000)
+    assert resp.status_code == 201
+    assert resp.json["status"] == "issued"
+    assert resp.json["amount"] == {"minor": 50_000, "ccy": "USD"}
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, 50_001)
+    assert resp.status_code == 201
+    assert resp.json["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key(client):
+    resp = post(client, 100, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_replays_same_key(client):
+    first = post(client, 100)
+    second = post(client, 100)
+    assert second.status_code == 201
+    assert second.json == first.json
+    assert len(refunds_api._REFUNDS) == 1
+
+
+def test_missing_actor(client):
+    assert post(client, 100, actor=None).status_code == 401
+
+
+def test_unknown_invoice(client):
+    assert post(client, 100, invoice_id="nope").status_code == 404
+
+
+def test_currency_mismatch(client):
+    assert post(client, 100, ccy="EUR").status_code == 422
+
+
+def test_cumulative_refunds_capped_at_total(client):
+    assert post(client, 60_000, key="a").status_code == 201
+    assert post(client, 40_001, key="b").status_code == 422
+    assert post(client, 40_000, key="c").status_code == 201
+
+
+def test_rejects_non_positive(client):
+    assert post(client, 0).status_code == 422
