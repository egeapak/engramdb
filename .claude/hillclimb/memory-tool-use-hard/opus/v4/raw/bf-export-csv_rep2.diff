+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Finance's import tool runs with a German locale: semicolon delimiter, dates as
+DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month():
+    first_of_this_month = datetime.now(timezone.utc).replace(day=1)
+    return (first_of_this_month - timedelta(days=1)).strftime("%Y-%m")
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC, so the bounds are naive UTC as well
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_invoices(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        conn.read_only = True
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(rows, out):
+    writer = csv.writer(out, delimiter=";", lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime("%d.%m.%Y"),
+        ])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", default=previous_month(), help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--output", help="CSV path (default: exports/<YYYY-MM>/invoices.csv)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV to stdout instead of writing a file")
     args = parser.parse_args()
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{args.month}/invoices.csv"
+    output = args.output or key
+
+    start, end = month_window(args.month)
+    rows = fetch_invoices(database_url, start, end)
+
+    if args.dry_run:
+        write_csv(rows, sys.stdout)
+        print(f"dry run: {len(rows)} invoices for {args.month} ({args.env}), would write {bucket}/{key}",
+              file=sys.stderr)
+        return 0
+
+    os.makedirs(os.path.dirname(output) or ".", exist_ok=True)
+    with open(output, "w", encoding="utf-8", newline="") as f:
+        write_csv(rows, f)
+    print(f"wrote {len(rows)} invoices for {args.month} ({args.env}) to {output}; destination {bucket}/{key}",
+          file=sys.stderr)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
