+"""Export one month's finalized invoices as the CSV that Finance imports."""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# finalized_at is stored as naive UTC, so the window is naive UTC too; drafts have no finalized_at.
+QUERY = """
+SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+FROM invoices
+WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+ORDER BY finalized_at, id
+"""
+
+
+def previous_month(today):
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    # The deployed pooler runs in transaction mode; server-side prepared statements break there.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    """Finance's import tool runs with a German locale: `;` delimiter, DD.MM.YYYY dates, integer cents."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime("%d.%m.%Y"),
+        ])
+    return buf.getvalue()
 
 
 def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+    parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month)")
+    parser.add_argument("--out-dir", default="var", help="local directory to write exports/<YYYY-MM>/invoices.csv under")
+    parser.add_argument("--dry-run", action="store_true", help="query and summarize, but write nothing")
     args = parser.parse_args()
+
+    month = args.month or previous_month(datetime.now(timezone.utc))
+    start, end = month_window(month)
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("error: DATABASE_URL is not set", file=sys.stderr)
+        return 1
+
+    rows = fetch_rows(database_url, start, end)
+    ids = [r[0] for r in rows]
+    if len(ids) != len(set(ids)):
+        print(f"error: duplicate invoice ids in {month}; refusing to export", file=sys.stderr)
+        return 1
+    content = render_csv(rows)
+    total = sum(int(r[2]) + int(r[3]) for r in rows)
+
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    if args.dry_run:
+        print(f"dry run: {len(rows)} finalized invoices for {month}, total {total} cents; "
+              f"would write {key} ({args.env}, bucket {bucket})")
+        return 0
+
+    path = Path(args.out_dir) / key
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8", newline="")
+    print(f"wrote {len(rows)} finalized invoices for {month}, total {total} cents, to {path} ({args.env})")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
