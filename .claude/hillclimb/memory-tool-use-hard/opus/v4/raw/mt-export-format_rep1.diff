@@ -0,0 +1,32 @@
+import io
+from datetime import datetime
+
+import pytest
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_write_csv_uses_finance_format():
+    out = io.StringIO()
+    rows = [
+        ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 23, 59)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 0, 0)),
+    ]
+    assert write_csv(rows, out) == 2
+    assert out.getvalue() == (
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\n"
+        "inv_1,cus_1,1000,190,1190,2026-09-03\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\n"
+    )
+
+
+def test_write_csv_rejects_duplicates():
+    row = ("inv_1", "cus_1", 1, 0, datetime(2026, 9, 1))
+    with pytest.raises(ValueError):
+        write_csv([row, row], io.StringIO())
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(datetime(2026, 1, 2)) == "2025-12"
+    assert previous_month(datetime(2026, 10, 2)) == "2026-09"
