+"""Export one month's finalized invoices as the CSV that Finance imports."""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime, timezone
 
+# Finance's accounting tool wants plain comma-separated files with ISO dates.
+DELIMITER = ","
+DATE_FORMAT = "%Y-%m-%d"
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
 
-def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+# finalized_at is stored as naive UTC; drafts have no finalized_at.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    year, month = (now.year - 1, 12) if now.month == 1 else (now.year, now.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def month_window(month):
+    """Naive-UTC [start, end) bounds; computed without touching the host zone."""
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def load_invoices(database_url, start, end):
+    import psycopg
+
+    # prepare_threshold=None: deployed environments go through a transaction-mode pooler.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    """rows: (invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=DELIMITER, lineterminator="\r\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime(DATE_FORMAT),
+        ])
+    return buf.getvalue()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month, UTC)")
+    parser.add_argument("--out", help="local output path (default: exports/<YYYY-MM>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
-    args = parser.parse_args()
+    args = parser.parse_args(argv)
+
+    month = args.month or previous_month()
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    out = args.out or key
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    rows = load_invoices(database_url, start, end)
+    ids = [row[0] for row in rows]
+    if len(ids) != len(set(ids)):
+        print(f"duplicate invoice ids in {month}; refusing to export", file=sys.stderr)
+        return 3
+    body = render_csv(rows)
+    total = sum(int(r[2]) + int(r[3]) for r in rows)
+    print(f"{args.env}: {len(rows)} finalized invoices for {month}, total {total} cents "
+          f"-> {out} (bucket {bucket}, key {key}, dry_run={args.dry_run})")
+    if args.dry_run:
+        return 0
+
+    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
+    # utf-8 (not utf-8-sig): the import tool expects no BOM.
+    with open(out, "w", encoding="utf-8", newline="") as f:
+        f.write(body)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
