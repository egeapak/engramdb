+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (sandbox key from the dev secrets store) and MAIL_SINK_URL
+(the sink inbox API). The sandbox silently drops anything not addressed to
+@sink.acme.test, so delivery can only be checked by reading the sink inbox.
+The sandbox is capped at 500 messages a day for the whole team: send one.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY and MAIL_SINK_URL for the provider sandbox",
+    ),
+]
+
+
+def _wait_for_delivery(message_id, timeout=60):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["MAIL_SINK_URL"],
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json():
+            if msg["id"] == message_id:
+                return msg
+        time.sleep(2)
+    return None
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    # render() is not implemented yet; stub only the body, send for real.
+    body = f"<p>Receipt for {invoice_id}</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_delivery(message_id)
+    assert delivered is not None, f"{message_id} never reached the sink inbox"
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
