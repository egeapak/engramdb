diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..17b6ca1
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,81 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this need a second approver in the admin tool (Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENCY = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    now = time.time()
+    stored = _IDEMPOTENCY.get(key)
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, body, status = stored
+        return jsonify(body), status
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    actor_id = payload.get("actor_id")
+    if not isinstance(amount, dict) or not isinstance(amount.get("minor"), int) or isinstance(amount.get("minor"), bool):
+        return errors.problem(400, "Invalid amount", 'amount must be {"minor": <int>, "ccy": <str>}.')
+    if not actor_id:
+        return errors.problem(400, "Missing actor", "actor_id is required.")
+
+    amount_cents = amount["minor"]
+    if amount_cents <= 0:
+        return errors.problem(400, "Invalid amount", "amount.minor must be positive.")
+    if amount.get("ccy") != invoice.currency:
+        return errors.problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    try:
+        refund(invoice, amount_cents)
+    except ValueError as exc:
+        return errors.problem(422, "Refund not allowed", str(exc))
+
+    refund_id = str(uuid.uuid4())
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        status = "pending_approval"
+        log.info("ledger.refund_requested", refund_id=refund_id, invoice_id=invoice.id,
+                 amount_cents=amount_cents, actor_id=actor_id)
+    else:
+        status = "issued"
+        log.info("ledger.refund_issued", refund_id=refund_id, invoice_id=invoice.id,
+                 amount_cents=amount_cents, actor_id=actor_id)
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice.id,
+        "amount": _money(amount_cents, invoice.currency),
+        "status": status,
+    }
+    _IDEMPOTENCY[key] = (now, body, 201)
+    return jsonify(body), 201
