 def fetch_rates(day):
     """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    day_cube = root.find(f".//ecb:Cube[@time='{day}']", ECB_NS)
+    if day_cube is None:
+        raise LookupError(f"ECB feed has no reference rates for {day}")
+
+    # The ECB feed quotes units of each currency per 1 EUR.
+    per_eur = {"EUR": Decimal(1)}
+    for cube in day_cube.findall("ecb:Cube", ECB_NS):
+        per_eur[cube.get("currency")] = Decimal(cube.get("rate"))
+    if "USD" not in per_eur:
+        raise LookupError(f"ECB feed has no USD rate for {day}")
+
+    usd_per_eur = per_eur["USD"]
+    return {code: rate / usd_per_eur for code, rate in per_eur.items()}
 
 
