@@ -0,0 +1,57 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status_code)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Precondition Required", "X-Acme-Idempotency header is required")
+
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Not Found", f"invoice {invoice_id} not found")
+
+    data = request.get_json(silent=True) or {}
+    amount = data.get("amount")
+    actor_id = data.get("actor_id")
+    if not isinstance(amount, dict) or not isinstance(amount.get("minor"), int) or isinstance(amount.get("minor"), bool):
+        return errors.problem(400, "Bad Request", 'amount must be {"minor": <int>, "ccy": "USD"}')
+    if amount["minor"] <= 0:
+        return errors.problem(400, "Bad Request", "amount.minor must be positive")
+    ccy = amount.get("ccy", "USD")
+    if ccy != "USD":
+        return errors.problem(400, "Bad Request", "only USD refunds are supported")
+    if not actor_id:
+        return errors.problem(400, "Bad Request", "actor_id is required")
+
+    try:
+        result = refund(invoice, amount["minor"], actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Unprocessable Entity", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": ccy},
+        "status": result["status"],
+    }
+    status_code = 202 if result["status"] == "pending_approval" else 201
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), body, status_code)
+    return jsonify(body), status_code
