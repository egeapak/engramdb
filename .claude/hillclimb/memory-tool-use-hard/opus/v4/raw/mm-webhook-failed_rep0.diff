+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
 
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verify_signature():
+    secret = os.environ["PSP_WEBHOOK_SECRET"].encode()
+    expected = hmac.new(secret, request.get_data(), hashlib.sha256).hexdigest()
+    signature = request.headers.get("Psp-Signature", "")
+    if not hmac.compare_digest(expected, signature):
+        return False
+    try:
+        sent_at = int(request.headers.get("Psp-Timestamp", ""))
+    except ValueError:
+        return False
+    return abs(time.time() - sent_at) <= MAX_EVENT_AGE_SECONDS
+
+
+def _handle_payment_failed(event):
+    invoice_id = event["data"]["invoice_id"]
+    queue.enqueue(
+        "dunning.schedule_retries",
+        {"invoice_id": invoice_id},
+        dedupe_key=f"dunning:{invoice_id}:start",
+    )
+    log.info("payment_failed_retries_enqueued", invoice_id=invoice_id)
+
+
+_HANDLERS = {
+    "payment.failed": _handle_payment_failed,
+}
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    if not _verify_signature():
