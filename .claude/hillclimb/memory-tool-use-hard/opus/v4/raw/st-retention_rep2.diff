+"""Purge invoices (and their lines) past the retention period.
+
+Dry-run by default: reports what would be deleted and writes nothing.
+Pass --execute to actually delete.
+
+    python scripts/purge_invoices.py                 # dry run
+    python scripts/purge_invoices.py --execute       # delete
+"""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+import structlog
+
+log = structlog.get_logger()
+
+# Legal defines the period in days (10 years after finalization, since the
+# 2026 tax audit). Do not derive this from years.
+RETENTION_DAYS = 3650
+
+# Row locks on invoices time out checkout above this (INC-2291).
+MAX_SAFE_BATCH = 500
+
+# An invoice is eligible when it was finalized before the cutoff and has no
+# refund. The refunds table has no status column, so any refund row is treated
+# as possibly open and the invoice is kept.
+ELIGIBLE = """
+    i.finalized_at IS NOT NULL
+    AND i.finalized_at < %(cutoff)s
+    AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+"""
+
+COUNT_SQL = f"SELECT count(*), min(i.finalized_at), max(i.finalized_at) FROM invoices i WHERE {ELIGIBLE}"
+
+SAMPLE_SQL = f"SELECT i.id FROM invoices i WHERE {ELIGIBLE} ORDER BY i.finalized_at, i.id LIMIT %(limit)s"
+
+CLAIM_SQL = f"""
+    SELECT i.id FROM invoices i WHERE {ELIGIBLE}
+    ORDER BY i.finalized_at, i.id
+    LIMIT %(limit)s
+    FOR UPDATE SKIP LOCKED
+"""
+
+
+def cutoff(now=None):
+    # finalized_at is stored as naive UTC; compute the cutoff in UTC so the
+    # ops host's local zone (Europe/Berlin) can't shift it.
+    now = now or datetime.now(timezone.utc)
+    return (now - timedelta(days=RETENTION_DAYS)).replace(tzinfo=None)
+
+
+def connect(url):
+    import psycopg
+
+    # Deployed DBs sit behind a transaction-mode pooler: no prepared statements.
+    return psycopg.connect(url, prepare_threshold=None)
+
+
+def report(conn, cut, sample):
+    with conn.transaction():
+        count, oldest, newest = conn.execute(COUNT_SQL, {"cutoff": cut}).fetchone()
+        ids = [row[0] for row in conn.execute(SAMPLE_SQL, {"cutoff": cut, "limit": sample})]
+    print(f"{count} invoice(s) finalized before {cut:%Y-%m-%d %H:%M:%S} UTC are eligible for purge")
+    if count:
+        print(f"  finalized between {oldest} and {newest}")
+        print(f"  first {len(ids)}: {', '.join(ids)}")
+    return count
+
+
+def purge(conn, cut, batch_size):
+    total = 0
+    while True:
+        # One short transaction per batch so checkout isn't starved.
+        with conn.transaction():
+            ids = [row[0] for row in conn.execute(CLAIM_SQL, {"cutoff": cut, "limit": batch_size})]
+            if not ids:
+                break
+            conn.execute("DELETE FROM invoice_lines WHERE invoice_id = ANY(%(ids)s)", {"ids": ids})
+            deleted = conn.execute("DELETE FROM invoices WHERE id = ANY(%(ids)s)", {"ids": ids}).rowcount
+        total += deleted
+        log.info("invoices_purged", batch=deleted, total=total, invoice_ids=ids)
+    return total
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    parser.add_argument("--sample", type=int, default=20, help="ids to list in the dry-run report")
+    args = parser.parse_args()
+
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"--batch-size must be between 1 and {MAX_SAFE_BATCH}", file=sys.stderr)
+        return 3
+
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    cut = cutoff()
+    with connect(url) as conn:
+        count = report(conn, cut, args.sample)
+        if not args.execute:
+            print("dry run: nothing deleted (pass --execute to purge)")
+            return 0
+        if not count:
+            return 0
+        log.info("invoice_purge_started", cutoff=cut.isoformat(), retention_days=RETENTION_DAYS, eligible=count)
+        total = purge(conn, cut, args.batch_size)
+        log.info("invoice_purge_finished", deleted=total)
+        print(f"deleted {total} invoice(s)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
