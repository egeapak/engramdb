 def load_rows(month):
     """Rows for one month: dicts with customer_id, currency and total_cents."""
     raise NotImplementedError("reads from the billing warehouse")
+
+
+def revenue_by_customer(rows):
+    """Sum each customer's revenue, per currency, in Decimal major units.
+
+    Returns {customer_id: {currency: Decimal}}. Amounts in different
+    currencies are kept apart rather than added together unconverted.
+    """
+    totals = {}
+    for row in rows:
+        per_currency = totals.setdefault(row["customer_id"], {})
+        currency = row["currency"]
+        amount = Decimal(row["total_cents"]) / 100
+        per_currency[currency] = per_currency.get(currency, Decimal(0)) + amount
+    return {
+        customer_id: {
+            currency: amount.quantize(Decimal("0.0001"))
+            for currency, amount in per_currency.items()
+        }
+        for customer_id, per_currency in totals.items()
+    }
