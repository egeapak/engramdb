@@ -1,5 +1,21 @@
-from src.billing.tax import line_total
+from decimal import Decimal
+
+from src.billing.tax import line_total, tax_for
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_rounds_half_to_even():
+    assert tax_for(50, Decimal("0.05")) == 2   # 2.5 -> 2
+    assert tax_for(70, Decimal("0.05")) == 4   # 3.5 -> 4
+
+
+def test_tax_for_typical_rate():
+    assert tax_for(10000, Decimal("0.0825")) == 825
+    assert tax_for(1999, 0.0825) == 165        # 164.9175
+
+
+def test_tax_for_exempt_is_zero():
+    assert tax_for(12345, 0) == 0
