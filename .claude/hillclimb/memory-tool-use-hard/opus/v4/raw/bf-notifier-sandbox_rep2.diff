+import os
+import time
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The provider sandbox answers 202 but silently drops anything not addressed to
+# the sink domain, so delivery can only be asserted for @sink.acme.test.
+SINK_ADDR = "receipts@sink.acme.test"
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not os.environ.get("MAIL_API_KEY") or not os.environ.get("MAIL_SINK_URL"),
+        reason="needs MAIL_API_KEY (sandbox key) and MAIL_SINK_URL",
+    ),
+]
+
+
+def _wait_for_message(message_id, timeout=30, interval=2):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            f"{os.environ['MAIL_SINK_URL'].rstrip('/')}/messages",
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json():
+            if msg["id"] == message_id:
+                return msg
+        time.sleep(interval)
+    return None
+
+
+def test_send_receipt_is_delivered_to_sink():
+    # render() is not implemented yet, so stub the body; everything from
+    # provider.send onwards goes over the network to the sandbox.
+    with mock.patch.object(email, "render", return_value="<p>Receipt inv_it_1</p>"):
+        message_id = email.send_receipt("inv_it_1", SINK_ADDR, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_message(message_id)
+    assert delivered is not None, f"message {message_id} never reached the sink"
+    assert delivered["subject"] == "Your receipt"
