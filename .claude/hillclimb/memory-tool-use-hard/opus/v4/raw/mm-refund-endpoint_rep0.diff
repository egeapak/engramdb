+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_HEADER = "X-Acme-Idempotency"
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+def _money(cents, ccy="USD"):
+    return {"minor": cents, "ccy": ccy}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get(IDEMPOTENCY_HEADER)
+    if not key:
+        return errors.problem(428, "Idempotency key required", f"Send the {IDEMPOTENCY_HEADER} header.")
+
+    now = time.time()
+    stored = _RESPONSES.get(key)
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send the X-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict) or not isinstance(amount.get("minor"), int) or isinstance(amount["minor"], bool):
+        return errors.problem(400, "Invalid amount", 'Send amount as {"minor": <integer>, "ccy": "USD"}.')
+    if amount.get("ccy", "USD") != "USD":
+        return errors.problem(400, "Invalid amount", "Only USD refunds are supported.")
+    if amount["minor"] <= 0:
+        return errors.problem(400, "Invalid amount", "Refund amount must be positive.")
+
+    try:
+        result = refund(invoice, amount["minor"], actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"]),
+        "status": result["status"],
+    }
+    status = 201 if result["status"] == "issued" else 202
+    _RESPONSES[key] = (now, body, status)
+    return jsonify(body), status
