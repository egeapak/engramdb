+import os
+
+import psycopg
+
+
+def get_conn(**kwargs):
+    """Open a psycopg connection to DATABASE_URL.
+
+    In staging and production we connect through a transaction-mode pooler, which
+    breaks server-side prepared statements, so automatic preparing is turned off.
+    Keep transactions short: don't hold one open across an HTTP call.
+    """
+    kwargs.setdefault("prepare_threshold", None)
+    return psycopg.connect(os.environ["DATABASE_URL"], **kwargs)
