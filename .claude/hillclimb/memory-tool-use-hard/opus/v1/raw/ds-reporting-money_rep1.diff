 def load_rows(month):
     """Rows for one month: dicts with customer_id, currency and total_cents."""
     raise NotImplementedError("reads from the billing warehouse")
+
+
+def revenue_by_customer(rows):
+    """Total revenue per customer_id, as Decimal major units quantized to 4 places.
+
+    Raises ValueError if a customer has rows in more than one currency, since
+    amounts in different currencies can't be summed without FX conversion.
+    """
+    totals = {}
+    currencies = {}
+    for row in rows:
+        customer_id = row["customer_id"]
+        currency = currencies.setdefault(customer_id, row["currency"])
+        if row["currency"] != currency:
+            raise ValueError(
+                f"customer {customer_id} has rows in both {currency} and {row['currency']}"
+            )
+        amount = Decimal(row["total_cents"]) / 100
+        totals[customer_id] = totals.get(customer_id, Decimal(0)) + amount
+    return {
+        customer_id: total.quantize(Decimal("0.0001"))
+        for customer_id, total in totals.items()
+    }
