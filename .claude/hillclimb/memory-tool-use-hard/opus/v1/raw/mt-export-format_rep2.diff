+"""Export one month's finalized invoices as a CSV for Finance's accounting import.
+
+Format is dictated by Finance's import tool: comma-separated, ISO dates
+(YYYY-MM-DD), amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# finalized_at is stored as naive UTC; drafts have no finalized_at.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    return f"{now.year - 1}-12" if now.month == 1 else f"{now.year}-{now.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def load_finalized(conn, month):
+    start, end = month_window(month)
+    return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(rows, fh):
+    writer = csv.writer(fh, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime("%Y-%m-%d"),
+        ])
 
 
 def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+    parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", default=previous_month(), help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", help="output path (default: exports/<YYYY-MM>/invoices.csv)")
+    parser.add_argument("--dry-run", action="store_true", help="write the CSV to stdout instead of a file")
     args = parser.parse_args()
-    bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    month_window(args.month)  # validate before touching the database
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        rows = load_finalized(conn, args.month)
+
+    if args.dry_run:
+        write_csv(rows, sys.stdout)
+        print(f"{len(rows)} finalized invoices for {args.month} ({args.env}, dry run)", file=sys.stderr)
+        return 0
+
+    out = Path(args.out or f"exports/{args.month}/invoices.csv")
+    out.parent.mkdir(parents=True, exist_ok=True)
+    with out.open("w", encoding="utf-8", newline="") as fh:
+        write_csv(rows, fh)
+    print(f"wrote {len(rows)} finalized invoices for {args.month} ({args.env}) to {out}", file=sys.stderr)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
