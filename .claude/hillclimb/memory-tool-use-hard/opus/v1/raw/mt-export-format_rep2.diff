@@ -0,0 +1,27 @@
+import io
+from datetime import datetime
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_write_csv_uses_finance_import_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    buf = io.StringIO()
+    write_csv(rows, buf)
+    assert buf.getvalue() == (
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\n"
+        "inv_1,cus_1,10000,1900,11900,2026-09-03\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\n"
+    )
+
+
+def test_month_window_wraps_december():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month():
+    assert previous_month(datetime(2026, 10, 2)) == "2026-09"
+    assert previous_month(datetime(2027, 1, 2)) == "2026-12"
