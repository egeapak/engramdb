-    raise NotImplementedError
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Days after the failed charge on which to retry it (finance policy FP-12; contractual).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `dunning.retry_charge` job per entry in RETRY_DAYS. The last
+    attempt is flagged `final`: if it also fails, the job marks the invoice
+    `uncollectible` and dunning stops. Invoices with a refund in progress are
+    never retried. Returns the list of scheduled retry times.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    if failed_at is None:
+        failed_at = datetime.now(timezone.utc)
+
+    scheduled = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        queue.enqueue(
+            "dunning.retry_charge",
+            {"invoice_id": invoice.id, "attempt": attempt, "final": attempt == len(RETRY_DAYS)},
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        scheduled.append(run_at)
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, attempts=len(scheduled))
+    return scheduled
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..e97a90c
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,41 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from src.billing.dunning import schedule_retries
+from src.billing.invoices import Invoice
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+def test_schedules_retries_on_days_1_3_7_14(backend):
+    failed_at = datetime(2026, 10, 1, 12, tzinfo=timezone.utc)
+    scheduled = schedule_retries(Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000), failed_at)
+
+    assert scheduled == [failed_at + timedelta(days=d) for d in (1, 3, 7, 14)]
+    assert [job[0] for job in backend.jobs] == ["dunning.retry_charge"] * 4
+    assert [job[1]["attempt"] for job in backend.jobs] == [1, 2, 3, 4]
+    assert [job[1]["final"] for job in backend.jobs] == [False, False, False, True]
+    assert [job[2]["dedupe_key"] for job in backend.jobs] == [f"dunning:inv_1:{n}" for n in (1, 2, 3, 4)]
+    assert [job[2]["run_at"] for job in backend.jobs] == scheduled
+
+
+def test_no_retries_while_refund_in_progress(backend):
+    invoice = Invoice(id="inv_2", customer_id="cus_1", subtotal_cents=1000)
+    assert schedule_retries(invoice, refund_in_progress=True) == []
+    assert backend.jobs == []
