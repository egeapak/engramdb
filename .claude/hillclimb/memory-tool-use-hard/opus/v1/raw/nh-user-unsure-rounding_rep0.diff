+from decimal import Decimal
+
+from src.billing.tax import line_total, tax_for
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_rounds_half_even():
+    assert tax_for(10, Decimal("0.25")) == 2  # 2.5 -> 2
+    assert tax_for(30, Decimal("0.25")) == 8  # 7.5 -> 8
+
+
+def test_tax_for_typical_rate():
+    assert tax_for(10000, Decimal("0.0825")) == 825
+    assert tax_for(1999, Decimal("0.0825")) == 165  # 164.9175
+
+
+def test_tax_for_exempt_is_zero():
+    assert tax_for(5000, 0) == 0
