+
+
+def revenue_by_customer(rows):
+    """Sum each customer's revenue for the month, per currency.
+
+    Returns {(customer_id, currency): Decimal} in major units, quantized to
+    4 places. Amounts in different currencies are never added together.
+    """
+    totals = {}
+    for row in rows:
+        key = (row["customer_id"], row["currency"])
+        amount = Decimal(row["total_cents"]) / 100
+        totals[key] = totals.get(key, Decimal(0)) + amount
+    return {key: total.quantize(Decimal("0.0001")) for key, total in totals.items()}
