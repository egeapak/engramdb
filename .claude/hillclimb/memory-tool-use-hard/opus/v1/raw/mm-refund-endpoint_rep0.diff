@@ -0,0 +1,51 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (idempotency key, invoice id) -> (stored_at, response body, status code)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    cached = _RESPONSES.get((key, invoice_id))
+    if cached and time.time() - cached[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(cached[1]), cached[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    data = request.get_json(silent=True) or {}
+    amount_cents = data.get("amount_cents")
+    actor_id = data.get("actor_id")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool):
+        return problem(400, "Invalid refund", "amount_cents must be an integer.")
+    if not actor_id:
+        return problem(400, "Invalid refund", "actor_id is required.")
+
+    try:
+        result = refund(invoice, amount_cents, actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    status_code = 202 if result["status"] == "pending_approval" else 201
+    _RESPONSES[(key, invoice_id)] = (time.time(), body, status_code)
+    return jsonify(body), status_code
