diff --git a/src/billing/tax.py b/src/billing/tax.py
index 7f21856..b9f7c15 100644
--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,13 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    # str() first so a float rate like 0.0825 isn't carried in as its binary approximation
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    # Quebec (2025 Revenu Quebec audit): QST is shown per line, so round each line's tax then sum
+    if region == "CA-QC":
+        return sum(tax_for(line_total([line]), rate) for line in lines)
+    return tax_for(line_total(lines), rate)
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..a7aae58 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -1,5 +1,34 @@
-from src.billing.tax import line_total
+from decimal import Decimal
+
+from src.billing.tax import invoice_tax, line_total
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+LINES = [{"quantity": 1, "unit_cents": 5}, {"quantity": 1, "unit_cents": 5}]
+
+
+def test_invoice_tax_rounds_subtotal_once():
+    # 10 * 0.25 = 2.5 -> 2 (half-even)
+    assert invoice_tax(LINES, Decimal("0.25"), "US-TX") == 2
+
+
+def test_invoice_tax_quebec_rounds_per_line():
+    # each line 5 * 0.3 = 1.5 -> 2 (half-even), summed = 4; subtotal rounding would give 3
+    assert invoice_tax(LINES, Decimal("0.3"), "CA-QC") == 4
+    assert invoice_tax(LINES, Decimal("0.3"), "US-TX") == 3
+
+
+def test_invoice_tax_half_even():
+    assert invoice_tax([{"quantity": 1, "unit_cents": 10}], Decimal("0.05"), "US-TX") == 0
+    assert invoice_tax([{"quantity": 1, "unit_cents": 30}], Decimal("0.05"), "US-TX") == 2
+
+
+def test_invoice_tax_exempt_is_zero():
+    assert invoice_tax(LINES, 0, "US-TX") == 0
+
+
+def test_invoice_tax_float_rate():
+    assert invoice_tax([{"quantity": 1, "unit_cents": 10000}], 0.0825, "US-TX") == 825
