+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    now = time.time()
+    stored = _IDEMPOTENT_RESPONSES.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return errors.problem(422, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<code>"}.')
+    minor = amount.get("minor")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return errors.problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if amount.get("ccy") != invoice.currency:
+        return errors.problem(422, "Currency mismatch", f"The invoice is in {invoice.currency}.")
+
+    try:
+        result = refund(invoice, minor, actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund not allowed", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status = 201 if result["status"] == "issued" else 202
+    _IDEMPOTENT_RESPONSES[(invoice_id, key)] = (now, body, status)
+    return jsonify(body), status
