+++ b/tests/test_refunds.py
@@ -0,0 +1,60 @@
+import pytest
+from flask import Flask
+
+from src.api import refunds as refunds_api
+from src.api.invoices import _INVOICES
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds_api.bp)
+    _INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    yield app.test_client()
+    _INVOICES.clear()
+    refunds_api._IDEMPOTENT_RESPONSES.clear()
+
+
+def post(client, minor, key="k1", ccy="USD", invoice_id="inv_1"):
+    headers = {"X-Acme-Actor-Id": "usr_1"}
+    if key:
+        headers["X-Acme-Idempotency"] = key
+    return client.post(f"/invoices/{invoice_id}/refunds", json={"amount": {"minor": minor, "ccy": ccy}}, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, 50_000)
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "amount": {"minor": 50_000, "ccy": "USD"}, "status": "issued"}
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, 50_001)
+    assert resp.status_code == 202
+    assert resp.get_json()["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key_is_rejected(client):
+    resp = post(client, 100, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_response(client):
+    first = post(client, 100)
+    second = post(client, 999)
+    assert second.status_code == first.status_code
+    assert second.get_json() == first.get_json()
+
+
+def test_refund_over_total_is_rejected(client):
+    assert post(client, 100_001).status_code == 422
+
+
+def test_currency_mismatch_is_rejected(client):
+    assert post(client, 100, ccy="EUR").status_code == 422
+
+
+def test_unknown_invoice(client):
+    assert post(client, 100, invoice_id="nope").status_code == 404
