+import structlog
+
 from .invoices import Invoice
 
+log = structlog.get_logger()
+
+# Refunds above this need a second approver in the admin tool (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+
 
-def refund(invoice: Invoice, amount_cents: int):
+def refund(invoice: Invoice, amount_cents: int, actor_id: str):
+    if amount_cents <= 0:
+        raise ValueError("refund must be positive")
     if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
-    return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        status = "pending_approval"
+    else:
+        status = "issued"
+        log.info("ledger.refund_issued", invoice_id=invoice.id, refunded_cents=amount_cents, actor_id=actor_id)
+    return {"invoice_id": invoice.id, "refunded_cents": amount_cents, "status": status}
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..5b765b4
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,64 @@
+import pytest
+from flask import Flask
+
+from src.api import refunds as refunds_api
+from src.api.invoices import _INVOICES
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds_api.bp)
+    _INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=100_000, tax_cents=0)
+    yield app.test_client()
+    _INVOICES.clear()
+    refunds_api._IDEMPOTENT_RESPONSES.clear()
+
+
+def post(client, minor, key="k1", invoice_id="inv_1"):
+    headers = {"X-Acme-Actor-Id": "usr_1"}
+    if key:
+        headers["X-Acme-Idempotency"] = key
+    return client.post(f"/invoices/{invoice_id}/refunds", json={"amount": {"minor": minor, "ccy": "USD"}}, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, 1_000)
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "status": "issued", "amount": {"minor": 1_000, "ccy": "USD"}}
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, 50_001)
+    assert resp.status_code == 201
+    assert resp.get_json()["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key_is_rejected(client):
+    resp = post(client, 1_000, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_response(client, monkeypatch):
+    first = post(client, 1_000)
+    calls = []
+    monkeypatch.setattr(refunds_api, "refund", lambda *a, **kw: calls.append(a))
+    second = post(client, 1_000)
+    assert calls == []
+    assert second.status_code == 201
+    assert second.get_json() == first.get_json()
+
+
+def test_unknown_invoice_is_404(client):
+    assert post(client, 1_000, invoice_id="nope").status_code == 404
+
+
+@pytest.mark.parametrize("minor", [0, -5, 1.5, "100", True])
+def test_invalid_amount_is_400(client, minor):
+    assert post(client, minor).status_code == 400
+
+
+def test_refund_over_total_is_422(client):
+    assert post(client, 100_001).status_code == 422
