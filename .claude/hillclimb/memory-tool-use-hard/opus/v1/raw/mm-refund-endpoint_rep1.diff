+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, status_code, body)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, status_code, body = stored
+        return jsonify(body), status_code
+
+    # TODO: take the actor from the authenticated session once the API has auth.
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return problem(401, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return problem(400, "Invalid refund", 'Expected "amount": {"minor": <int>, "ccy": "USD"}.')
+    minor = amount.get("minor")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return problem(400, "Invalid refund", "amount.minor must be a positive integer.")
+    if amount.get("ccy") != "USD":
+        return problem(400, "Invalid refund", "amount.ccy must be USD.")
+
+    try:
+        result = refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "status": result["status"],
+        "amount": {"minor": result["refunded_cents"], "ccy": "USD"},
+    }
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), 201, body)
+    return jsonify(body), 201
