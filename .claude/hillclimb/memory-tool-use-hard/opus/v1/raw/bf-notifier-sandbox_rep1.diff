+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (the sandbox key from the dev secrets store) and
+MAIL_SINK_URL (the sink inbox API's message-list endpoint). Skipped otherwise.
+
+The sandbox accepts mail to any address but only delivers to the
+@sink.acme.test domain, so the recipient must stay on that domain or the
+delivery check can never pass. The sandbox is capped at 500 messages a day for
+the whole team: keep this to a single send.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+RECIPIENT = "receipts@sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_URL",
+    ),
+]
+
+
+def _wait_for_message(message_id, marker):
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["MAIL_SINK_URL"],
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": RECIPIENT},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json():
+            if msg.get("id") == message_id or marker in msg.get("html", ""):
+                return msg
+        time.sleep(POLL_INTERVAL_S)
+    return None
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() has no templates yet; stub it so the real provider path runs.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, RECIPIENT, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_message(message_id, invoice_id)
+    assert delivered is not None, f"{message_id} not in sink after {DELIVERY_TIMEOUT_S}s"
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
