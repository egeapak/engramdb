+++ b/src/api/refunds.py
@@ -0,0 +1,57 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing import refunds
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status code)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    now = time.time()
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict) or amount.get("ccy") != invoice.currency:
+        return errors.problem(400, "Invalid amount", f'Send amount as {{"minor": <int>, "ccy": "{invoice.currency}"}}.')
+    minor = amount.get("minor")
+    if not isinstance(minor, int) or isinstance(minor, bool):
+        return errors.problem(400, "Invalid amount", "amount.minor must be an integer.")
+
+    try:
+        result = refunds.refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "id": result["id"],
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status_code = 201 if result["status"] == "issued" else 202
+    _IDEMPOTENT_RESPONSES[key] = (now, body, status_code)
+    return jsonify(body), status_code
