+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Format is fixed by Finance's import tool (German locale): `;` delimiter,
+DD.MM.YYYY dates, integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sqlite3
+import sys
+from datetime import date, datetime
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DEV_DB = ROOT / "var" / "dev.sqlite3"
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# finalized_at is stored as naive UTC, so the window is plain naive datetimes;
+# drafts have no finalized_at and fall out of the range check.
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+    "WHERE finalized_at >= {p} AND finalized_at < {p} ORDER BY finalized_at, id"
+)
+
+
+def previous_month(today):
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_rows(start, end):
+    url = os.environ.get("DATABASE_URL")
+    if url:
+        import psycopg
+
+        # Deployed envs go through a transaction-mode pooler: no prepared statements.
+        with psycopg.connect(url, prepare_threshold=None) as conn:
+            return conn.execute(QUERY.format(p="%s"), (start, end)).fetchall()
+    with sqlite3.connect(DEV_DB) as conn:
+        return conn.execute(QUERY.format(p="?"), (start.isoformat(" "), end.isoformat(" "))).fetchall()
+
+
+def as_date(value):
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    return datetime.fromisoformat(value).date()
+
+
+def render_csv(rows):
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        subtotal, tax = int(subtotal), int(tax)
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax,
+                         as_date(finalized_at).strftime("%d.%m.%Y")])
+    return buf.getvalue()
 
 
