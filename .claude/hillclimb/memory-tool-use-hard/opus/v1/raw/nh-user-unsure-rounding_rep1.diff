-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,6 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    # Banker's rounding, agreed with finance (March 2026); not ROUND_HALF_UP.
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..6f0a380 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -1,5 +1,21 @@
-from src.billing.tax import line_total
+from decimal import Decimal
+
+from src.billing.tax import line_total, tax_for
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_rounds_half_to_even():
+    assert tax_for(50, Decimal("0.05")) == 2  # 2.5 -> 2
+    assert tax_for(70, Decimal("0.05")) == 4  # 3.5 -> 4
+
+
+def test_tax_for_typical_rate():
+    assert tax_for(1000, Decimal("0.0825")) == 82  # 82.5 -> 82
+    assert tax_for(1234, Decimal("0.0825")) == 102  # 101.805 -> 102
+
+
+def test_tax_for_exempt_is_zero():
+    assert tax_for(1000, 0) == 0
