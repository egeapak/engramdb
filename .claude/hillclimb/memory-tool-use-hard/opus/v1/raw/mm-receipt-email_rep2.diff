diff --git a/tests/test_invoices.py b/tests/test_invoices.py
new file mode 100644
index 0000000..fd15e7d
--- /dev/null
+++ b/tests/test_invoices.py
@@ -0,0 +1,44 @@
+from unittest import mock
+
+import pytest
+
+from src.billing import invoices
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+def _finalize(invoice):
+    invoice.ledger_ref = "led_1"
+    return invoice
+
+
+def test_finalize_once_enqueues_receipt(backend):
+    inv = invoices.Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=200)
+    with mock.patch.object(invoices, "finalize", side_effect=_finalize):
+        invoices.finalize_once(inv)
+    assert backend.jobs == [
+        ("invoices.send_receipt", {"invoice_id": "inv_1", "customer_id": "cus_1"}, {"dedupe_key": "receipt:inv_1"}),
+    ]
+
+
+def test_finalize_once_skips_receipt_when_already_finalized(backend):
+    inv = invoices.Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, ledger_ref="led_1")
+    with mock.patch.object(invoices, "finalize") as finalize:
+        invoices.finalize_once(inv)
+    finalize.assert_not_called()
+    assert backend.jobs == []
