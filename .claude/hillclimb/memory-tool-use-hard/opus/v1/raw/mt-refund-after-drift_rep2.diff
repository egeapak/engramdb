@@ -0,0 +1,54 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.api.errors import problem
+from src.api.invoices import _INVOICES
+from src.billing.refunds import refund
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENT_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return problem(400, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    if not isinstance(amount, dict) or type(amount.get("minor")) is not int:
+        return problem(400, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<code>"}.')
+    if amount.get("ccy") != invoice.currency:
+        return problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    try:
+        result = refund(invoice, amount["minor"], actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Invalid refund", str(exc))
+
+    response = {
+        "id": result["id"],
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": result["currency"]},
+        "status": result["status"],
+    }
+    status = 202 if result["status"] == "pending_approval" else 201
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), response, status)
+    return jsonify(response), status
