+"""Integration test: send a real receipt through the email provider sandbox.
+
+Needs the sandbox key (from the dev secrets store) and the sink inbox API:
+
+    export MAIL_API_KEY=...            # sandbox key, never the production one
+    export MAIL_SINK_API_URL=...       # base URL of the sink inbox API
+    python -m pytest --import-mode=importlib tests/test_email_integration.py
+
+The sandbox answers 202 for every recipient but only delivers to the
+@sink.acme.test domain, so delivery is checked by reading the message back
+from the sink inbox. The sandbox is capped at 2 msg/s and 500 msg/day for the
+whole team: this test sends exactly one message.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 3
+
+pytestmark = pytest.mark.skipif(
+    not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_API_URL")),
+    reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_API_URL",
+)
+
+
+def _find_in_sink(token):
+    resp = requests.get(
+        f"{os.environ['MAIL_SINK_API_URL'].rstrip('/')}/messages",
+        headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+        params={"to": SINK_ADDR},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    for msg in resp.json():
+        if token in msg.get("html", ""):
+            return msg
+    return None
+
+
+def test_send_receipt_is_delivered_to_sink():
+    # A unique invoice id lets us pick our message out of the shared sink inbox.
+    invoice_id = f"inv_it_{uuid.uuid4().hex}"
+
+    # render() is not implemented yet; stub it so the real provider path runs.
+    # Drop this patch once render.py has a receipt template.
+    body = f"<p>Receipt for {invoice_id}: 1200</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    delivered = None
+    while time.monotonic() < deadline:
+        delivered = _find_in_sink(invoice_id)
+        if delivered:
+            break
+        time.sleep(POLL_INTERVAL_S)
+
+    assert delivered is not None, f"message {message_id} not in sink after {DELIVERY_TIMEOUT_S}s"
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
