+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verify_signature():
+    """Check the PSP signature and timestamp; return True if the event is genuine."""
+    secret = os.environ["PSP_WEBHOOK_SECRET"].encode()
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Timestamp", "")
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return False
+    if abs(time.time() - sent_at) > MAX_EVENT_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret, request.get_data(), hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, signature)
+
+
+def _on_payment_failed(event):
+    invoice_id = event["data"]["invoice_id"]
+    # Dedupe on the PSP event id so redeliveries of the same event are dropped.
+    queue.enqueue(
+        "dunning.schedule_retries",
+        {"invoice_id": invoice_id},
+        dedupe_key=f"dunning:{invoice_id}:{event['id']}",
+    )
+    log.info("payment_failed_retries_enqueued", invoice_id=invoice_id, event_id=event["id"])
+
+
+_HANDLERS = {
+    "payment.failed": _on_payment_failed,
+}
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    if not _verify_signature():
