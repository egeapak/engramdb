+import os
+
+import psycopg
+
+
+def get_conn():
+    # Deployed envs go through a transaction-mode pooler (port 6432), where
+    # server-side prepared statements break; keep them off everywhere.
+    return psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None)
