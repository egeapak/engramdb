+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (the sandbox key from the dev secrets store) and
+MAIL_SINK_API_URL (the sink inbox API); skipped when either is missing.
+
+The sandbox accepts every message with a 202 but only delivers to the
+@sink.acme.test domain, so the recipient must stay on that domain or the
+test can never see the message. The sandbox is also capped at 500 messages
+a day for the whole team: this test sends exactly one.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_API_URL")),
+        reason="needs MAIL_API_KEY and MAIL_SINK_API_URL for the provider sandbox",
+    ),
+]
+
+
+def _find_in_sink(marker):
+    resp = requests.get(
+        f"{os.environ['MAIL_SINK_API_URL'].rstrip('/')}/messages",
+        headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+        params={"to": SINK_ADDR},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    for msg in resp.json():
+        if marker in msg.get("html", ""):
+            return msg
+    return None
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex}"
+    # render() has no implementation yet; give the message a unique body so
+    # it can be told apart from other runs in the shared sink inbox.
+    body = f"<p>Receipt for {invoice_id}</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+    assert message_id
+
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    delivered = None
+    while delivered is None and time.monotonic() < deadline:
+        time.sleep(POLL_INTERVAL_S)
+        delivered = _find_in_sink(invoice_id)
+
+    assert delivered is not None, f"message {message_id} not delivered within {DELIVERY_TIMEOUT_S}s"
+    assert delivered["subject"] == "Your receipt"
