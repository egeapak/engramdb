+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Events whose Psp-Signature-Timestamp is further than this from now are rejected
+# (replay protection; PSP v2 spec).
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return an error message if the request fails verification, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        # Fail closed: never accept events when the secret is not configured.
+        return "webhook secret is not configured"
+
+    signature = request.headers.get("Psp-Signature")
+    if not signature:
+        return "missing Psp-Signature header"
+
+    try:
+        timestamp = int(request.headers.get("Psp-Signature-Timestamp", ""))
+    except ValueError:
+        return "missing or malformed Psp-Signature-Timestamp header"
+    if abs(time.time() - timestamp) > MAX_EVENT_AGE_SECONDS:
+        return "event timestamp is outside the allowed window"
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(cache=True), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "invalid signature"
+
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure:
+        return errors.problem(401, "Webhook verification failed", failure)
+
