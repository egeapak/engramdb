+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Events older (or further in the future) than this are rejected as replays.
+MAX_TIMESTAMP_SKEW_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return None if the request is authentic, otherwise a problem+json response."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return errors.problem(500, "Webhook secret not configured")
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return errors.problem(401, "Invalid webhook", "Missing or malformed Psp-Signature-Timestamp header.")
+    if abs(time.time() - sent_at) > MAX_TIMESTAMP_SKEW_SECONDS:
+        return errors.problem(401, "Invalid webhook", "Psp-Signature-Timestamp is outside the allowed window.")
+
+    expected = hmac.new(secret.encode(), request.get_data(), hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return errors.problem(401, "Invalid webhook", "Psp-Signature does not match.")
+
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure is not None:
+        return failure
+
