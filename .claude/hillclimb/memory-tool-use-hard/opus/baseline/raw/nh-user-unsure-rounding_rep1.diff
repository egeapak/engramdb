--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,9 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    """Tax in integer cents on amount_cents at a decimal-fraction rate (0.0825 for 8.25%).
+
+    Rounds with banker's rounding (ROUND_HALF_EVEN), as agreed with finance.
+    """
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..d667f33 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -1,5 +1,25 @@
-from src.billing.tax import line_total
+from decimal import Decimal
+
+from src.billing.tax import line_total, tax_for
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_basic():
+    assert tax_for(10000, Decimal("0.0825")) == 825
+
+
+def test_tax_for_zero_rate():
+    assert tax_for(12345, 0) == 0
+
+
+def test_tax_for_rounds_half_even():
+    # 250 * 0.05 = 12.5 -> 12; 350 * 0.05 = 17.5 -> 18
+    assert tax_for(250, Decimal("0.05")) == 12
+    assert tax_for(350, Decimal("0.05")) == 18
+
+
+def test_tax_for_accepts_float_rate():
+    assert tax_for(250, 0.05) == 12
