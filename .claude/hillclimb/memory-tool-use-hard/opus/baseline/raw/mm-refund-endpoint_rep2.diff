@@ -0,0 +1,50 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    data = request.get_json(silent=True) or {}
+    amount = data.get("amount_cents")
+    actor_id = data.get("actor_id")
+    if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+        return problem(400, "Invalid amount", "amount_cents must be a positive integer.")
+    if not actor_id:
+        return problem(400, "Missing actor", "actor_id is required.")
+
+    try:
+        result = refund(invoice, amount, actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    status = 202 if result["status"] == "pending_approval" else 201
+    _RESPONSES[key] = (time.time(), body, status)
+    return jsonify(body), status
