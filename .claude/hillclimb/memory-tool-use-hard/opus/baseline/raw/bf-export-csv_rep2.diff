+++ b/tests/test_export.py
@@ -0,0 +1,24 @@
+from datetime import date, datetime
+
+from scripts.export import month_window, previous_month, to_csv
+
+
+def test_csv_format_for_finance_import():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 23, 30)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 0, 0)),
+    ]
+    assert to_csv(rows) == (
+        "invoice_id;customer_id;subtotal_cents;tax_cents;total_cents;finalized_date\r\n"
+        "inv_1;cus_1;10000;1900;11900;03.09.2026\r\n"
+        "inv_2;cus_2;0;0;0;30.09.2026\r\n"
+    )
+
+
+def test_month_window_wraps_year():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month():
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
