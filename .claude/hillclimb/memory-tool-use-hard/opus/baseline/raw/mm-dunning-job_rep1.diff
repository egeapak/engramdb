 """Follow-up when a customer's payment fails."""
+from datetime import datetime, timedelta, timezone
 
+import structlog
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Finance policy FP-12 (contractual): retry on these days after the failure.
+# If the last retry also fails, the retry job marks the invoice uncollectible.
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Returns the list of (attempt, run_at) pairs that were enqueued; empty when
+    the invoice has a refund in progress, since those are never retried.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    planned = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        queue.enqueue(
+            "dunning.retry_charge",
+            {
+                "invoice_id": invoice.id,
+                "attempt": attempt,
+                "final": attempt == len(RETRY_DAYS),
+            },
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        planned.append((attempt, run_at))
+
+    log.info("dunning_scheduled", invoice_id=invoice.id, attempts=len(planned))
+    return planned
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..043a264
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,38 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from src.billing.dunning import schedule_retries
+from src.billing.invoices import Invoice
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+def test_schedules_fp12_retry_days(backend):
+    failed_at = datetime(2026, 10, 2, 12, tzinfo=timezone.utc)
+    planned = schedule_retries(Invoice("inv_1", "cus_1", 1000), failed_at=failed_at)
+
+    assert [run_at - failed_at for _, run_at in planned] == [timedelta(days=d) for d in (1, 3, 7, 14)]
+    assert [opts["dedupe_key"] for _, _, opts in backend.jobs] == [f"dunning:inv_1:{n}" for n in (1, 2, 3, 4)]
+    assert all(name == "dunning.retry_charge" for name, _, _ in backend.jobs)
+    assert [payload["final"] for _, payload, _ in backend.jobs] == [False, False, False, True]
+
+
+def test_no_retries_while_refund_in_progress(backend):
+    assert schedule_retries(Invoice("inv_1", "cus_1", 1000), refund_in_progress=True) == []
+    assert backend.jobs == []
