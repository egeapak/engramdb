+def test_invoice_tax_quebec_rounds_per_line():
+    lines = [{"quantity": 1, "unit_cents": 6}, {"quantity": 1, "unit_cents": 6}]
+    # per line: 6 * 0.25 = 1.5 -> 2, twice = 4; subtotal would give 3
