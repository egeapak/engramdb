new file mode 100644
index 0000000..a9693e1
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,45 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status_code)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, body, status_code = stored
+        return jsonify(body), status_code
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer.")
+
+    try:
+        body = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    status_code = 202 if body["status"] == "pending_approval" else 201
+    _RESPONSES[key] = (time.time(), body, status_code)
+    return jsonify(body), status_code
