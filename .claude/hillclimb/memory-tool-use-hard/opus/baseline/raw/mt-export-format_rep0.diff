@@ -0,0 +1,40 @@
+import importlib.util
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+_spec = importlib.util.spec_from_file_location("export", Path(__file__).resolve().parent.parent / "scripts" / "export.py")
+export = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(export)
+
+
+def test_render_csv_is_comma_separated_with_iso_dates():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 1, 0, 0, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59, 59)),
+    ]
+    data = export.render_csv(rows)
+    assert not data.startswith(b"\xef\xbb\xbf")
+    assert data.decode("utf-8").splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,10000,1900,11900,2026-09-01",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_render_csv_rejects_duplicate_invoices():
+    row = ("inv_1", "cus_1", 100, 0, datetime(2026, 9, 2))
+    with pytest.raises(ValueError):
+        export.render_csv([row, row])
+
+
+def test_month_window_is_half_open_and_handles_december():
+    assert export.month_window("2026-09") == (datetime(2026, 9, 1), datetime(2026, 10, 1))
+    assert export.month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month_defaults():
+    assert export.previous_month(datetime(2026, 10, 2, 6, tzinfo=timezone.utc)) == "2026-09"
+    assert export.previous_month(datetime(2027, 1, 2, 6, tzinfo=timezone.utc)) == "2026-12"
+    assert export.export_key("2026-09") == "exports/2026-09/invoices.csv"
