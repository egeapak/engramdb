new file mode 100644
index 0000000..5cab7cc
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,55 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing import refunds
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status_code)
+_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    body = request.get_json(silent=True) or {}
+    amount_cents = body.get("amount_cents")
+    actor_id = body.get("actor_id")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return errors.problem(400, "Invalid amount", "amount_cents must be a positive integer.")
+    if not actor_id:
+        return errors.problem(400, "Missing actor", "actor_id is required.")
+
+    try:
+        result = refunds.refund(invoice, amount_cents, actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    out = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status_code = 201 if result["status"] == "issued" else 202
+    _RESPONSES[key] = (time.time(), out, status_code)
+    resp = jsonify(out)
+    resp.status_code = status_code
+    return resp
