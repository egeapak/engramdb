@@ -0,0 +1,44 @@
+import datetime as dt
+
+import pytest
+
+from scripts.export import FinalizedInvoice, export, previous_month
+
+
+def inv(id, subtotal, tax, day):
+    return FinalizedInvoice(id, "cus_" + id, subtotal, tax, day)
+
+
+def test_writes_finance_format(tmp_path):
+    invoices = [
+        inv("in_2", 0, 0, dt.date(2026, 9, 30)),
+        inv("in_1", 12345, 2346, dt.date(2026, 9, 1)),
+        inv("in_aug", 100, 19, dt.date(2026, 8, 31)),
+        inv("in_oct", 100, 19, dt.date(2026, 10, 1)),
+    ]
+    path, rows = export("2026-09", tmp_path, invoices)
+    assert path == tmp_path / "exports" / "2026-09" / "invoices.csv"
+    raw = path.read_bytes()
+    assert not raw.startswith(b"\xef\xbb\xbf")
+    assert raw.decode("utf-8").splitlines() == [
+        "invoice_id;customer_id;subtotal_cents;tax_cents;total_cents;finalized_date",
+        "in_1;cus_in_1;12345;2346;14691;01.09.2026",
+        "in_2;cus_in_2;0;0;0;30.09.2026",
+    ]
+
+
+def test_dry_run_writes_nothing(tmp_path):
+    path, rows = export("2026-09", tmp_path, [inv("in_1", 1, 0, dt.date(2026, 9, 5))], dry_run=True)
+    assert len(rows) == 1
+    assert not path.exists()
+
+
+def test_duplicate_invoice_is_rejected(tmp_path):
+    dup = inv("in_1", 1, 0, dt.date(2026, 9, 5))
+    with pytest.raises(ValueError):
+        export("2026-09", tmp_path, [dup, dup])
+
+
+def test_previous_month_crosses_year():
+    assert previous_month(dt.date(2026, 1, 2)) == "2025-12"
+    assert previous_month(dt.date(2026, 10, 2)) == "2026-09"
