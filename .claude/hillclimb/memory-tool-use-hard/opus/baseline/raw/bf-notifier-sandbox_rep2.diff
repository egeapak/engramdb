+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY set to the *sandbox* key from the dev secrets store and
+MAIL_SINK_INBOX_URL set to the sink inbox API endpoint; skipped otherwise.
+
+The sandbox answers 202 but silently drops anything not addressed to the
+@sink.acme.test domain, so we send there and read the message back from the
+sink inbox. The sandbox is capped at 500 messages/day for the whole team:
+this test sends exactly one.
+"""
+import os
+import time
+import uuid
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+pytestmark = pytest.mark.skipif(
+    not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_INBOX_URL")),
+    reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_INBOX_URL",
+)
+
+
+def _fetch_from_sink(message_id):
+    """Poll the sink inbox until the message shows up, or give up."""
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["MAIL_SINK_INBOX_URL"],
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR, "message_id": message_id},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json().get("messages", []):
+            if msg.get("id") == message_id:
+                return msg
+        time.sleep(POLL_INTERVAL_S)
+    return None
+
+
+def test_send_receipt_is_delivered_through_sandbox():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+
+    message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+    assert message_id
+
+    delivered = _fetch_from_sink(message_id)
+    assert delivered is not None, (
+        f"message {message_id} not in sink inbox after {DELIVERY_TIMEOUT_S}s"
+    )
+    assert delivered["to"] == SINK_ADDR
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
