+"""Export the month's finalized invoices as the CSV Finance imports."""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+# Finance's import tool runs with a German locale: semicolon-delimited, DD.MM.YYYY dates.
+DELIMITER = ";"
+DATE_FORMAT = "%d.%m.%Y"
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# finalized_at is stored as naive UTC; drafts have no finalized_at.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month():
+    today = datetime.now(timezone.utc)
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def month_window(month):
+    # Naive datetimes compared against naive-UTC finalized_at; independent of the host zone.
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_invoices(start, end):
+    import psycopg
+
+    with psycopg.connect(os.environ["DATABASE_URL"]) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(rows, fh):
+    writer = csv.writer(fh, delimiter=DELIMITER)
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            subtotal_cents,
+            tax_cents,
+            subtotal_cents + tax_cents,
+            finalized_at.strftime(DATE_FORMAT),
+        ])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=previous_month(), help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out-dir", default="exports", help="local directory for exports/<YYYY-MM>/invoices.csv")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    if not os.environ.get("DATABASE_URL"):
+        print("no DATABASE_URL set", file=sys.stderr)
+        return 1
+
+    start, end = month_window(args.month)
+    rows = fetch_invoices(start, end)
+    path = Path(args.out_dir) / args.month / "invoices.csv"
+    if args.dry_run:
+        print(f"dry run: would write {len(rows)} invoices for {args.month} ({args.env}) to {path}; bucket {bucket}")
+        return 0
+
+    path.parent.mkdir(parents=True, exist_ok=True)
+    # UTF-8 without BOM; newline="" lets the csv module control line endings.
+    with open(path, "w", encoding="utf-8", newline="") as fh:
+        write_csv(rows, fh)
+    print(f"wrote {len(rows)} invoices for {args.month} ({args.env}) to {path}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
