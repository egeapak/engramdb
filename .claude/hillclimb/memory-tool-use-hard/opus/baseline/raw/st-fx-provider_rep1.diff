 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed at ECB_FEED_URL. The feed is
+    EUR-based (units per 1 EUR), so each rate is divided by the USD rate to get
+    units per 1 USD. The ECB publishes no rates on weekends and TARGET holidays;
+    for those days the most recent earlier publication is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    wanted = day.isoformat() if hasattr(day, "isoformat") else str(day)
+    by_day = {
+        cube.get("time"): cube
+        for cube in root.iterfind(".//{*}Cube")
+        if cube.get("time") and cube.get("time") <= wanted
+    }
+    if not by_day:
+        raise LookupError(f"ECB feed has no rates on or before {wanted}")
+    cube = by_day[max(by_day)]
+
+    per_eur = {c.get("currency"): Decimal(c.get("rate")) for c in cube.iterfind("{*}Cube") if c.get("currency")}
+    usd = per_eur.pop("USD")
+    rates = {code: rate / usd for code, rate in per_eur.items()}
+    rates["EUR"] = Decimal(1) / usd
+    return rates
 
 
