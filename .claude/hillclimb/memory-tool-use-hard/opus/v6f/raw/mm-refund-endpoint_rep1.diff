@@ -0,0 +1,54 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status_code)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Missing X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    if not isinstance(amount, dict) or amount.get("ccy", "USD") != "USD":
+        return problem(400, "Invalid amount", 'Expected {"amount": {"minor": <int>, "ccy": "USD"}}.')
+    amount_cents = amount.get("minor")
+    if type(amount_cents) is not int or amount_cents <= 0:
+        return problem(400, "Invalid amount", "amount.minor must be a positive integer.")
+
+    try:
+        result = refund(invoice, amount_cents, actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund not allowed", str(exc))
+
+    resp_body = {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    status_code = 201 if result["status"] == "issued" else 202
+    _RESPONSES[key] = (time.time(), resp_body, status_code)
+    return jsonify(resp_body), status_code
