+"""Sends a real receipt through the email provider sandbox.
+
+Needs the sandbox key from the dev secrets store exported as MAIL_API_KEY and
+the sink inbox API base URL as MAIL_SINK_URL. The sandbox drops (202, never
+delivers) anything not addressed to @sink.acme.test, so the recipient must be
+on that domain. Keep this to one message: the sandbox is rate-limited to
+2 msg/s and 500 msg/day for the whole team.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_URL",
+    ),
+]
+
+
+def _fetch_sink_messages(to_addr):
+    resp = requests.get(
+        f"{os.environ['MAIL_SINK_URL'].rstrip('/')}/messages",
+        headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+        params={"to": to_addr},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    return resp.json()
+
+
+def _wait_for_message(message_id, to_addr):
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        for msg in _fetch_sink_messages(to_addr):
+            if msg.get("id") == message_id:
+                return msg
+        time.sleep(POLL_INTERVAL_S)
+    pytest.fail(f"message {message_id} not delivered to {to_addr} within {DELIVERY_TIMEOUT_S}s")
+
+
+def test_send_receipt_is_delivered_to_sink():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() has no implementation yet; stub only the template step so the
+    # provider call itself is real.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_message(message_id, SINK_ADDR)
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
