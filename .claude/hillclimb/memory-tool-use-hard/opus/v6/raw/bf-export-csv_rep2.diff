+"""Export one month's finalized invoices as the CSV Finance imports.
+
+The Finance import tool runs with a German locale: semicolon-delimited,
+dates as DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from src.billing.periods import month_window  # noqa: E402
+
+ROOT = Path(__file__).resolve().parent.parent
+HEADER = ("invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date")
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+    "WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s "
+    "ORDER BY finalized_at, id"
+)
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def fetch_invoices(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    """Rows are (id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    seen = set()
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\r\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        if invoice_id in seen:
+            raise ValueError(f"invoice {invoice_id} appears twice in the export")
+        seen.add(invoice_id)
+        subtotal, tax = int(subtotal), int(tax)
+        writer.writerow((invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")))
+    return buf.getvalue()
 
 
 def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=previous_month(date.today()), help="YYYY-MM (default: last month)")
+    parser.add_argument("--out-dir", type=Path, default=ROOT / "var",
+                        help="directory the exports/<YYYY-MM>/invoices.csv tree is written under")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+    start, end = month_window(args.month)
+    rows = fetch_invoices(database_url, start, end)
+    body = render_csv(rows)
+    key = f"exports/{args.month}/invoices.csv"
+    if args.dry_run:
+        print(f"[dry-run] {args.env}: {len(rows)} finalized invoices for {args.month} -> {bucket}/{key} (nothing written)")
+        return 0
+    path = args.out_dir / key
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(body.encode("utf-8"))
+    print(f"{args.env}: wrote {len(rows)} finalized invoices for {args.month} to {path} (bucket key {bucket}/{key})")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
