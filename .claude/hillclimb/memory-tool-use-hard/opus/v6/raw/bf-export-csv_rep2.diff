@@ -0,0 +1,28 @@
+from datetime import date, datetime
+
+import pytest
+
+from scripts.export import previous_month, render_csv
+
+
+def test_render_csv_uses_finance_import_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    assert render_csv(rows) == (
+        "invoice_id;customer_id;subtotal_cents;tax_cents;total_cents;finalized_date\r\n"
+        "inv_1;cus_1;10000;1900;11900;03.09.2026\r\n"
+        "inv_2;cus_2;0;0;0;30.09.2026\r\n"
+    )
+
+
+def test_render_csv_rejects_duplicate_invoices():
+    row = ("inv_1", "cus_1", 100, 0, datetime(2026, 9, 1))
+    with pytest.raises(ValueError):
+        render_csv([row, row])
+
+
+def test_previous_month_wraps_the_year():
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
