+"""Export one month's finalized invoices as the CSV Finance imports into their accounting tool.
+
+The Finance import tool runs with a German locale: semicolon-delimited, dates as
+DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM. Drafts (no finalized_at)
+are excluded; zero-amount invoices are included.
+"""
 import argparse
+import csv
 import os
+import sqlite3
+import sys
+from datetime import date
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from src.billing.periods import month_window  # noqa: E402
+
+ROOT = Path(__file__).resolve().parent.parent
+DEV_DB = ROOT / "var" / "dev.sqlite3"
+HEADER = ("invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date")
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+    "WHERE finalized_at IS NOT NULL AND finalized_at >= {p} AND finalized_at < {p} "
+    "ORDER BY finalized_at, id"
+)
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def fetch_invoices(start, end):
+    url = os.environ.get("DATABASE_URL")
+    if url:
+        import psycopg
+
+        with psycopg.connect(url) as conn:
+            return conn.execute(QUERY.format(p="%s"), (start, end)).fetchall()
+    conn = sqlite3.connect(DEV_DB, detect_types=sqlite3.PARSE_DECLTYPES)
+    try:
+        return conn.execute(QUERY.format(p="?"), (start, end)).fetchall()
+    finally:
+        conn.close()
+
+
+def to_rows(invoices):
+    rows = []
+    for invoice_id, customer_id, subtotal, tax, finalized_at in invoices:
+        if isinstance(finalized_at, str):
+            finalized_at = date.fromisoformat(finalized_at[:10])
+        subtotal, tax = int(subtotal), int(tax or 0)
+        rows.append((invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")))
+    return rows
+
+
+def write_csv(path, rows):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\r\n")
+        writer.writerow(HEADER)
+        writer.writerows(rows)
 
 
 def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+    parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month)")
+    parser.add_argument("--out", type=Path, help="output file (default: var/exports/<YYYY-MM>/invoices.csv)")
+    parser.add_argument("--dry-run", action="store_true", help="query and summarize, write nothing")
     args = parser.parse_args()
+    month = args.month or previous_month(date.today())
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    out = args.out or ROOT / "var" / key
+
+    rows = to_rows(fetch_invoices(start, end))
+    total = sum(row[4] for row in rows)
+    summary = f"{len(rows)} finalized invoices for {month}, total {total} cents"
