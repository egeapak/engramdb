+# The ECB euro reference feed (eurofxref XML); no API key needed.
+ECB_FEED_URL = os.environ.get("ECB_FEED_URL")
+_ECB_NS = "{http://www.ecb.int/vocabulary/2002-08-01/eurofxref}"
