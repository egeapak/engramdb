 def fetch_rates(day):
     """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    if not ECB_FEED_URL:
+        raise RuntimeError("ECB_FEED_URL is not set")
+    resp = requests.get(ECB_FEED_URL, timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    day = str(day)
+    for cube in root.iter(f"{_ECB_NS}Cube"):
+        if cube.get("time") == day:
+            break
+    else:
+        raise LookupError(f"no ECB reference rates for {day}")
+
+    # The feed quotes 1 EUR in each currency; cross through USD to rebase.
+    eur_rates = {c.get("currency"): Decimal(c.get("rate")) for c in cube.findall(f"{_ECB_NS}Cube")}
+    try:
+        eur_usd = eur_rates.pop("USD")
+    except KeyError:
+        raise LookupError(f"ECB feed has no USD rate for {day}") from None
+    rates = {code: rate / eur_usd for code, rate in eur_rates.items()}
+    rates["EUR"] = 1 / eur_usd
+    return rates
 
 
