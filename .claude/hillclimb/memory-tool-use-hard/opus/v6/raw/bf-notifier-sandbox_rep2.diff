+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The sandbox answers 202 but silently drops anything not addressed to the
+# sink domain, so delivery can only be asserted for @sink.acme.test recipients.
+SINK_ADDR = "receipts@sink.acme.test"
+SINK_INBOX_URL = os.environ.get("MAIL_SINK_INBOX_URL")
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not os.environ.get("MAIL_API_KEY") or not SINK_INBOX_URL,
+        reason="needs MAIL_API_KEY (sandbox key) and MAIL_SINK_INBOX_URL",
+    ),
+]
+
+
+def _wait_for_message(message_id, timeout=30, interval=1.0):
+    # Poll gently: the sandbox is rate-limited and shared by the whole team.
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            SINK_INBOX_URL,
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json().get("messages", []):
+            if msg.get("id") == message_id:
+                return msg
+        time.sleep(interval)
+    return None
+
+
+def test_send_receipt_is_delivered_by_sandbox():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # Templates are compiled at build time; stub rendering so this test only
+    # exercises the real provider round trip.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_message(message_id)
+    assert delivered is not None, f"message {message_id} never reached the sink inbox"
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
