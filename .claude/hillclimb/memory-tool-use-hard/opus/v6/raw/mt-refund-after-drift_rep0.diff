diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..560c204
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,76 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this need a second approver in the admin tool (Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}
+_IDEMPOTENCY = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    cached = _IDEMPOTENCY.get(key)
+    if cached and time.time() - cached[0] < IDEMPOTENCY_TTL_SECONDS:
+        body, status = cached[1]
+        return jsonify(body), status
+
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice {invoice_id}.")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return errors.problem(400, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<ISO 4217>"}.')
+    amount_cents = amount.get("minor")
+    if type(amount_cents) is not int or amount_cents <= 0:
+        return errors.problem(400, "Invalid amount", "amount.minor must be a positive integer.")
+    if amount.get("ccy") != invoice.currency:
+        return errors.problem(400, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    already_refunded = sum(r["amount_cents"] for r in _REFUNDS.values() if r["invoice_id"] == invoice.id)
+    try:
+        refund(invoice, already_refunded + amount_cents)
+    except ValueError as exc:
+        return errors.problem(422, "Refund not allowed", str(exc))
+
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    refund_id = str(uuid.uuid4())
+    _REFUNDS[refund_id] = {"invoice_id": invoice.id, "amount_cents": amount_cents, "status": status}
+
+    if status == "issued":
+        log.info("ledger.refund_issued", refund_id=refund_id, invoice_id=invoice.id,
+                 customer_id=invoice.customer_id, amount_cents=amount_cents, actor_id=actor_id)
+    else:
+        log.info("refund_pending_approval", refund_id=refund_id, invoice_id=invoice.id,
+                 customer_id=invoice.customer_id, amount_cents=amount_cents, actor_id=actor_id)
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice.id,
+        "amount": {"minor": amount_cents, "ccy": invoice.currency},
+        "status": status,
+    }
+    _IDEMPOTENCY[key] = (time.time(), (body, 201))
+    return jsonify(body), 201
