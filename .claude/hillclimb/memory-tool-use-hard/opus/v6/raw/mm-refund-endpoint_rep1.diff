+++ b/tests/test_refunds_api.py
@@ -0,0 +1,70 @@
+import pytest
+from flask import Flask
+
+from src.api import invoices, refunds
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds.bp)
+    invoices._INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    refunds._RESPONSES.clear()
+    yield app.test_client()
+    invoices._INVOICES.clear()
+
+
+def post(client, amount, key="k1", actor="usr_1", invoice_id="inv_1"):
+    headers = {}
+    if key:
+        headers["X-Acme-Idempotency"] = key
+    if actor:
+        headers["X-Acme-Actor"] = actor
+    return client.post(f"/invoices/{invoice_id}/refunds", json={"amount": amount}, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, {"minor": 1_000, "ccy": "USD"})
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "refunded": {"minor": 1_000, "ccy": "USD"}, "status": "issued"}
+
+
+def test_refund_at_threshold_is_issued(client):
+    assert post(client, {"minor": 50_000}).get_json()["status"] == "issued"
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, {"minor": 50_001})
+    assert resp.status_code == 202
+    assert resp.get_json()["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key_is_428(client):
+    resp = post(client, {"minor": 1_000}, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_response(client):
+    first = post(client, {"minor": 1_000})
+    second = post(client, {"minor": 2_000})
+    assert second.status_code == first.status_code
+    assert second.get_json() == first.get_json()
+
+
+def test_missing_actor_is_400(client):
+    assert post(client, {"minor": 1_000}, actor=None).status_code == 400
+
+
+def test_unknown_invoice_is_404(client):
+    assert post(client, {"minor": 1_000}, invoice_id="nope").status_code == 404
+
+
+@pytest.mark.parametrize("amount", [None, 1000, {"minor": 10.5}, {"minor": 0}, {"minor": True}, {"minor": 1, "ccy": "EUR"}])
+def test_invalid_amount_is_422(client, amount):
+    assert post(client, amount).status_code == 422
+
+
+def test_refund_over_total_is_422(client):
+    assert post(client, {"minor": 100_001}).status_code == 422
