+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.money import Money
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor")
+    if not actor_id:
+        return problem(400, "Actor required", "Send an X-Acme-Actor header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    minor = amount.get("minor") if isinstance(amount, dict) else None
+    if type(minor) is not int or minor <= 0:
+        return problem(422, "Invalid amount", 'amount must be {"minor": <positive integer>, "ccy": "USD"}.')
+    money = Money(minor)
+    if amount.get("ccy", money.currency) != money.currency:
+        return problem(422, "Invalid amount", f"amount.ccy must be {money.currency}.")
+
+    try:
+        result = refund(invoice, money.cents)
+    except ValueError as exc:
+        return problem(422, "Refund not allowed", str(exc))
+
+    event = "ledger.refund_issued" if result["status"] == "issued" else "ledger.refund_requested"
+    log.info(
+        event,
+        invoice_id=invoice.id,
+        customer_id=invoice.customer_id,
+        refunded_cents=result["refunded_cents"],
+        status=result["status"],
+        actor_id=actor_id,
+    )
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": money.currency},
+        "status": result["status"],
+    }
+    status_code = 201 if result["status"] == "issued" else 202
+    _RESPONSES[key] = (time.time(), body, status_code)
+    return jsonify(body), status_code
