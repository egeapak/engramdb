+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Reject events whose Psp-Signature-Timestamp is further than this from now (replay protection).
+MAX_SIGNATURE_AGE_SECONDS = 120
+
+
+def _signature_is_valid(body, signature, timestamp):
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret or not signature or not timestamp:
+        return False
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return False
+    if abs(time.time() - sent_at) > MAX_SIGNATURE_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, signature)
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    # Verify against the raw bytes before parsing anything.
