@@ -0,0 +1,61 @@
+import hashlib
+import hmac
+import json
+import time
+
+import pytest
+from flask import Flask
+
+from src.api import webhooks
+
+SECRET = "whsec_test"
+
+
+@pytest.fixture
+def client(monkeypatch):
+    monkeypatch.setenv("PSP_WEBHOOK_SECRET", SECRET)
+    app = Flask(__name__)
+    app.register_blueprint(webhooks.bp)
+    return app.test_client()
+
+
+def _post(client, body, secret=SECRET, timestamp=None, signature=None):
+    raw = json.dumps(body).encode()
+    if signature is None:
+        signature = hmac.new(secret.encode(), raw, hashlib.sha256).hexdigest()
+    headers = {
+        "Psp-Signature": signature,
+        "Psp-Signature-Timestamp": str(int(time.time()) if timestamp is None else timestamp),
+        "Content-Type": "application/json",
+    }
+    return client.post("/webhooks/psp", data=raw, headers=headers)
+
+
+def test_valid_signature_is_accepted(client):
+    assert _post(client, {"type": "charge.succeeded"}).status_code == 204
+
+
+def test_wrong_secret_is_rejected(client):
+    resp = _post(client, {"type": "charge.succeeded"}, secret="other")
+    assert resp.status_code == 401
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_missing_headers_are_rejected(client):
+    resp = client.post("/webhooks/psp", json={"type": "charge.succeeded"})
+    assert resp.status_code == 401
+
+
+def test_stale_timestamp_is_rejected(client):
+    resp = _post(client, {"type": "charge.succeeded"}, timestamp=int(time.time()) - 121)
+    assert resp.status_code == 401
+
+
+def test_malformed_timestamp_is_rejected(client):
+    resp = _post(client, {"type": "charge.succeeded"}, timestamp="yesterday")
+    assert resp.status_code == 401
+
+
+def test_unset_secret_rejects_everything(client, monkeypatch):
+    monkeypatch.delenv("PSP_WEBHOOK_SECRET")
+    assert _post(client, {"type": "charge.succeeded"}).status_code == 401
