diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..99804a1
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,73 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}  # invoice_id -> list of refund dicts
+_IDEMPOTENCY = {}  # key -> (stored_at, invoice_id, body, status_code)
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    stored = _IDEMPOTENCY.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, stored_invoice_id, body, status_code = stored
+        if stored_invoice_id != invoice_id:
+            return errors.problem(422, "Idempotency key reused", "This key was already used for another invoice.")
+        return jsonify(body), status_code
+
+    # TODO: take the actor from the authenticated principal once the API has auth.
+    actor_id = request.headers.get("X-Acme-Actor")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send the X-Acme-Actor header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return errors.problem(422, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "<ISO 4217>"}.')
+    minor, ccy = amount.get("minor"), amount.get("ccy")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return errors.problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if ccy != invoice.currency:
+        return errors.problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    previous = _REFUNDS.setdefault(invoice_id, [])
+    try:
+        result = refund(invoice, minor, already_refunded_cents=sum(r["refunded_cents"] for r in previous))
+    except ValueError as exc:
+        return errors.problem(422, "Refund not allowed", str(exc))
+
+    refund_id = str(uuid.uuid4())
+    previous.append({"id": refund_id, **result})
+
+    event = "ledger.refund_issued" if result["status"] == "issued" else "ledger.refund_requested"
+    log.info(event, actor_id=actor_id, invoice_id=invoice_id, refund_id=refund_id, amount_cents=minor)
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice_id,
+        "amount": {"minor": minor, "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    _IDEMPOTENCY[key] = (time.time(), invoice_id, body, 201)
+    return jsonify(body), 201
