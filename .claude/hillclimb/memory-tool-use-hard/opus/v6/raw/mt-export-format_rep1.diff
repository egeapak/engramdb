+"""Export a month's finalized invoices as the CSV Finance imports.
+
+Finance's accounting tool expects plain comma-separated values, ISO dates
+(YYYY-MM-DD), amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import date
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+from src.billing.periods import month_window  # noqa: E402
+
+HEADER = ("invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date")
+
+# Drafts have no finalized_at; zero-amount invoices are included on purpose.
+QUERY = """
+SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+FROM invoices
+WHERE finalized_at >= %s AND finalized_at < %s
+ORDER BY finalized_at, id
+"""
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def fetch_finalized(database_url, month):
+    import psycopg
+
+    start, end = month_window(month)
+    # Deployed environments go through a transaction-mode pooler: no prepared statements.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(rows, out):
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow((invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.date().isoformat()))
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month)")
+    parser.add_argument("--output", type=Path, help="directory to write exports/<YYYY-MM>/invoices.csv under (default: var/)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV to stdout instead of writing it")
     args = parser.parse_args()
+    month = args.month or previous_month(date.today())
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    database_url = os.environ.get("DATABASE_URL", "postgresql://ledgerline:ledgerline@localhost/ledgerline")
+
+    rows = fetch_finalized(database_url, month)
+    key = f"exports/{month}/invoices.csv"
+    print(f"exporting {len(rows)} invoices for {month} ({args.env}) to {bucket}/{key} (dry_run={args.dry_run})", file=sys.stderr)
+    if args.dry_run:
+        write_csv(rows, sys.stdout)
+        return
+    path = (args.output or ROOT / "var") / key
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        write_csv(rows, f)
+    print(f"wrote {path}", file=sys.stderr)
 
 
 if __name__ == "__main__":
