+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The sandbox answers 202 but silently drops anything not addressed to the
+# sink domain, so delivery can only be asserted for @sink.acme.test recipients.
+SINK_ADDR = "receipts@sink.acme.test"
+SINK_INBOX_URL = os.environ.get("MAIL_SINK_INBOX_URL")
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not os.environ.get("MAIL_API_KEY") or not SINK_INBOX_URL,
+        reason="needs MAIL_API_KEY (sandbox key) and MAIL_SINK_INBOX_URL",
+    ),
+]
+
+
+def _wait_for_message(invoice_id, timeout=60, interval=2):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            SINK_INBOX_URL,
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json()["messages"]:
+            if invoice_id in msg.get("html", ""):
+                return msg
+        time.sleep(interval)
+    return None
+
+
+def test_send_receipt_is_delivered_to_sink():
+    # A unique invoice id lets us find our message in the team-shared sink inbox.
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+
+    # render() has no implementation yet; stub it so the provider path is real.
+    with mock.patch.object(
+        email, "render", return_value=f"<p>Receipt for {invoice_id}</p>"
+    ):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    msg = _wait_for_message(invoice_id)
+    assert msg is not None, f"message {message_id} not delivered to the sink"
+    assert msg["subject"] == "Your receipt"
