@@ -0,0 +1,27 @@
+import io
+from datetime import date, datetime
+
+from scripts.export import export_path, previous_month, write_csv
+
+
+def test_write_csv_uses_finance_import_format():
+    rows = [
+        ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    out = io.StringIO()
+    write_csv(rows, out)
+    assert out.getvalue() == (
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\n"
+        "inv_1,cus_1,1000,190,1190,2026-09-03\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\n"
+    )
+
+
+def test_previous_month_wraps_the_year():
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
+
+
+def test_export_path():
+    assert export_path("2026-09") == "exports/2026-09/invoices.csv"
