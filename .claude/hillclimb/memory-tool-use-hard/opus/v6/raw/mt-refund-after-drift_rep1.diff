+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _serialize(refund_record, currency):
+    return {
+        "id": refund_record["id"],
+        "invoice_id": refund_record["invoice_id"],
+        "amount": {"minor": refund_record["refunded_cents"], "ccy": currency},
+        "status": refund_record["status"],
+    }
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    cached = _IDEMPOTENT_RESPONSES.get(key)
+    if cached and time.time() - cached[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(cached[1]), cached[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found", f"No invoice with id {invoice_id}.")
+
+    body = request.get_json(silent=True) or {}
+    actor_id = body.get("actor_id")
+    amount = body.get("amount") or {}
+    amount_cents = amount.get("minor")
+    if not actor_id:
+        return errors.problem(400, "Invalid refund", "actor_id is required.")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool):
+        return errors.problem(400, "Invalid refund", "amount.minor must be an integer.")
+    if amount.get("ccy", invoice.currency) != invoice.currency:
+        return errors.problem(400, "Invalid refund", f"Invoice is in {invoice.currency}.")
+
+    already_refunded = sum(r["refunded_cents"] for r in _REFUNDS.values() if r["invoice_id"] == invoice.id)
+    try:
+        record = refund(invoice, amount_cents, already_refunded)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    record["id"] = str(uuid.uuid4())
+    _REFUNDS[record["id"]] = record
+    event = "ledger.refund_issued" if record["status"] == "issued" else "ledger.refund_requested"
+    log.info(
+        event,
+        refund_id=record["id"],
+        invoice_id=invoice.id,
+        customer_id=invoice.customer_id,
+        refunded_cents=amount_cents,
+        actor_id=actor_id,
+    )
+
+    response = _serialize(record, invoice.currency)
+    status = 201 if record["status"] == "issued" else 202
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), response, status)
+    return jsonify(response), status
