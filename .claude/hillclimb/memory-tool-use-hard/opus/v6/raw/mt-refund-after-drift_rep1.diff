+APPROVAL_THRESHOLD_CENTS = 50_000
 
-def refund(invoice: Invoice, amount_cents: int):
-    if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+
+def refund(invoice: Invoice, amount_cents: int, already_refunded_cents: int = 0):
+    if amount_cents <= 0:
+        raise ValueError("refund must be positive")
+    if already_refunded_cents + amount_cents > invoice.subtotal_cents + invoice.tax_cents:
         raise ValueError("refund exceeds invoice total")
-    return {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    return {"invoice_id": invoice.id, "refunded_cents": amount_cents, "status": status}
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..4805288
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,60 @@
+import pytest
+from flask import Flask
+
+from src.api import refunds as refunds_api
+from src.api.invoices import _INVOICES
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    _INVOICES.clear()
+    refunds_api._REFUNDS.clear()
+    refunds_api._IDEMPOTENT_RESPONSES.clear()
+    _INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    app = Flask(__name__)
+    app.register_blueprint(refunds_api.bp)
+    return app.test_client()
+
+
+def post(client, key, minor, invoice_id="inv_1"):
+    headers = {"X-Acme-Idempotency": key} if key else {}
+    return client.post(
+        f"/invoices/{invoice_id}/refunds",
+        json={"actor_id": "usr_1", "amount": {"minor": minor, "ccy": "USD"}},
+        headers=headers,
+    )
+
+
+def test_missing_idempotency_key_is_428(client):
+    assert post(client, None, 100).status_code == 428
+
+
+def test_small_refund_is_issued(client):
+    resp = post(client, "k1", 50_000)
+    assert resp.status_code == 201
+    assert resp.get_json()["status"] == "issued"
+    assert resp.get_json()["amount"] == {"minor": 50_000, "ccy": "USD"}
+
+
+def test_large_refund_needs_approval(client):
+    resp = post(client, "k1", 50_001)
+    assert resp.status_code == 202
+    assert resp.get_json()["status"] == "pending_approval"
+
+
+def test_same_key_replays_response(client):
+    first = post(client, "k1", 100)
+    second = post(client, "k1", 100)
+    assert second.get_json() == first.get_json()
+    assert len(refunds_api._REFUNDS) == 1
+
+
+def test_cumulative_refunds_cannot_exceed_total(client):
+    assert post(client, "k1", 40_000).status_code == 201
+    assert post(client, "k2", 40_000).status_code == 201
+    assert post(client, "k3", 40_000).status_code == 422
+
+
+def test_unknown_invoice_is_404(client):
+    assert post(client, "k1", 100, invoice_id="nope").status_code == 404
