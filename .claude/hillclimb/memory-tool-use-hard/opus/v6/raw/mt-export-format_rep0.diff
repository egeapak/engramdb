@@ -0,0 +1,24 @@
+import importlib.util
+from datetime import date, datetime
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location("export", Path(__file__).resolve().parent.parent / "scripts" / "export.py")
+export = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(export)
+
+
+def test_render_csv_uses_finance_format():
+    rows = [
+        ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    assert export.render_csv(rows) == (
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\n"
+        "inv_1,cus_1,1000,190,1190,2026-09-03\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\n"
+    )
+
+
+def test_previous_month():
+    assert export.previous_month(date(2026, 10, 2)) == "2026-09"
+    assert export.previous_month(date(2026, 1, 2)) == "2025-12"
