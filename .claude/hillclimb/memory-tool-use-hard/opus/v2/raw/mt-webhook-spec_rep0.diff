+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api.errors import problem
+
 bp = Blueprint("webhooks", __name__)
 
+# Reject events whose timestamp is further than this from now (replay protection).
+PSP_TIMESTAMP_TOLERANCE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return a problem response if the PSP webhook fails verification, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        # Fail closed: never accept webhooks when we cannot verify them.
+        return problem(500, "Webhook verification unavailable", "PSP webhook secret is not configured.")
+
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not signature or not timestamp:
+        return problem(401, "Invalid webhook signature", "Missing Psp-Signature or Psp-Signature-Timestamp header.")
+
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return problem(401, "Invalid webhook signature", "Malformed Psp-Signature-Timestamp header.")
+    if abs(time.time() - sent_at) > PSP_TIMESTAMP_TOLERANCE_SECONDS:
+        return problem(401, "Invalid webhook signature", "Psp-Signature-Timestamp is outside the allowed window.")
+
+    expected = hmac.new(secret.encode(), request.get_data(), hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return problem(401, "Invalid webhook signature", "Signature does not match.")
+
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure is not None:
+        return failure
+
