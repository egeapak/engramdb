@@ -0,0 +1,31 @@
+from datetime import date, datetime
+
+import pytest
+
+from scripts.export import month_window, previous_month, render_csv
+
+
+def test_render_csv_matches_finance_import_format():
+    rows = [
+        ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 1, 0, 0, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    data = render_csv(rows)
+    assert not data.startswith(b"\xef\xbb\xbf")
+    assert data.decode("utf-8").splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,1000,190,1190,2026-09-01",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_render_csv_rejects_duplicate_invoices():
+    row = ("inv_1", "cus_1", 1000, 0, datetime(2026, 9, 1))
+    with pytest.raises(ValueError):
+        render_csv([row, row])
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2026, 1, 2)) == "2025-12"
