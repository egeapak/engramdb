+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY set to the *sandbox* key from the dev secrets store and
+MAIL_SINK_URL set to the sink inbox API base URL. Skipped otherwise.
+
+The sandbox answers 202 for every recipient but only delivers to addresses on
+@sink.acme.test, so a 202 alone proves nothing: we read the message back from
+the sink inbox. The sandbox is limited to 2 msg/s and 500 msg/day for the whole
+team, so keep this to a single send.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_DOMAIN = "sink.acme.test"
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_URL",
+    ),
+]
+
+
+def _wait_for_sink_message(to_addr):
+    """Poll the sink inbox until a message for to_addr arrives, or fail."""
+    url = f"{os.environ['MAIL_SINK_URL'].rstrip('/')}/messages"
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            url,
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": to_addr},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        messages = [m for m in resp.json() if m["to"] == to_addr]
+        if messages:
+            return messages[0]
+        time.sleep(POLL_INTERVAL_S)
+    pytest.fail(f"no message for {to_addr} in the sink after {DELIVERY_TIMEOUT_S}s")
+
+
+def test_send_receipt_is_delivered():
+    # Unique recipient per run so we never match a message from an earlier run.
+    to_addr = f"receipts-{uuid.uuid4().hex}@{SINK_DOMAIN}"
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:8]}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() is not implemented yet; stub it so this test exercises the real
+    # provider path. Drop the patch once templates land.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, to_addr, 1200)
+
+    assert message_id
+
+    delivered = _wait_for_sink_message(to_addr)
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
