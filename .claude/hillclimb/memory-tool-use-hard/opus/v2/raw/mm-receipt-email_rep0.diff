diff --git a/tests/test_invoices.py b/tests/test_invoices.py
new file mode 100644
index 0000000..e598dc5
--- /dev/null
+++ b/tests/test_invoices.py
@@ -0,0 +1,29 @@
+from unittest import mock
+
+from src.billing import invoices
+
+
+def _finalized(invoice):
+    invoice.ledger_ref = "led_1"
+    return invoice
+
+
+def test_finalize_once_enqueues_receipt():
+    inv = invoices.Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, tax_cents=200)
+    with mock.patch.object(invoices, "finalize", side_effect=_finalized), \
+            mock.patch.object(invoices.queue, "enqueue") as enqueue:
+        invoices.finalize_once(inv)
+    enqueue.assert_called_once_with(
+        "invoices.send_receipt",
+        {"invoice_id": "inv_1", "customer_id": "cus_1"},
+        dedupe_key="receipt:inv_1",
+    )
+
+
+def test_finalize_once_skips_receipt_when_already_finalized():
+    inv = invoices.Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000, ledger_ref="led_1")
+    with mock.patch.object(invoices, "finalize") as finalize, \
+            mock.patch.object(invoices.queue, "enqueue") as enqueue:
+        invoices.finalize_once(inv)
+    finalize.assert_not_called()
+    enqueue.assert_not_called()
