+
+def _handle_payment_failed(event):
+    data = event.get("data") or {}
+    invoice_id = data.get("invoice_id")
+    charge_id = data.get("charge_id")
+    if not invoice_id or not charge_id:
+        return errors.problem(400, "Malformed event", "payment.failed needs data.invoice_id and data.charge_id")
+
+    # The PSP redelivers webhooks; keying on the failed charge drops the duplicates.
+    queue.enqueue(
