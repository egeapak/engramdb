index 0000000..ae4f68e
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,65 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing import refunds
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, status, body)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    now = time.time()
+    stored = _RESPONSES.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, status, body = stored
+        return _render(status, body)
+
+    status, body = _create_refund(invoice_id)
+    _RESPONSES[(invoice_id, key)] = (now, status, body)
+    return _render(status, body)
+
+
+def _create_refund(invoice_id):
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return 404, {"title": "Invoice not found"}
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount_cents")
+    actor_id = payload.get("actor_id")
+    if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+        return 422, {"title": "Invalid refund amount", "detail": "amount_cents must be a positive integer."}
+    if not actor_id:
+        return 422, {"title": "Missing actor", "detail": "actor_id is required."}
+
+    try:
+        result = refunds.refund(invoice, amount, actor_id=actor_id)
+    except ValueError as exc:
+        return 422, {"title": "Invalid refund amount", "detail": str(exc)}
+
+    return 201, {
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+
+
+def _render(status, body):
+    if status >= 400:
+        return problem(status, body["title"], body.get("detail"))
+    resp = jsonify(body)
+    resp.status_code = status
+    return resp
