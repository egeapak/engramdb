@@ -0,0 +1,28 @@
+import unittest
+from datetime import datetime, timezone
+
+from scripts.export import month_window, previous_month, render_csv
+
+
+class ExportCsvTest(unittest.TestCase):
+    def test_finance_format(self):
+        body = render_csv([
+            ("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 23, 30)),
+            ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 0, 5)),
+        ])
+        self.assertEqual(body,
+                         "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\r\n"
+                         "inv_1,cus_1,1000,190,1190,2026-09-03\r\n"
+                         "inv_2,cus_2,0,0,0,2026-09-30\r\n")
+        self.assertFalse(body.startswith("\ufeff"))
+
+    def test_month_window_wraps_year(self):
+        self.assertEqual(month_window("2026-12"), (datetime(2026, 12, 1), datetime(2027, 1, 1)))
+
+    def test_previous_month(self):
+        self.assertEqual(f"{previous_month(datetime(2026, 1, 2, tzinfo=timezone.utc)):%Y-%m}", "2025-12")
+        self.assertEqual(f"{previous_month(datetime(2026, 10, 2, tzinfo=timezone.utc)):%Y-%m}", "2026-09")
+
+
+if __name__ == "__main__":
+    unittest.main()
