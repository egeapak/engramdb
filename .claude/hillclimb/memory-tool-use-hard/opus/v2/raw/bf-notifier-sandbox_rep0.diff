+"""Sends one real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (sandbox key from the dev secrets store) and MAIL_SINK_URL
+(the sink inbox API). The sandbox drops every message not addressed to the
+@sink.acme.test domain while still answering 202, so delivery can only be
+checked by reading the message back from the sink. The sandbox allows 500
+messages a day for the whole team: this test sends exactly one.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY and MAIL_SINK_URL for the provider sandbox",
+    ),
+]
+
+
+def _wait_for_message(message_id, timeout=60, interval=2):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["MAIL_SINK_URL"],
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": SINK_ADDR},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json()["messages"]:
+            if msg["id"] == message_id:
+                return msg
+        time.sleep(interval)
+    pytest.fail(f"message {message_id} not delivered to {SINK_ADDR} within {timeout}s")
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() is not implemented yet; stub it so the real provider.send runs.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+    msg = _wait_for_message(message_id)
+    assert msg["subject"] == "Your receipt"
+    assert invoice_id in msg["html"]
