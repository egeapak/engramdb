+"""Delete invoices (and their lines) that are past the retention period.
+
+Dry-run by default: reports what would be purged and writes nothing. Pass
+--execute to actually delete.
+
+    TZ=UTC python scripts/purge_invoices.py                # dry run
+    TZ=UTC python scripts/purge_invoices.py --execute --batch-size 500
+"""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+# Legal defines the period in days (10 years after finalization since the 2026
+# tax audit). Do not derive it from years.
+RETENTION_DAYS = 3650
+MAX_SAFE_BATCH = 500
+
+# Invoices with any refund are never purged: the refunds table has no status
+# column, so an open refund cannot be told apart from a settled one.
+ELIGIBLE = """
+    finalized_at IS NOT NULL
+    AND finalized_at < %(cutoff)s
+    AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = invoices.id)
+"""
+
+
+def retention_cutoff(now=None):
+    """Return the cutoff as naive UTC, matching how finalized_at is stored."""
+    now = now or datetime.now(timezone.utc)
+    return (now - timedelta(days=RETENTION_DAYS)).astimezone(timezone.utc).replace(tzinfo=None)
+
+
+def connect(url):
+    import psycopg
+
+    # Deployed environments go through a transaction-mode pooler, which breaks
+    # server-side prepared statements.
+    return psycopg.connect(url, prepare_threshold=None)
+
+
+def dry_run(conn, cutoff, sample):
+    with conn.transaction():
+        count = conn.execute(f"SELECT count(*) FROM invoices WHERE {ELIGIBLE}", {"cutoff": cutoff}).fetchone()[0]
+        ids = [r[0] for r in conn.execute(
+            f"SELECT id FROM invoices WHERE {ELIGIBLE} ORDER BY finalized_at LIMIT %(n)s",
+            {"cutoff": cutoff, "n": sample},
+        )]
+    print(f"dry run: {count} invoices finalized before {cutoff:%Y-%m-%d %H:%M} UTC would be purged (nothing deleted)")
+    for invoice_id in ids:
+        print(f"  {invoice_id}")
+    if count > len(ids):
+        print(f"  ... and {count - len(ids)} more")
+    return 0
+
+
+def purge(conn, cutoff, batch_size):
+    total = 0
+    while True:
+        # One short transaction per batch. FOR UPDATE blocks refunds from being
+        # created against these invoices while we delete them.
+        with conn.transaction():
+            ids = [r[0] for r in conn.execute(
+                f"SELECT id FROM invoices WHERE {ELIGIBLE} "
+                "ORDER BY finalized_at LIMIT %(n)s FOR UPDATE SKIP LOCKED",
+                {"cutoff": cutoff, "n": batch_size},
+            )]
+            if not ids:
+                break
+            conn.execute("DELETE FROM invoice_lines WHERE invoice_id = ANY(%s)", (ids,))
+            conn.execute("DELETE FROM invoices WHERE id = ANY(%s)", (ids,))
+        total += len(ids)
+        print(f"purged {len(ids)} invoices ({total} so far)")
+    print(f"done: purged {total} invoices finalized before {cutoff:%Y-%m-%d %H:%M} UTC")
+    return 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    parser.add_argument("--sample", type=int, default=20, help="invoice ids to list in a dry run")
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"batch size must be between 1 and {MAX_SAFE_BATCH}", file=sys.stderr)
+        return 3
+
+    cutoff = retention_cutoff()
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print(f"no DATABASE_URL set; would purge invoices finalized before {cutoff:%Y-%m-%d} UTC "
+              f"(retention {RETENTION_DAYS} days, nothing deleted)")
+        return 0
+
+    with connect(url) as conn:
+        if args.execute:
+            return purge(conn, cutoff, args.batch_size)
+        return dry_run(conn, cutoff, args.sample)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
