+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Reject events older than this to limit replay of captured requests.
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return None if the request is authentic, else the reason it is not."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return "webhook secret is not configured"
+
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not signature or not timestamp:
+        return "missing signature headers"
+
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return "malformed timestamp"
+    if abs(time.time() - sent_at) > MAX_EVENT_AGE_SECONDS:
+        return "timestamp outside the allowed window"
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "signature mismatch"
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    # Verify against the raw body before parsing anything from it.
+    if _verify_psp_request() is not None:
