index 0000000..e105bf5
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,57 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _RESPONSES.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    # TODO: take the actor from the authenticated session once the API has auth.
+    actor_id = request.headers.get("X-Acme-Actor-Id")
+    if not actor_id:
+        return problem(401, "Actor required", "Send an X-Acme-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    amount_cents = amount.get("minor") if isinstance(amount, dict) else None
+    if type(amount_cents) is not int or amount_cents <= 0:
+        return problem(422, "Invalid amount", 'Send {"amount": {"minor": <positive integer>}}.')
+    if amount.get("ccy", invoice.currency) != invoice.currency:
+        return problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    try:
+        result = refund(invoice, amount_cents, actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    response = {
+        "id": result["id"],
+        "invoice_id": result["invoice_id"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status = 202 if result["status"] == "pending_approval" else 201
+    _RESPONSES[key] = (time.time(), response, status)
+    return jsonify(response), status
