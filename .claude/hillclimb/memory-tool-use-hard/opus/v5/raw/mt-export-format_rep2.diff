@@ -0,0 +1,43 @@
+import sqlite3
+import unittest
+from datetime import datetime, timezone
+
+from scripts.export import load_invoices, month_window, previous_month, render_csv
+
+
+def _db(rows):
+    conn = sqlite3.connect(":memory:")
+    conn.execute("CREATE TABLE invoices (id TEXT PRIMARY KEY, customer_id TEXT NOT NULL, "
+                 "subtotal_cents BIGINT NOT NULL, tax_cents BIGINT NOT NULL DEFAULT 0, finalized_at TIMESTAMP)")
+    conn.executemany("INSERT INTO invoices VALUES (?, ?, ?, ?, ?)", rows)
+    return conn
+
+
+class ExportTest(unittest.TestCase):
+    def test_selects_finalized_invoices_of_the_month_only(self):
+        conn = _db([
+            ("inv_aug", "cus_1", 100, 19, "2026-08-31 23:59:59"),
+            ("inv_first", "cus_1", 1000, 190, "2026-09-01 00:00:00"),
+            ("inv_zero", "cus_2", 0, 0, "2026-09-15 12:00:00"),
+            ("inv_draft", "cus_2", 500, 95, None),
+            ("inv_oct", "cus_3", 100, 19, "2026-10-01 00:00:00"),
+        ])
+        ids = [r[0] for r in load_invoices(conn, "2026-09")]
+        self.assertEqual(ids, ["inv_first", "inv_zero"])
+
+    def test_finance_format(self):
+        rows = [("inv_1", "cus_1", 1000, 190, "2026-09-01 08:30:00"),
+                ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 0))]
+        self.assertEqual(render_csv(rows),
+                         "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date\r\n"
+                         "inv_1,cus_1,1000,190,1190,2026-09-01\r\n"
+                         "inv_2,cus_2,0,0,0,2026-09-30\r\n")
+
+    def test_month_helpers(self):
+        self.assertEqual(month_window("2026-12"), (datetime(2026, 12, 1), datetime(2027, 1, 1)))
+        self.assertEqual(previous_month(datetime(2026, 10, 2, 6, tzinfo=timezone.utc)), "2026-09")
+        self.assertEqual(previous_month(datetime(2027, 1, 2, 6, tzinfo=timezone.utc)), "2026-12")
+
+
+if __name__ == "__main__":
+    unittest.main()
