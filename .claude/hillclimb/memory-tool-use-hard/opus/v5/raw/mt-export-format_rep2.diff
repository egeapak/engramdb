+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Finance's accounting tool takes plain comma-separated files: dates are ISO
+(YYYY-MM-DD), amounts are integer cents, UTF-8 without a BOM.
+Every finalized invoice of the month appears exactly once (zero-amount ones
+included); drafts have no finalized_at and are never selected.
+"""
 import argparse
+import csv
+import io
 import os
+import sqlite3
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DEV_DB = ROOT / "var" / "dev.sqlite3"
+
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+
+def month_window(month):
+    """[start, end) of a YYYY-MM month as naive UTC, matching invoices.finalized_at.
+
+    Built from the month string alone, so the host zone (Europe/Berlin on the
+    ops host) never shifts the window.
+    """
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    first = now.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def _as_datetime(value):
+    # sqlite hands back strings, psycopg hands back datetimes
+    return value if isinstance(value, datetime) else datetime.fromisoformat(value)
 
 
-def main():
+def load_invoices(conn, month, placeholder="?"):
+    start, end = month_window(month)
+    sql = (
+        "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+        f"WHERE finalized_at >= {placeholder} AND finalized_at < {placeholder} "
+        "ORDER BY finalized_at, id"
+    )
+    if placeholder == "?":
+        params = (start.isoformat(sep=" "), end.isoformat(sep=" "))
+    else:
+        params = (start, end)
+    return conn.execute(sql, params).fetchall()
+
+
+def render_csv(rows):
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\r\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        subtotal, tax = int(subtotal), int(tax)
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax,
+                         _as_datetime(finalized_at).strftime("%Y-%m-%d")])
+    return buf.getvalue()
+
+
+def connect():
+    url = os.environ.get("DATABASE_URL")
+    if url:
+        import psycopg
+        return psycopg.connect(url), "%s"
+    return sqlite3.connect(DEV_DB), "?"
+
+
