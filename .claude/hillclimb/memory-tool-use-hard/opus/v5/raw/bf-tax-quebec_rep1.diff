diff --git a/src/billing/tax.py b/src/billing/tax.py
index 7f21856..ee691e1 100644
--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,14 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    # str() so a float rate like 0.0825 doesn't carry binary noise into Decimal
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    # QST must be shown per line (2025 Revenu Quebec audit), so CA-QC
+    # rounds each line's tax and sums; everyone else is taxed on the subtotal.
+    if region == "CA-QC":
+        return sum(tax_for(line_total([line]), rate) for line in lines)
+    return tax_for(line_total(lines), rate)
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..1388bb1 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -1,5 +1,31 @@
-from src.billing.tax import line_total
+from src.billing.tax import invoice_tax, line_total, tax_for
 
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_rounds_half_even():
+    assert tax_for(50, "0.05") == 2  # 2.5 -> 2
+    assert tax_for(70, "0.05") == 4  # 3.5 -> 4
+
+
+def test_invoice_tax_on_subtotal():
+    lines = [{"quantity": 1, "unit_cents": 10}, {"quantity": 1, "unit_cents": 10}]
+    # 20 * 0.075 = 1.5 -> 2
+    assert invoice_tax(lines, 0.075, "US-TX") == 2
+
+
+def test_invoice_tax_quebec_per_line():
+    lines = [{"quantity": 1, "unit_cents": 10}, {"quantity": 1, "unit_cents": 10}]
+    # each line 0.75 -> 1, summed
+    assert invoice_tax(lines, 0.075, "CA-QC") == 2
+    lines = [{"quantity": 1, "unit_cents": 30}, {"quantity": 1, "unit_cents": 30}]
+    # subtotal would give 60 * 0.05 = 3; per line 1.5 -> 2 each = 4
+    assert invoice_tax(lines, "0.05", "CA-QC") == 4
+    assert invoice_tax(lines, "0.05", "US-TX") == 3
+
+
+def test_invoice_tax_exempt_is_zero():
+    assert invoice_tax([{"quantity": 3, "unit_cents": 999}], 0, "US-TX") == 0
+    assert invoice_tax([], 0.0825, "CA-QC") == 0
