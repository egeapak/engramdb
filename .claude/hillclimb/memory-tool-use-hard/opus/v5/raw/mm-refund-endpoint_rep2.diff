index 0000000..a18d6b3
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,92 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_HEADER = "X-Acme-Idempotency"
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+ACTOR_HEADER = "X-Acme-Actor-Id"
+
+# Refunds above this need a second approver in the admin tool (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+
+# idempotency key -> (stored_at, status_code, body)
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents, ccy="USD"):
+    return {"minor": cents, "ccy": ccy}
+
+
+def _replay(key):
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored is None:
+        return None
+    stored_at, status, body = stored
+    if time.time() - stored_at > IDEMPOTENCY_TTL_SECONDS:
+        del _IDEMPOTENT_RESPONSES[key]
+        return None
+    resp = jsonify(body)
+    resp.status_code = status
+    return resp
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get(IDEMPOTENCY_HEADER)
+    if not key:
+        return problem(428, "Idempotency key required", f"Send the {IDEMPOTENCY_HEADER} header.")
+    replayed = _replay(key)
+    if replayed is not None:
+        return replayed
+
+    actor_id = request.headers.get(ACTOR_HEADER)
+    if not actor_id:
+        return problem(401, "Actor required", f"Send the {ACTOR_HEADER} header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return problem(422, "Invalid amount", 'Send amount as {"minor": <int>, "ccy": "USD"}.')
+    cents = amount.get("minor")
+    if not isinstance(cents, int) or isinstance(cents, bool) or cents <= 0:
+        return problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if amount.get("ccy", "USD") != "USD":
+        return problem(422, "Invalid amount", "Only USD refunds are supported.")
+
+    try:
+        result = refund(invoice, cents)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    if result["refunded_cents"] > APPROVAL_THRESHOLD_CENTS:
+        status = "pending_approval"
+        log.info("ledger.refund_requested", invoice_id=invoice.id, customer_id=invoice.customer_id,
+                 amount_cents=result["refunded_cents"], actor_id=actor_id)
+    else:
+        status = "issued"
+        log.info("ledger.refund_issued", invoice_id=invoice.id, customer_id=invoice.customer_id,
+                 amount_cents=result["refunded_cents"], actor_id=actor_id)
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"]),
+        "status": status,
+    }
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), 201, body)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
diff --git a/tests/test_refunds_api.py b/tests/test_refunds_api.py
new file mode 100644
index 0000000..ad2e637
--- /dev/null
+++ b/tests/test_refunds_api.py
@@ -0,0 +1,72 @@
+import pytest
+from flask import Flask
+
+from src.api import refunds as refunds_api
+from src.api.invoices import _INVOICES
+from src.billing.invoices import Invoice
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(refunds_api.bp)
+    _INVOICES["inv_1"] = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=90_000, tax_cents=10_000)
+    refunds_api._IDEMPOTENT_RESPONSES.clear()
+    yield app.test_client()
+    _INVOICES.clear()
+
+
+def _post(client, minor, key="k1", invoice_id="inv_1", actor="usr_1"):
+    headers = {}
+    if key:
+        headers["X-Acme-Idempotency"] = key
+    if actor:
+        headers["X-Acme-Actor-Id"] = actor
+    return client.post(f"/invoices/{invoice_id}/refunds", json={"amount": {"minor": minor, "ccy": "USD"}}, headers=headers)
+
+
+def test_small_refund_is_issued(client):
+    resp = _post(client, 1_000)
+    assert resp.status_code == 201
+    assert resp.get_json() == {"invoice_id": "inv_1", "amount": {"minor": 1_000, "ccy": "USD"}, "status": "issued"}
+
+
+def test_threshold_refund_is_issued(client):
+    assert _post(client, 50_000).get_json()["status"] == "issued"
+
+
+def test_large_refund_needs_approval(client):
+    assert _post(client, 50_001).get_json()["status"] == "pending_approval"
+
+
+def test_missing_idempotency_key_is_428(client):
+    resp = _post(client, 1_000, key=None)
+    assert resp.status_code == 428
+    assert resp.mimetype == "application/problem+json"
+
+
+def test_same_key_replays_response(client, monkeypatch):
+    first = _post(client, 1_000)
+    calls = []
+    monkeypatch.setattr(refunds_api, "refund", lambda *a: calls.append(a))
+    second = _post(client, 1_000)
+    assert calls == []
+    assert second.status_code == first.status_code
+    assert second.get_json() == first.get_json()
+
+
+def test_missing_actor_is_401(client):
+    assert _post(client, 1_000, actor=None).status_code == 401
+
+
+def test_unknown_invoice_is_404(client):
+    assert _post(client, 1_000, invoice_id="nope").status_code == 404
+
+
+def test_refund_over_total_is_422(client):
+    assert _post(client, 100_001).status_code == 422
+
+
+@pytest.mark.parametrize("minor", [0, -5, 10.5, "100", True])
+def test_invalid_amount_is_422(client, minor):
+    assert _post(client, minor).status_code == 422
