+import hashlib
+import hmac
+import os
+import time
+
 from flask import Blueprint, request
 
+from src.api import errors
+
 bp = Blueprint("webhooks", __name__)
 
+# Events whose Psp-Signature-Timestamp is further than this from now are rejected (replay protection).
+TIMESTAMP_TOLERANCE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return an error message if the request fails verification, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        return "webhook secret is not configured"
+
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not signature or not timestamp:
+        return "missing signature headers"
+
+    try:
+        sent_at = int(timestamp)
+    except ValueError:
+        return "malformed timestamp"
+    if abs(time.time() - sent_at) > TIMESTAMP_TOLERANCE_SECONDS:
+        return "timestamp outside the allowed window"
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(cache=True), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "invalid signature"
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure:
+        return errors.problem(401, "Webhook verification failed", failure)
+
     event = request.get_json()
