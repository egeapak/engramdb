new file mode 100644
index 0000000..42b0f42
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,59 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.api.errors import problem
+from src.api.invoices import _INVOICES
+from src.billing.refunds import refund
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status)
+_RESPONSES = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    stored = _RESPONSES.get((invoice_id, key))
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        _, body, status = stored
+        return jsonify(body), status
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_minor")
+    actor_id = payload.get("actor_id")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_minor must be a positive integer.")
+    if not actor_id:
+        return problem(422, "Missing actor", "actor_id is required.")
+
+    try:
+        result = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return problem(422, "Refund not allowed", str(exc))
+
+    if result["status"] == "issued":
+        log.info("ledger.refund_issued", invoice_id=invoice.id, amount_cents=amount_cents, actor_id=actor_id)
+    else:
+        log.info("refund_pending_approval", invoice_id=invoice.id, amount_cents=amount_cents, actor_id=actor_id)
+
+    body = {
+        "invoice_id": invoice.id,
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+        "status": result["status"],
+    }
+    status = 201 if result["status"] == "issued" else 202
+    _RESPONSES[(invoice_id, key)] = (time.time(), body, status)
+    return jsonify(body), status
