@@ -0,0 +1,77 @@
+import hashlib
+import hmac
+import json
+import time
+
+import pytest
+from flask import Flask
+
+from src.api import webhooks
+from src.jobs import queue
+
+SECRET = "test-secret"
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend(monkeypatch):
+    monkeypatch.setenv("PSP_WEBHOOK_SECRET", SECRET)
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+@pytest.fixture
+def client():
+    app = Flask(__name__)
+    app.register_blueprint(webhooks.bp)
+    return app.test_client()
+
+
+def post_event(client, event, secret=SECRET, timestamp=None):
+    body = json.dumps(event).encode()
+    signature = hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()
+    headers = {
+        "Content-Type": "application/json",
+        "Psp-Signature": signature,
+        "Psp-Timestamp": str(int(timestamp if timestamp is not None else time.time())),
+    }
+    return client.post("/webhooks/psp", data=body, headers=headers)
+
+
+FAILED = {"id": "evt_1", "type": "payment.failed", "data": {"invoice_id": "inv_42"}}
+
+
+def test_payment_failed_enqueues_retry_flow(client, backend):
+    resp = post_event(client, FAILED)
+    assert resp.status_code == 204
+    assert backend.jobs == [
+        ("dunning.schedule_retries", {"invoice_id": "inv_42"}, {"dedupe_key": "dunning:inv_42:evt_1"})
+    ]
+
+
+def test_other_events_are_ignored(client, backend):
+    resp = post_event(client, {"id": "evt_2", "type": "payment.succeeded", "data": {"invoice_id": "inv_42"}})
+    assert resp.status_code == 204
+    assert backend.jobs == []
+
+
+def test_bad_signature_is_rejected(client, backend):
+    resp = post_event(client, FAILED, secret="wrong")
+    assert resp.status_code == 401
+    assert resp.mimetype == "application/problem+json"
+    assert backend.jobs == []
+
+
+def test_stale_event_is_rejected(client, backend):
+    resp = post_event(client, FAILED, timestamp=time.time() - 301)
+    assert resp.status_code == 401
+    assert backend.jobs == []
