+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+# The provider sandbox answers 202 but silently drops anything not addressed
+# to the sink domain, so delivery can only be asserted for @sink.acme.test.
+SINK_DOMAIN = "sink.acme.test"
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not os.environ.get("MAIL_API_KEY") or not os.environ.get("MAIL_SINK_API_URL"),
+        reason="needs MAIL_API_KEY (sandbox key) and MAIL_SINK_API_URL",
+    ),
+]
+
+
+def _wait_for_message(to_addr, timeout=30):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            f"{os.environ['MAIL_SINK_API_URL']}/messages",
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            params={"to": to_addr},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        messages = resp.json()
+        if messages:
+            return messages
+        time.sleep(2)
+    return []
+
+
+def test_send_receipt_is_delivered():
+    # Unique recipient so concurrent runs and old messages don't match.
+    to_addr = f"receipt-{uuid.uuid4().hex}@{SINK_DOMAIN}"
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:8]}"
+
+    # render() is not implemented yet; stub only the template, send for real.
+    with mock.patch.object(email, "render", return_value=f"<p>Receipt {invoice_id}</p>"):
+        message_id = email.send_receipt(invoice_id, to_addr, 1200)
+
+    assert message_id
+
+    messages = _wait_for_message(to_addr)
+    assert len(messages) == 1, f"receipt {message_id} not delivered to sink"
+    assert messages[0]["subject"] == "Your receipt"
+    assert invoice_id in messages[0]["html"]
