+"""Export the month's finalized invoices as the CSV Finance imports.
+
+Finance's accounting tool takes plain comma-separated files: dates are ISO
+(YYYY-MM-DD) and amounts are integer cents. The file is UTF-8 without a BOM.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date, datetime
+
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is stored as naive UTC (docs/ops/backfills.md), so the window is
+# built from naive datetimes and compared directly; no host zone is involved.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL
+      AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(today):
+    first = today.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def render_csv(rows):
+    """rows: (id, customer_id, subtotal_cents, tax_cents, finalized_at) tuples."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\r\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at in rows:
+        writer.writerow([
+            invoice_id,
+            customer_id,
+            int(subtotal_cents),
+            int(tax_cents),
+            int(subtotal_cents) + int(tax_cents),
+            finalized_at.strftime("%Y-%m-%d"),
+        ])
+    return buf.getvalue()
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV instead of writing it")
     args = parser.parse_args()
+
+    month = args.month or previous_month(date.today())
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    body = render_csv(fetch_rows(database_url, start, end))
+    if args.dry_run:
+        sys.stdout.write(body)
+        print(f"dry run: would write {bucket}/{key} ({args.env})", file=sys.stderr)
+        return 0
+
+    # No object-store client is wired up yet; EXPORT_BUCKET is treated as a
+    # local directory and the file is written under it at the bucket key.
+    path = os.path.join(bucket, key)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        f.write(body)
+    print(f"exported {month} for {args.env} to {path}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..71a4685
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,28 @@
+from datetime import date, datetime
+
+from scripts.export import month_window, previous_month, render_csv
+
+
+def test_render_csv_uses_finance_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 23, 59)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 8, 0)),
+    ]
+    assert render_csv(rows) == (
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date\r\n"
+        "inv_1,cus_1,10000,1900,11900,2026-09-03\r\n"
+        "inv_2,cus_2,0,0,0,2026-09-30\r\n"
+    )
+
+
+def test_render_csv_has_no_bom():
+    assert not render_csv([]).encode("utf-8").startswith(b"\xef\xbb\xbf")
+
+
+def test_month_window_wraps_december():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+
+
+def test_previous_month():
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
