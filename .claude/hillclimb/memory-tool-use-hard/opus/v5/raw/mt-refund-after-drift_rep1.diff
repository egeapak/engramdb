diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..52873d0
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,63 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.api import errors
+from src.api.invoices import _INVOICES
+from src.billing import refunds
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# key -> (stored_at, body, status). In-process only, like _INVOICES.
+_IDEMPOTENCY = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+    stored = _IDEMPOTENCY.get(key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    actor_id = request.headers.get("X-Acme-Actor")
+    if not actor_id:
+        return errors.problem(400, "Actor required", "Send an X-Acme-Actor header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return errors.problem(400, "Invalid amount", 'Expected "amount": {"minor": <int>, "ccy": <str>}.')
+    minor, ccy = amount.get("minor"), amount.get("ccy")
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return errors.problem(400, "Invalid amount", "amount.minor must be a positive integer.")
+    if ccy != invoice.currency:
+        return errors.problem(400, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+
+    try:
+        result = refunds.refund(invoice, minor)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    if result["status"] == "issued":
+        log.info("ledger.refund_issued", invoice_id=invoice.id, refunded_cents=minor, actor_id=actor_id)
+    else:
+        log.info("refund_pending_approval", invoice_id=invoice.id, refunded_cents=minor, actor_id=actor_id)
+
+    body = {
+        "invoice_id": invoice.id,
+        "status": result["status"],
+        "amount": {"minor": result["refunded_cents"], "ccy": invoice.currency},
+    }
+    _IDEMPOTENCY[key] = (time.time(), body, 201)
+    return jsonify(body), 201
