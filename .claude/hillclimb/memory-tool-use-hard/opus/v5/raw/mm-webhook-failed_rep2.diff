+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api import errors
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verify_signature():
+    """Check the PSP signature and timestamp; return an error response or None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return errors.problem(401, "Invalid webhook signature")
+
+    signature = request.headers.get("Psp-Signature", "")
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return errors.problem(401, "Invalid webhook signature")
+
+    try:
+        timestamp = int(request.headers.get("Psp-Timestamp", ""))
+    except ValueError:
+        return errors.problem(401, "Invalid webhook timestamp")
+    if abs(time.time() - timestamp) > MAX_EVENT_AGE_SECONDS:
+        return errors.problem(401, "Webhook timestamp outside tolerance")
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_signature()
+    if failure is not None:
+        return failure
+
     event = request.get_json()
