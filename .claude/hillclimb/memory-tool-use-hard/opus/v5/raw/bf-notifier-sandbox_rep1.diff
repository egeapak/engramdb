+"""Sends a real receipt through the email provider's sandbox account.
+
+Needs MAIL_API_KEY (the sandbox key from the dev secrets store) and
+MAIL_SINK_URL (base URL of the sink inbox API); skipped otherwise.
+
+The sandbox accepts mail for any recipient but only delivers to the
+@sink.acme.test domain, so the recipient must live there or the message
+is silently dropped and the test can never see it. The sandbox is capped
+at 500 messages a day for the whole team: keep this to one send.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+pytestmark = [
+    pytest.mark.integration,
+    pytest.mark.skipif(
+        not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_URL")),
+        reason="needs MAIL_API_KEY (sandbox) and MAIL_SINK_URL",
+    ),
+]
+
+DELIVERY_TIMEOUT_S = 60
+POLL_INTERVAL_S = 2
+
+
+def _wait_for_message(to_addr, message_id):
+    # Assumed sink API shape: GET {MAIL_SINK_URL}/messages?to=<addr> returns a
+    # JSON list of {"id", "subject", "html", ...}. Adjust if the sink differs.
+    url = f"{os.environ['MAIL_SINK_URL'].rstrip('/')}/messages"
+    deadline = time.monotonic() + DELIVERY_TIMEOUT_S
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            url,
+            params={"to": to_addr},
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json():
+            if msg.get("id") == message_id:
+                return msg
+        time.sleep(POLL_INTERVAL_S)
+    pytest.fail(f"message {message_id} not delivered to {to_addr} within {DELIVERY_TIMEOUT_S}s")
+
+
+def test_send_receipt_is_delivered():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    to_addr = f"receipts-{uuid.uuid4().hex[:12]}@sink.acme.test"
+    body = f"<p>Receipt for {invoice_id}</p>"
+
+    # render() is not implemented yet; stub it so the test exercises the
+    # real provider call. Drop this patch once templates render.
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, to_addr, 1200)
+
+    assert message_id
+    delivered = _wait_for_message(to_addr, message_id)
+    assert delivered["subject"] == "Your receipt"
+    assert invoice_id in delivered["html"]
