+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Format is fixed by Finance's import tool (German locale): `;` delimiter,
+dates as DD.MM.YYYY, amounts as integer cents, UTF-8 without a BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# Drafts have no finalized_at, so the window excludes them.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    first = now.replace(day=1)
+    return f"{first.year - 1}-12" if first.month == 1 else f"{first.year}-{first.month - 1:02d}"
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC, so the bounds are naive UTC too.
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
 
+def fetch_invoices(database_url, start, end):
+    import psycopg
 
-def main():
+    # Deployed envs go through a transaction-mode pooler: no prepared statements,
+    # and keep the transaction to this single read.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def to_row(invoice):
+    invoice_id, customer_id, subtotal_cents, tax_cents, finalized_at = invoice
+    subtotal_cents, tax_cents = int(subtotal_cents), int(tax_cents)
+    return [invoice_id, customer_id, subtotal_cents, tax_cents, subtotal_cents + tax_cents,
+            finalized_at.strftime("%d.%m.%Y")]
+
+
+def write_csv(invoices, path):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp")
+    with open(tmp, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(HEADER)
+        writer.writerows(to_row(inv) for inv in invoices)
+    os.replace(tmp, path)
+
+
+def main(argv=None):
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
-    args = parser.parse_args()
+    parser.add_argument("--month", help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out-dir", default=".", help="directory the exports/<YYYY-MM>/invoices.csv tree is written under")
+    parser.add_argument("--dry-run", action="store_true", help="query and summarise, write nothing")
+    args = parser.parse_args(argv)
+
+    month = args.month or previous_month()
+    start, end = month_window(month)
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+
+    invoices = fetch_invoices(database_url, start, end)
+    total = sum(int(inv[2]) + int(inv[3]) for inv in invoices)
+    print(f"{args.env} {month}: {len(invoices)} finalized invoices, total {total} cents")
+    if args.dry_run:
+        print(f"dry run: would write {key} for {bucket}")
+        return 0
+    path = Path(args.out_dir) / key
+    write_csv(invoices, path)
+    print(f"wrote {path} for {bucket}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..a490857
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,25 @@
+from datetime import datetime
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_csv_matches_finance_import_format(tmp_path):
+    invoices = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 14, 5)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    path = tmp_path / "exports" / "2026-09" / "invoices.csv"
+    write_csv(invoices, path)
+    raw = path.read_bytes()
+    assert not raw.startswith(b"\xef\xbb\xbf")
+    assert raw.decode("utf-8").splitlines() == [
+        "invoice_id;customer_id;subtotal_cents;tax_cents;total_cents;finalized_date",
+        "inv_1;cus_1;10000;1900;11900;03.09.2026",
+        "inv_2;cus_2;0;0;0;30.09.2026",
+    ]
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(datetime(2026, 1, 2)) == "2025-12"
+    assert previous_month(datetime(2026, 10, 2)) == "2026-09"
