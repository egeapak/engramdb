@@ -1,6 +1,38 @@
 """Follow-up when a customer's payment fails."""
+from datetime import timedelta
 
+import structlog
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Days after the failed charge on which we retry it (finance policy FP-12).
+# If the last retry also fails, the retry job marks the invoice uncollectible.
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at, *, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `dunning.retry_charge` job per retry day, counted from
+    `failed_at`, and returns the planned run times. An invoice with a refund
+    in progress is never retried, so nothing is scheduled for it.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    run_times = []
+    for attempt, day in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=day)
+        queue.enqueue(
+            "dunning.retry_charge",
+            {"invoice_id": invoice.id, "attempt": attempt, "final": attempt == len(RETRY_DAYS)},
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        run_times.append(run_at)
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, attempts=len(run_times))
+    return run_times
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..7770ca0
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,47 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from src.billing.dunning import schedule_retries
+from src.billing.invoices import Invoice
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+FAILED_AT = datetime(2026, 10, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def test_schedules_retries_on_days_1_3_7_14(backend):
+    run_times = schedule_retries(Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000), FAILED_AT)
+
+    assert run_times == [FAILED_AT + timedelta(days=d) for d in (1, 3, 7, 14)]
+    assert [(name, payload) for name, payload, _ in backend.jobs] == [
+        ("dunning.retry_charge", {"invoice_id": "inv_1", "attempt": 1, "final": False}),
+        ("dunning.retry_charge", {"invoice_id": "inv_1", "attempt": 2, "final": False}),
+        ("dunning.retry_charge", {"invoice_id": "inv_1", "attempt": 3, "final": False}),
+        ("dunning.retry_charge", {"invoice_id": "inv_1", "attempt": 4, "final": True}),
+    ]
+    assert [opts["dedupe_key"] for _, _, opts in backend.jobs] == [f"dunning:inv_1:{n}" for n in (1, 2, 3, 4)]
+    assert [opts["run_at"] for _, _, opts in backend.jobs] == run_times
+
+
+def test_no_retries_while_refund_in_progress(backend):
+    invoice = Invoice(id="inv_2", customer_id="cus_1", subtotal_cents=1000)
+
+    assert schedule_retries(invoice, FAILED_AT, refund_in_progress=True) == []
+    assert backend.jobs == []
