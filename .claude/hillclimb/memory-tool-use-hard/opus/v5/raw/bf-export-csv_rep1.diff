+"""Export one month's finalized invoices as the CSV that Finance imports.
+
+Finance's import tool runs with a German locale: semicolon delimiter, dates as
+DD.MM.YYYY, UTF-8 without a BOM. Amounts are integer cents with no currency symbol.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+COLUMNS = ["invoice id", "customer id", "subtotal", "tax", "total", "finalized date"]
+
+# finalized_at is stored as naive UTC (docs/ops/backfills.md). The window is built
+# from naive datetimes so it never depends on the host's local zone.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    return f"{now.year - 1}-12" if now.month == 1 else f"{now.year}-{now.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_invoices(database_url, start, end):
+    import psycopg
 
+    # Deployed environments go through a transaction-mode pooler, which breaks
+    # server-side prepared statements.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
-def main():
+
+def write_csv(rows, fh):
+    writer = csv.writer(fh, delimiter=";", lineterminator="\r\n")
+    writer.writerow(COLUMNS)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, int(subtotal), int(tax), int(subtotal) + int(tax),
+                         finalized_at.strftime("%d.%m.%Y")])
+
+
+def main(argv=None):
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
-    args = parser.parse_args()
+    parser.add_argument("--month", help="YYYY-MM (default: the previous month, UTC)")
+    parser.add_argument("--out", type=Path, help="output path (default: exports/<YYYY-MM>/invoices.csv)")
+    parser.add_argument("--dry-run", action="store_true", help="query and summarise, write nothing")
+    args = parser.parse_args(argv)
+
+    month = args.month or previous_month()
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    out = args.out or Path(key)
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    rows = fetch_invoices(database_url, start, end)
+    total = sum(int(r[2]) + int(r[3]) for r in rows)
+    print(f"{args.env}: {len(rows)} finalized invoices for {month}, total {total} cents")
+
+    if args.dry_run:
+        print(f"dry run: would write {out} for {bucket}/{key}")
+        return 0
+
+    out.parent.mkdir(parents=True, exist_ok=True)
+    tmp = out.with_name(out.name + ".tmp")
+    with open(tmp, "w", encoding="utf-8", newline="") as fh:
+        write_csv(rows, fh)
+    tmp.replace(out)
+    print(f"wrote {out} (destination {bucket}/{key})")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
