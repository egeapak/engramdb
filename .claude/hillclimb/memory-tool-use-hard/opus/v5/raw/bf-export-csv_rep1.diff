@@ -0,0 +1,24 @@
+import io
+from datetime import datetime
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_csv_matches_finance_import_format():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 1, 0, 0)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 23, 59)),
+    ]
+    buf = io.StringIO()
+    write_csv(rows, buf)
+    assert buf.getvalue() == (
+        "invoice id;customer id;subtotal;tax;total;finalized date\r\n"
+        "inv_1;cus_1;10000;1900;11900;01.09.2026\r\n"
+        "inv_2;cus_2;0;0;0;30.09.2026\r\n"
+    )
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(datetime(2026, 10, 2)) == "2026-09"
+    assert previous_month(datetime(2027, 1, 2)) == "2026-12"
