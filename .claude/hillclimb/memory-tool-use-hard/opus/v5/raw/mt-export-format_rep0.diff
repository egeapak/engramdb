@@ -0,0 +1,23 @@
+from datetime import date, datetime
+
+from scripts.export import month_window, previous_month, to_csv
+
+
+def test_csv_uses_commas_iso_dates_and_integer_cents():
+    rows = [
+        ("inv_1", "cus_1", 10000, 1900, datetime(2026, 9, 3, 23, 30)),
+        ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30, 0, 5)),
+    ]
+    body = to_csv(rows)
+    assert not body.startswith(b"\xef\xbb\xbf")
+    assert body.decode("utf-8").splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,10000,1900,11900,2026-09-03",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_window_and_default_month():
+    assert month_window("2026-12") == (date(2026, 12, 1), date(2027, 1, 1))
+    assert previous_month(date(2026, 10, 2)) == "2026-09"
+    assert previous_month(date(2027, 1, 2)) == "2026-12"
