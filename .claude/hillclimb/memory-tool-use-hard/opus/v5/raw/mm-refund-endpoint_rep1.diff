@@ -0,0 +1,56 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+
+from . import errors
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status). Per-process; swap for a shared store.
+_IDEMPOTENCY = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return errors.problem(428, "Idempotency key required", "Send an X-Acme-Idempotency header.")
+
+    now = time.time()
+    stored = _IDEMPOTENCY.get(key)
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return errors.problem(404, "Invoice not found")
+
+    body = request.get_json(silent=True) or {}
+    amount = body.get("amount")
+    actor_id = body.get("actor_id")
+    if not isinstance(amount, dict) or amount.get("ccy") != "USD":
+        return errors.problem(422, "Invalid amount", 'amount must be {"minor": <int>, "ccy": "USD"}.')
+    amount_cents = amount.get("minor")
+    if type(amount_cents) is not int or amount_cents <= 0:
+        return errors.problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if not actor_id:
+        return errors.problem(422, "Missing actor_id")
+
+    try:
+        result = refund(invoice, amount_cents, actor_id=actor_id)
+    except ValueError as exc:
+        return errors.problem(422, "Refund rejected", str(exc))
+
+    resp_body = {
+        "invoice_id": result["invoice_id"],
+        "refunded": {"minor": result["refunded_cents"], "ccy": "USD"},
+        "status": result["status"],
+    }
+    status = 202 if result["status"] == "pending_approval" else 201
+    _IDEMPOTENCY[key] = (now, resp_body, status)
+    return jsonify(resp_body), status
