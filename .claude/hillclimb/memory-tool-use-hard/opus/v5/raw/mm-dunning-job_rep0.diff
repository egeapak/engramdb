--- a/src/billing/dunning.py
+++ b/src/billing/dunning.py
@@ -1,6 +1,48 @@
 """Follow-up when a customer's payment fails."""
 
+from datetime import timedelta
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+from src.jobs.queue import enqueue
+
+log = structlog.get_logger()
+
+# Days after the failed charge on which we retry (finance policy FP-12, contractual).
+# If the last retry also fails, the invoice is marked `uncollectible` and dunning stops.
+RETRY_DAYS = (1, 3, 7, 14)
+
+RETRY_JOB = "dunning.retry_charge"
+
+
+def schedule_retries(invoice, failed_at, *, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `dunning.retry_charge` job per entry in RETRY_DAYS, each due
+    that many days after `failed_at`. The job for the last attempt carries
+    `final: True` so the handler knows to mark the invoice `uncollectible` if
+    it fails. Invoices with a refund in progress are never retried.
+
+    Returns the list of scheduled (attempt, run_at) pairs.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    scheduled = []
+    for attempt, day in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=day)
+        enqueue(
+            RETRY_JOB,
+            {
+                "invoice_id": invoice.id,
+                "attempt": attempt,
+                "final": attempt == len(RETRY_DAYS),
+            },
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        scheduled.append((attempt, run_at))
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, attempts=len(scheduled))
+    return scheduled
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..81899f0
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,49 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from src.billing import dunning
+from src.billing.invoices import Invoice
+from src.jobs import queue
+
+
+class FakeBackend:
+    def __init__(self):
+        self.jobs = []
+
+    def enqueue(self, name, payload, **options):
+        self.jobs.append((name, payload, options))
+
+
+@pytest.fixture
+def backend():
+    fake = FakeBackend()
+    queue.configure(fake)
+    yield fake
+    queue.configure(None)
+
+
+FAILED_AT = datetime(2026, 10, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def test_schedules_retries_on_days_1_3_7_14(backend):
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=1000)
+
+    dunning.schedule_retries(invoice, FAILED_AT)
+
+    assert [opts["run_at"] - FAILED_AT for _, _, opts in backend.jobs] == [
+        timedelta(days=d) for d in (1, 3, 7, 14)
+    ]
+    assert [opts["dedupe_key"] for _, _, opts in backend.jobs] == [
+        f"dunning:inv_1:{n}" for n in (1, 2, 3, 4)
+    ]
+    assert all(name == "dunning.retry_charge" for name, _, _ in backend.jobs)
+    assert [p["final"] for _, p, _ in backend.jobs] == [False, False, False, True]
+    assert backend.jobs[0][1] == {"invoice_id": "inv_1", "attempt": 1, "final": False}
+
+
+def test_no_retries_while_refund_in_progress(backend):
+    invoice = Invoice(id="inv_2", customer_id="cus_1", subtotal_cents=1000)
+
+    assert dunning.schedule_retries(invoice, FAILED_AT, refund_in_progress=True) == []
+    assert backend.jobs == []
