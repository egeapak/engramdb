 """Follow-up when a customer's payment fails."""
 
+from datetime import date, timedelta
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+# Days after the failure on which to retry (contractual, finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Returns the dates on which to retry the charge, counted from `failed_at`
+    (default: today). Returns no retries while a refund is in progress. If the
+    last retry (day 14) also fails, the caller must mark the invoice
+    `uncollectible` and stop.
+    """
+    if refund_in_progress:
+        return []
+    failed_at = failed_at or date.today()
+    return [failed_at + timedelta(days=d) for d in RETRY_DAYS]
