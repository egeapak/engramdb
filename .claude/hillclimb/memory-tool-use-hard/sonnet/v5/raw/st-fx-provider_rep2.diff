 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (``ECB_FEED_URL``), which is
+    EUR-based, so each rate is divided by the USD rate. ECB publishes no rates
+    on non-business days, so the latest published date on or before ``day`` is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    wanted = day.isoformat()
+    by_date = {}
+    for el in ET.fromstring(resp.content).iter():
+        if el.tag.rsplit("}", 1)[-1] != "Cube":
+            continue
+        if "time" in el.attrib:
+            current = by_date.setdefault(el.attrib["time"], {})
+        elif "currency" in el.attrib:
+            current[el.attrib["currency"]] = Decimal(el.attrib["rate"])
+    dates = [d for d in by_date if d <= wanted]
+    if not dates:
+        raise LookupError(f"no ECB rates published on or before {wanted}")
+    eur_rates = by_date[max(dates)]
+    eur_rates["EUR"] = Decimal(1)
+    usd = eur_rates["USD"]
+    return {cur: rate / usd for cur, rate in eur_rates.items()}
 
 
