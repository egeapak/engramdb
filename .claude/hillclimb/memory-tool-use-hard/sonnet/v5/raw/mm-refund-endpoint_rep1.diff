+++ b/src/api/refunds.py
@@ -0,0 +1,90 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this amount need a second approver (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status). In-memory, like _INVOICES.
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents, ccy="USD"):
+    return {"minor": cents, "ccy": ccy}
+
+
+def _replay(key):
+    stored = _IDEMPOTENT_RESPONSES.get(key)
+    if stored is None:
+        return None
+    stored_at, body, status = stored
+    if time.time() - stored_at > IDEMPOTENCY_TTL_SECONDS:
+        del _IDEMPOTENT_RESPONSES[key]
+        return None
+    resp = jsonify(body)
+    resp.status_code = status
+    return resp
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    replayed = _replay(key)
+    if replayed is not None:
+        return replayed
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer.")
+
+    actor_id = request.headers.get("X-Actor-Id", "unknown")
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Too large to issue directly: do not call refund(); an approver issues it in the admin tool.
+        status = "pending_approval"
+        log.info(
+            "ledger.refund_requested",
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            actor_id=actor_id,
+        )
+        http_status = 202
+    else:
+        try:
+            refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Refund rejected", str(exc))
+        status = "issued"
+        log.info(
+            "ledger.refund_issued",
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            actor_id=actor_id,
+        )
+        http_status = 201
+
+    body = {"invoice_id": invoice.id, "amount": _money(amount_cents), "status": status}
+    _IDEMPOTENT_RESPONSES[key] = (time.time(), body, http_status)
+    resp = jsonify(body)
+    resp.status_code = http_status
+    return resp
