+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_signature():
+    """Return an error response if the request is not a fresh, correctly signed PSP event."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return problem(401, "Unauthorized", "Webhook verification failed")
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+
+    expected = hmac.new(secret.encode(), request.get_data(), "sha256").hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        log.warning("psp_webhook_bad_signature")
+        return problem(401, "Unauthorized", "Invalid signature")
+
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        age = None
+    if age is None or age > MAX_EVENT_AGE_SECONDS:
+        log.warning("psp_webhook_stale_or_invalid_timestamp")
+        return problem(401, "Unauthorized", "Stale or invalid timestamp")
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    error = _verify_psp_signature()
+    if error is not None:
+        return error
+
