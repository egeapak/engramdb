 """Follow-up when a customer's payment fails."""
+from datetime import date, timedelta
 
+# Contractual retry offsets in days after the failure (finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+
+def schedule_retries(invoice, failed_at=None):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Returns the dates to retry on: days 1, 3, 7 and 14 after ``failed_at``
+    (default today). Returns an empty list if a refund is in progress on the
+    invoice. If the day-14 retry also fails, the caller must mark the invoice
+    `uncollectible` and stop; nothing is scheduled beyond day 14.
+    """
+    if getattr(invoice, "refund_in_progress", False):
+        return []
+    failed_at = failed_at or date.today()
+    return [failed_at + timedelta(days=d) for d in RETRY_DAYS]
