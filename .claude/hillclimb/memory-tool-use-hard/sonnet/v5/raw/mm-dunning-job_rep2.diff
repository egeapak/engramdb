@@ -1,6 +1,27 @@
 """Follow-up when a customer's payment fails."""
 
+from datetime import datetime, timedelta, timezone
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+log = structlog.get_logger()
+
+# Days after the failure on which to retry (contractual, finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Returns the datetimes at which to retry the charge: days 1, 3, 7 and 14
+    after the failure. If the day-14 retry also fails, the caller must mark the
+    invoice `uncollectible` and stop. An invoice with a refund in progress is
+    never retried, so the plan is empty.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+    failed_at = failed_at or datetime.now(timezone.utc)
+    retries = [failed_at + timedelta(days=d) for d in RETRY_DAYS]
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id, retries=len(retries))
+    return retries
