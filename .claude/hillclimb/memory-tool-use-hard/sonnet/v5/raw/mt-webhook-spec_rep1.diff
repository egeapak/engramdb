+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_signature(raw_body):
+    """Return an error detail string if the request is not authentic, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return "webhook verification unavailable"
+
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not signature or not timestamp:
+        return "missing signature headers"
+
+    try:
+        age = time.time() - int(timestamp)
+    except ValueError:
+        return "invalid timestamp"
+    if abs(age) > MAX_EVENT_AGE_SECONDS:
+        return "timestamp outside tolerance"
+
+    expected = hmac.new(secret.encode(), raw_body, hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return "invalid signature"
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_signature(request.get_data())
+    if failure:
+        log.warning("psp_webhook_rejected", reason=failure)
+        return problem(401, "Unauthorized", failure)
+
