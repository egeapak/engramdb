@@ -0,0 +1,73 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+CURRENCY = "USD"
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENCY = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "Send X-Acme-Idempotency.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Missing actor identity.")
+
+    now = time.time()
+    stored = _IDEMPOTENCY.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(stored[1]), stored[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if isinstance(amount_cents, bool) or not isinstance(amount_cents, int) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer.")
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Large refunds need a second approver in the admin tool; do not issue.
+        if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+            return problem(422, "Refund too large", "refund exceeds invoice total")
+        status = "pending_approval"
+    else:
+        try:
+            refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Refund too large", str(exc))
+        status = "issued"
+
+    if status == "issued":
+        log.info(
+            "ledger.refund_issued",
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            actor_id=actor_id,
+        )
+
+    body = {
+        "invoice_id": invoice.id,
+        "status": status,
+        "amount": {"minor": amount_cents, "ccy": CURRENCY},
+    }
+    _IDEMPOTENCY[(invoice_id, key)] = (now, body, 201)
+    return jsonify(body), 201
