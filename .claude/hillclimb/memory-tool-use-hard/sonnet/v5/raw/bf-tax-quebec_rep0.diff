+
+
+def test_invoice_tax_on_subtotal():
+    from src.billing.tax import invoice_tax
+    lines = [{"quantity": 1, "unit_cents": 10}] * 2
+    assert invoice_tax(lines, 0.25, "US-CA") == 5  # 20 * .25
+    assert invoice_tax(lines, 0, "US-CA") == 0
+
+
+def test_invoice_tax_quebec_per_line():
+    from src.billing.tax import invoice_tax
+    lines = [{"quantity": 1, "unit_cents": 10}] * 2
+    # per line: 2.5 -> 2 (half-even), twice = 4; subtotal would give 5
+    assert invoice_tax(lines, 0.25, "CA-QC") == 4
