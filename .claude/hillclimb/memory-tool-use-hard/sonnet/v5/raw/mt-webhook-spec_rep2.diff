+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return an error response if the request is not authentic, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return problem(401, "Invalid signature")
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+
+    body = request.get_data()
+    expected = hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        log.warning("psp_webhook_bad_signature")
+        return problem(401, "Invalid signature")
+
+    try:
+        age = time.time() - float(timestamp)
+    except ValueError:
+        log.warning("psp_webhook_bad_timestamp")
+        return problem(401, "Invalid timestamp")
+    if age > MAX_AGE_SECONDS:
+        log.warning("psp_webhook_stale_event", age_seconds=int(age))
+        return problem(401, "Stale event")
+
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    # Verify against the raw body before any parsing.
+    error = _verify_psp_request()
+    if error is not None:
+        return error
+
