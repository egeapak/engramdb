+"""Export the month's finalized invoices as a CSV for Finance's accounting import."""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# finalized_at is stored as naive UTC (docs/ops/backfills.md), so the window is built from
+# naive datetimes and never from the host's zone.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(today):
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    # The deployed pooler runs in transaction mode: no server-side prepared statements.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    """Finance's import runs with a German locale: ';' delimiter, DD.MM.YYYY dates, UTF-8 no BOM."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
+    return buf.getvalue()
+
+
+def upload(bucket, key, body):
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body.encode("utf-8"), ContentType="text/csv")
 
 
 def main():
-    parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
+    parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
+    parser.add_argument("--out", help="also write the CSV to this local path")
+    parser.add_argument("--dry-run", action="store_true", help="build the CSV but upload nothing")
     args = parser.parse_args()
+
+    month = args.month or previous_month(datetime.utcnow())
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+
+    rows = fetch_rows(database_url, start, end)
+    body = render_csv(rows)
+
+    if args.out:
+        with open(args.out, "w", encoding="utf-8", newline="") as f:
+            f.write(body)
+    if args.dry_run:
+        print(f"dry run: {len(rows)} invoices for {month}; would write s3://{bucket}/{key}")
+        return 0
+    upload(bucket, key, body)
+    print(f"exported {len(rows)} {args.env} invoices for {month} to s3://{bucket}/{key}")
+    return 0
 
 
 if __name__ == "__main__":
