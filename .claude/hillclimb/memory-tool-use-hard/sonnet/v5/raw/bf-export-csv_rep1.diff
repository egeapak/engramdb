+"""Export one month's finalized invoices as the CSV Finance imports.
+
+Finance's import tool runs with a German locale: semicolon delimiter,
+DD.MM.YYYY dates, UTF-8 without BOM. Amounts are integer cents.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date, datetime
+
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+
+# invoices.finalized_at is naive UTC (see docs/ops/backfills.md), so compare
+# against naive bounds and never depend on the host's TZ. Drafts have no
+# finalized_at and are excluded.
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def default_month(today=None):
+    today = today or date.today()
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def render_csv(rows):
+    buf = io.StringIO(newline="")
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
+    return buf.getvalue()
+
+
+def fetch_rows(month):
+    import psycopg  # imported lazily so --help and tests don't need a database
+
+    start, end = month_window(month)
+    with psycopg.connect(os.environ["DATABASE_URL"]) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def upload(bucket, key, body):
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body.encode("utf-8"), ContentType="text/csv; charset=utf-8")
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", default=None, help="YYYY-MM (default: previous month)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV to stdout, upload nothing")
     args = parser.parse_args()
+    month = args.month or default_month()
+    month_window(month)  # validate
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    print(f"exporting {args.env} {month} to s3://{bucket}/{key} (dry_run={args.dry_run})", file=sys.stderr)
+
+    if not os.environ.get("DATABASE_URL"):
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    rows = fetch_rows(month)
+    body = render_csv(rows)
+    if args.dry_run:
+        sys.stdout.write(body)
+    else:
+        upload(bucket, key, body)
+    print(f"{len(rows)} invoices exported", file=sys.stderr)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
