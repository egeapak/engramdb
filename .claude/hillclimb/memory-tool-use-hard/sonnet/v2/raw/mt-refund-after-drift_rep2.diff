index 0000000..193b7a0
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,72 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENCY = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "X-Acme-Idempotency is required")
+
+    cache_key = (invoice_id, key)
+    stored = _IDEMPOTENCY.get(cache_key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount_cents")
+    if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer")
+
+    try:
+        result = refund(invoice, amount)
+    except ValueError as exc:
+        return problem(422, "Refund exceeds invoice total", str(exc))
+
+    status = "pending_approval" if amount > APPROVAL_THRESHOLD_CENTS else "issued"
+    refund_id = str(uuid.uuid4())
+    body = {
+        "id": refund_id,
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"], invoice.currency),
+        "status": status,
+    }
+    if status == "issued":
+        log.info(
+            "ledger.refund_issued",
+            refund_id=refund_id,
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            actor_id=request.headers.get("X-Actor-Id"),
+        )
+
+    _IDEMPOTENCY[cache_key] = (time.time(), body, 201)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
