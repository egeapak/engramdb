 import argparse
+import csv
+import io
 import os
+from datetime import date, datetime, timezone
+
+
+def month_bounds(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = datetime(start.year + start.month // 12, start.month % 12 + 1, 1)
+    return start, end
+
+
+def previous_month(today=None):
+    today = today or datetime.now(timezone.utc).date()
+    year, mon = (today.year, today.month - 1) if today.month > 1 else (today.year - 1, 12)
+    return f"{year:04d}-{mon:02d}"
+
+
+def fetch_rows(month):
+    """Finalized invoices of the month. finalized_at is naive UTC, so the window is too."""
+    import psycopg
+
+    start, end = month_bounds(month)
+    # Deployed environments go through a transaction-mode pooler: no prepared statements.
+    with psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None) as conn:
+        return conn.execute(
+            "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+            "WHERE finalized_at >= %s AND finalized_at < %s ORDER BY finalized_at, id",
+            (start, end),
+        ).fetchall()
+
+
+def render_csv(rows):
+    """Finance import format: ';' delimiter, DD.MM.YYYY dates, integer cents, UTF-8 no BOM."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"])
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
+    return buf.getvalue()
+
+
+def upload(bucket, key, body):
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body.encode("utf-8"), ContentType="text/csv")
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", help="YYYY-MM; defaults to the previous month")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+    month = args.month or previous_month()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    body = render_csv(fetch_rows(month))
+    count = body.count("\n") - 1
+    print(f"exporting {args.env} {month}: {count} invoices to {bucket}/{key} (dry_run={args.dry_run})")
+    if not args.dry_run:
+        upload(bucket, key, body)
 
 
