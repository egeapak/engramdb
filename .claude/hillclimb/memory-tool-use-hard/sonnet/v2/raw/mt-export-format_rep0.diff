@@ -0,0 +1,20 @@
+import io
+from datetime import datetime, timezone
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_csv_format_is_comma_and_iso_dates():
+    out = io.StringIO()
+    rows = [("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3, 12)), ("inv_0", "cus_2", 0, 0, datetime(2026, 9, 30, 23))]
+    assert write_csv(rows, out) == 2
+    assert out.getvalue().splitlines() == [
+        "invoice_id,customer_id,subtotal,tax,total,finalized_date",
+        "inv_1,cus_1,1000,190,1190,2026-09-03",
+        "inv_0,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_window_and_previous_month_wrap_year():
+    assert month_window("2026-12") == (datetime(2026, 12, 1), datetime(2027, 1, 1))
+    assert previous_month(datetime(2027, 1, 2, tzinfo=timezone.utc)) == "2026-12"
