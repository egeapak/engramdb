+"""Export one month of finalized invoices as the CSV Finance imports.
+
+Format (Finance's current accounting tool): comma delimiter, YYYY-MM-DD dates,
+integer cents, UTF-8 without BOM.
+"""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is naive UTC (docs/ops/backfills.md), so the window is built in UTC
+# and never from the host's zone.
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+    "WHERE finalized_at IS NOT NULL AND finalized_at >= %s AND finalized_at < %s "
+    "ORDER BY finalized_at, id"
+)
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    year, month = (now.year - 1, 12) if now.month == 1 else (now.year, now.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def write_csv(rows, out):
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(HEADER)
+    count = 0
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%Y-%m-%d")])
+        count += 1
+    return count
+
+
+def fetch_rows(database_url, month):
+    import psycopg  # imported lazily so the CSV logic is usable without a database
+
+    start, end = month_window(month)
+    # The deployed pooler runs in transaction mode: no server-side prepared statements.
+    with psycopg.connect(database_url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=None, help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", default=None, help="output file (default: exports/<month>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+    month = args.month or previous_month()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    print(f"exporting {args.env} {month} to {bucket} (dry_run={args.dry_run})", file=sys.stderr)
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    rows = fetch_rows(database_url, month)
+
+    if args.dry_run:
+        count = write_csv(rows, sys.stdout)
+        print(f"dry run: {count} invoices, nothing written", file=sys.stderr)
+        return 0
+    path = Path(args.out or f"exports/{month}/invoices.csv")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as out:
+        count = write_csv(rows, out)
+    print(f"wrote {count} invoices to {path}", file=sys.stderr)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
