diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..26741fb
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,78 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.money import Money
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+# Refunds above this amount need a second approver before they are issued.
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status_code)
+_REPLAY = {}
+
+
+def _money(amount: Money):
+    return {"minor": amount.cents, "ccy": amount.currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(400, "Actor required", "Send the X-Actor-Id header.")
+
+    now = time.time()
+    stored = _REPLAY.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer.")
+
+    try:
+        result = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    needs_approval = amount_cents > APPROVAL_THRESHOLD_CENTS
+    status = "pending_approval" if needs_approval else "issued"
+    body = {
+        "invoice_id": result["invoice_id"],
+        "status": status,
+        "amount": _money(Money(result["refunded_cents"], invoice.currency)),
+    }
+
+    # Only log ids here: customer names, emails and addresses must stay out of logs.
+    event = "ledger.refund_requested" if needs_approval else "ledger.refund_issued"
+    log.info(
+        event,
+        invoice_id=invoice.id,
+        customer_id=invoice.customer_id,
+        actor_id=actor_id,
+        amount_cents=amount_cents,
+    )
+
+    _REPLAY[(invoice_id, key)] = (now, body, 201)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
