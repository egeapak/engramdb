 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import date, datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+# Finance's import tool runs with a German locale: ';' delimiter, DD.MM.YYYY dates.
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE ledger_ref IS NOT NULL
+      AND finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def previous_month(today):
+    return (today.year - 1, 12) if today.month == 1 else (today.year, today.month - 1)
+
+
+def month_bounds(year, month):
+    start = datetime(year, month, 1, tzinfo=timezone.utc)
+    end = datetime(year + (month == 12), month % 12 + 1, 1, tzinfo=timezone.utc)
+    return start, end
+
+
+def render_csv(rows):
+    """rows: (id, customer_id, subtotal_cents, tax_cents, finalized_at). Integer cents, no symbols."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=";", lineterminator="\n")
+    writer.writerow(HEADER)
+    for inv_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([inv_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
+    return buf.getvalue()
+
+
+def fetch_rows(year, month):
+    import psycopg
+
+    start, end = month_bounds(year, month)
+    # Deployed DBs sit behind a transaction-mode pooler: no prepared statements.
+    with psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--dry-run", action="store_true", help="write under var/exports/ instead of uploading")
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
+    if args.month:
+        year, month = map(int, args.month.split("-"))
+    else:
+        year, month = previous_month(date.today())
+    key = f"exports/{year:04d}-{month:02d}/invoices.csv"
     print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
 
+    rows = fetch_rows(year, month)
+    body = render_csv(rows).encode("utf-8")  # UTF-8, no BOM
+
+    if args.dry_run:
+        out = ROOT / "var" / args.env / key
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_bytes(body)
+        print(f"dry run: wrote {len(rows)} invoices to {out.relative_to(ROOT)}")
+        return 0
+
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body, ContentType="text/csv; charset=utf-8")
+    print(f"uploaded {len(rows)} invoices to s3://{bucket}/{key}")
+    return 0
+
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
