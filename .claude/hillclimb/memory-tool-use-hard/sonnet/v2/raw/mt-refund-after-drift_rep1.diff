diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..b22e73e
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,81 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# idempotency key -> (stored_at, status_code, body)
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "X-Acme-Idempotency is required")
+
+    now = time.time()
+    stored = _IDEMPOTENT_RESPONSES.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[2])
+        resp.status_code = stored[1]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(400, "Invalid refund amount", "amount_cents must be a positive integer")
+
+    actor_id = request.headers.get("X-Actor-Id", "unknown")
+
+    try:
+        result = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"], invoice.currency),
+        "status": status,
+    }
+
+    if status == "issued":
+        log.info(
+            "ledger.refund_issued",
+            actor_id=actor_id,
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+        )
+    else:
+        log.info(
+            "ledger.refund_requested",
+            actor_id=actor_id,
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+        )
+
+    _IDEMPOTENT_RESPONSES[(invoice_id, key)] = (now, 201, body)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
