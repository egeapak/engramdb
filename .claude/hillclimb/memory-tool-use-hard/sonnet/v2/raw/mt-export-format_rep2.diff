@@ -0,0 +1,19 @@
+import io
+from datetime import datetime
+
+from scripts.export import month_window, previous_month, write_csv
+
+
+def test_write_csv_finance_format():
+    out = io.StringIO()
+    write_csv([("inv_1", "cus_1", 1000, 190, "2026-09-30 23:59:59"), ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 1))], out)
+    assert out.getvalue().splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,1000,190,1190,2026-09-30",
+        "inv_2,cus_2,0,0,0,2026-09-01",
+    ]
+
+
+def test_month_window_and_previous_month():
+    assert month_window("2026-12")[1] == datetime(2027, 1, 1)
+    assert previous_month(datetime(2027, 1, 2)) == "2026-12"
