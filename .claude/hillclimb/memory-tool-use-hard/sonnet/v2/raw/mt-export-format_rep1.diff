+import io
+from datetime import datetime
+
+from scripts.export import month_bounds, previous_month, write_csv
+
+
+def test_csv_matches_finance_format():
+    buf = io.StringIO()
+    write_csv([("inv_1", "cus_1", 1000, 190, datetime(2026, 9, 3)), ("inv_2", "cus_2", 0, 0, datetime(2026, 9, 30))], buf)
+    assert buf.getvalue().splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,1000,190,1190,2026-09-03",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_helpers():
+    assert month_bounds("2026-12")[1].isoformat() == "2027-01-01"
+    assert previous_month(datetime(2027, 1, 2)) == "2026-12"
