 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (``ECB_FEED_URL``). The feed is
+    EUR-based, so each rate is divided by the USD rate. The ECB publishes no
+    rates on weekends/holidays, so the latest published day on or before `day`
+    is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    target = day if isinstance(day, date) else date.fromisoformat(str(day))
+    best_day, best_cube = None, None
+    for el in root.iter():
+        if _local(el.tag) != "Cube" or "time" not in el.attrib:
+            continue
+        d = date.fromisoformat(el.attrib["time"])
+        if d <= target and (best_day is None or d > best_day):
+            best_day, best_cube = d, el
+    if best_cube is None:
+        raise LookupError(f"no ECB rates published on or before {target.isoformat()}")
+
+    eur_rates = {"EUR": Decimal(1)}
+    for c in best_cube:
+        if "currency" in c.attrib:
+            eur_rates[c.attrib["currency"]] = Decimal(c.attrib["rate"])
+    usd = eur_rates.get("USD")
+    if not usd:
+        raise LookupError(f"no USD rate in ECB feed for {best_day.isoformat()}")
+    return {cur: rate / usd for cur, rate in eur_rates.items()}
 
 
