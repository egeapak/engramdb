diff --git a/scripts/purge_invoices.py b/scripts/purge_invoices.py
new file mode 100644
index 0000000..9a8df33
--- /dev/null
+++ b/scripts/purge_invoices.py
@@ -0,0 +1,65 @@
+"""Delete invoices finalized more than RETENTION_DAYS ago. Dry-run unless --execute is given."""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+# Legal defines the retention period in days (10 years after finalization); do not derive from years.
+RETENTION_DAYS = 3650
+MAX_SAFE_BATCH = 500  # larger batches hold invoices row locks long enough to time out checkout (INC-2291)
+
+# finalized_at is stored as naive UTC; refunds of any kind block a purge (no status column to tell open from closed).
+ELIGIBLE = """
+    FROM invoices i
+    WHERE i.finalized_at IS NOT NULL
+      AND i.finalized_at < %s
+      AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id)
+"""
+
+
+def cutoff(now=None):
+    now = now or datetime.now(timezone.utc)
+    return (now - timedelta(days=RETENTION_DAYS)).replace(tzinfo=None)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is dry-run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"--batch-size must be between 1 and {MAX_SAFE_BATCH}", file=sys.stderr)
+        return 3
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 2
+
+    import psycopg
+
+    limit = cutoff()
+    # Deployed DBs sit behind a transaction-mode pooler: no server-side prepared statements.
+    with psycopg.connect(url, prepare_threshold=None) as conn:
+        if not args.execute:
+            count = conn.execute("SELECT count(*) " + ELIGIBLE, (limit,)).fetchone()[0]
+            print(f"dry-run: {count} invoices finalized before {limit:%Y-%m-%d} would be deleted "
+                  f"(retention {RETENTION_DAYS} days); pass --execute to delete")
+            return 0
+        deleted = 0
+        while True:
+            # One short transaction per batch; the context manager commits on success.
+            with conn.transaction():
+                ids = [r[0] for r in conn.execute(
+                    "SELECT i.id " + ELIGIBLE + " ORDER BY i.id LIMIT %s", (limit, args.batch_size))]
+                if not ids:
+                    break
+                conn.execute("DELETE FROM invoice_lines WHERE invoice_id = ANY(%s)", (ids,))
+                conn.execute("DELETE FROM invoices WHERE id = ANY(%s)", (ids,))
+            deleted += len(ids)
+            print(f"deleted {deleted} invoices so far")
+        print(f"purged {deleted} invoices finalized before {limit:%Y-%m-%d}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
