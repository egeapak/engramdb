diff --git a/scripts/purge_invoices.py b/scripts/purge_invoices.py
new file mode 100644
index 0000000..7d74c81
--- /dev/null
+++ b/scripts/purge_invoices.py
@@ -0,0 +1,65 @@
+"""Delete invoices (and their lines) finalized more than RETENTION_DAYS ago. Dry-run unless --execute."""
+import argparse
+import os
+import sys
+from datetime import datetime, timedelta, timezone
+
+# Legal defines the retention period in days (10 years since the 2026 tax audit); don't derive it from years.
+RETENTION_DAYS = 3650
+MAX_SAFE_BATCH = 500
+
+# Invoices past the cutoff with no open refund. Anything not yet 'issued' (e.g. pending_approval) is open.
+ELIGIBLE = """
+    SELECT i.id FROM invoices i
+    WHERE i.finalized_at IS NOT NULL AND i.finalized_at < %(cutoff)s
+      AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id AND r.status <> 'issued')
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"batch size must be between 1 and {MAX_SAFE_BATCH} (see docs/ops/backfills.md)", file=sys.stderr)
+        return 3
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+
+    import psycopg
+
+    cutoff = datetime.now(timezone.utc) - timedelta(days=RETENTION_DAYS)
+    # The pooler runs in transaction mode: server-side prepared statements must be off.
+    with psycopg.connect(url, prepare_threshold=None) as conn:
+        if not args.execute:
+            count = conn.execute(f"SELECT count(*) FROM ({ELIGIBLE}) e", {"cutoff": cutoff}).fetchone()[0]
+            conn.rollback()
+            print(f"dry run: {count} invoices finalized before {cutoff:%Y-%m-%d} would be purged "
+                  f"(pass --execute to delete)")
+            return 0
+
+        total = 0
+        while True:
+            # One short transaction per batch to keep row locks brief.
+            with conn.transaction():
+                ids = [r[0] for r in conn.execute(
+                    f"{ELIGIBLE} ORDER BY i.id LIMIT %(n)s FOR UPDATE OF i SKIP LOCKED",
+                    {"cutoff": cutoff, "n": args.batch_size},
+                ).fetchall()]
+                if not ids:
+                    break
+                conn.execute("DELETE FROM invoice_lines WHERE invoice_id = ANY(%s)", (ids,))
+                # Only settled ('issued') refunds can remain here; they reference the invoice by FK.
+                conn.execute("DELETE FROM refunds WHERE invoice_id = ANY(%s)", (ids,))
+                conn.execute("DELETE FROM invoices WHERE id = ANY(%s)", (ids,))
+            total += len(ids)
+            print(f"purged {total} invoices so far")
+        print(f"done: purged {total} invoices finalized before {cutoff:%Y-%m-%d}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
