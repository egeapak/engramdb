@@ -0,0 +1,83 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this amount need a second approver in the admin tool.
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, status_code, body)
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents, ccy="USD"):
+    return {"minor": cents, "ccy": ccy}
+
+
+def _respond(invoice_id, key, status_code, body):
+    _IDEMPOTENT_RESPONSES[(invoice_id, key)] = (time.time(), status_code, body)
+    resp = jsonify(body)
+    resp.status_code = status_code
+    return resp
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Send the X-Actor-Id header.")
+
+    stored = _IDEMPOTENT_RESPONSES.get((invoice_id, key))
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[2])
+        resp.status_code = stored[1]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if isinstance(amount_cents, bool) or not isinstance(amount_cents, int) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer.")
+
+    refund_id = str(uuid.uuid4())
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Not issued: a second person approves it in the admin tool.
+        if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+            return problem(422, "Refund exceeds invoice total")
+        status = "pending_approval"
+        log.info("ledger.refund_requested", actor_id=actor_id, invoice_id=invoice_id,
+                 refund_id=refund_id, refunded_cents=amount_cents)
+    else:
+        try:
+            refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Refund rejected", str(exc))
+        status = "issued"
+        log.info("ledger.refund_issued", actor_id=actor_id, invoice_id=invoice_id,
+                 refund_id=refund_id, refunded_cents=amount_cents)
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice_id,
+        "amount": _money(amount_cents),
+        "status": status,
+    }
+    return _respond(invoice_id, key, 201 if status == "issued" else 202, body)
