 import argparse
+import csv
 import os
+from datetime import date, datetime, timezone
+from pathlib import Path
+
+# Finance's import tool runs with a German locale: ';' delimiter, DD.MM.YYYY dates.
+DELIMITER = ";"
+DATE_FORMAT = "%d.%m.%Y"
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+
+def previous_month(today=None):
+    today = today or datetime.now(timezone.utc).date()
+    return (today.year - 1, 12) if today.month == 1 else (today.year, today.month - 1)
+
+
+def parse_month(value):
+    parsed = datetime.strptime(value, "%Y-%m")
+    return parsed.year, parsed.month
+
+
+def load_invoices(year, month):
+    """Finalized invoices of the month as (id, customer_id, subtotal, tax, finalized_at) rows."""
+    import psycopg
+
+    start = date(year, month, 1)
+    end = date(year + (month == 12), month % 12 + 1, 1)
+    # Deployed DBs sit behind a transaction-mode pooler: no prepared statements.
+    with psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None) as conn:
+        return conn.execute(
+            "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices"
+            " WHERE finalized_at >= %s AND finalized_at < %s ORDER BY finalized_at, id",
+            (start, end),
+        ).fetchall()
+
+
+def write_csv(path, rows):
+    """Write amounts as integer cents; every row exactly once, zero-amount included."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    # utf-8 (no BOM); newline="" lets csv control line endings.
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=DELIMITER)
+        writer.writerow(HEADER)
+        for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+            writer.writerow([
+                invoice_id, customer_id, subtotal, tax, subtotal + tax,
+                finalized_at.strftime(DATE_FORMAT),
+            ])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
     parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
+    parser.add_argument("--out-dir", default=None,
+                        help="directory to write exports/<YYYY-MM>/invoices.csv into (default: EXPORT_DIR or ./var)")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    year, month = parse_month(args.month) if args.month else previous_month()
+    label = f"{year:04d}-{month:02d}"
+    print(f"exporting {args.env} {label} to {bucket} (dry_run={args.dry_run})")
+
+    rows = load_invoices(year, month)
+    if args.dry_run:
+        print(f"dry run: would write {len(rows)} invoices")
+        return
+    out_dir = Path(args.out_dir or os.environ.get("EXPORT_DIR", "var"))
+    path = out_dir / "exports" / label / "invoices.csv"
+    write_csv(path, rows)
+    print(f"wrote {len(rows)} invoices to {path}")
 
 
 if __name__ == "__main__":
