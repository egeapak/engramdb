+
+def _decode_cursor(cursor):
+    if not cursor:
+        return None
+    try:
+        return base64.urlsafe_b64decode(cursor.encode()).decode()
+    except (binascii.Error, UnicodeError) as exc:
+        raise ValueError("bad cursor") from exc
+
+
+@bp.get("/customers/<customer_id>/invoices")
+def list_customer_invoices(customer_id):
+    try:
+        page_size = int(request.args.get("page_size", DEFAULT_PAGE_SIZE))
+        after = _decode_cursor(request.args.get("cursor"))
+    except ValueError:
+        return problem(400, "Invalid pagination parameters")
+    if not 1 <= page_size <= MAX_PAGE_SIZE:
+        return problem(400, "Invalid page_size", f"page_size must be between 1 and {MAX_PAGE_SIZE}")
+
+    # Keyset cursor on invoice id: stable while new invoices are written.
+    matching = sorted(
+        (i for i in _INVOICES.values() if i.customer_id == customer_id),
+        key=lambda i: i.id,
+    )
+    if after is not None:
+        matching = [i for i in matching if i.id > after]
+    page = matching[:page_size]
+    next_cursor = _encode_cursor(page[-1].id) if len(matching) > page_size else None
+    return jsonify({
+        "items": [
+            {
+                "id": i.id,
+                "customer_id": i.customer_id,
+                "subtotal_cents": i.subtotal_cents,
+                "tax_cents": i.tax_cents,
+                "total_cents": i.subtotal_cents + i.tax_cents,
+            }
+            for i in page
+        ],
+        "next_cursor": next_cursor,
+    })
+
 
