+import hmac
+import hashlib
+import os
+import time
+
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
 
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _signature_valid(body):
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not secret or not signature or not timestamp:
+        return False
+
+    expected = hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return False
+
+    try:
+        age = time.time() - float(timestamp)
+    except ValueError:
+        return False
+    return abs(age) <= MAX_EVENT_AGE_SECONDS
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    if not _signature_valid(request.get_data()):
+        return problem(401, "Invalid webhook signature")
