+import os
+
+import psycopg
+
+
+def get_conn():
+    # Deployed envs go through a transaction-mode pooler (port 6432), which
+    # breaks server-side prepared statements; prepare_threshold=None disables them.
+    return psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None)
