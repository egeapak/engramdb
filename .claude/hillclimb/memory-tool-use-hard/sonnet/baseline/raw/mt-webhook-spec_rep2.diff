+import hmac
+import hashlib
+import os
+import time
+
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
 
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return a problem response if the request is not a valid PSP event, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not secret or not signature or not timestamp:
+        return problem(401, "Invalid signature", "Missing webhook signature or timestamp.")
+
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        return problem(401, "Invalid signature", "Malformed webhook timestamp.")
+    if age > MAX_EVENT_AGE_SECONDS:
+        return problem(401, "Invalid signature", "Webhook timestamp is too old.")
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return problem(401, "Invalid signature", "Webhook signature mismatch.")
+    return None
+
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    # Verify against the raw body before anything parses it.
+    failure = _verify_psp_request()
+    if failure is not None:
+        return failure
+
