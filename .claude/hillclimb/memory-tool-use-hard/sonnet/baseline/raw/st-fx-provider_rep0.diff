 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL, XML). The feed is
+    EUR-based, so each cross rate is the currency's EUR rate divided by USD's.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    day = str(day)
+    for cube in ET.fromstring(resp.content).iter(f"{ECB_NS}Cube"):
+        if cube.get("time") == day:
+            eur_rates = {"EUR": Decimal(1)}
+            eur_rates.update({c.get("currency"): Decimal(c.get("rate")) for c in cube})
+            break
+    else:
+        raise LookupError(f"no ECB rates published for {day}")
+    usd = eur_rates.pop("USD")
+    return {code: rate / usd for code, rate in eur_rates.items()}
 
 
