diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..2cb9ca0
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,50 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+# Refunds above this need a second approver (see billing.refunds decision).
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, key) -> (stored_at, body, status)
+_SEEN = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "X-Acme-Idempotency is required")
+
+    now = time.time()
+    cached = _SEEN.get((invoice_id, key))
+    if cached and now - cached[0] < IDEMPOTENCY_TTL_SECONDS:
+        return jsonify(cached[1]), cached[2]
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount_cents")
+    if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer")
+
+    try:
+        result = refund(invoice, amount)
+    except ValueError as exc:
+        return problem(422, "Refund exceeds invoice total", str(exc))
+
+    result["status"] = "pending_approval" if amount > APPROVAL_THRESHOLD_CENTS else "issued"
+    log.info("refund_created", invoice_id=invoice.id, customer_id=invoice.customer_id, status=result["status"])
+
+    _SEEN[(invoice_id, key)] = (now, result, 201)
+    return jsonify(result), 201
