diff --git a/src/billing/tax.py b/src/billing/tax.py
index 7f21856..780a385 100644
--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,16 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    """Tax in cents for a whole invoice.
+
+    Computed once on the subtotal, except in CA-QC where QST must be shown
+    per line, so each line's tax is rounded and then summed.
+    """
+    if region == "CA-QC":
+        return sum(tax_for(line_total([line]), rate) for line in lines)
+    return tax_for(line_total(lines), rate)
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..a74ae9a 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -3,3 +3,22 @@ from src.billing.tax import line_total
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_invoice_tax_on_subtotal():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 10}, {"quantity": 1, "unit_cents": 10}]
+    # 20 * 0.0825 = 1.65 -> 2
+    assert invoice_tax(lines, 0.0825, "US-CA") == 2
+    assert invoice_tax(lines, 0, "US-CA") == 0
+
+
+def test_invoice_tax_quebec_per_line():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 10}, {"quantity": 1, "unit_cents": 10}]
+    # each: 0.825 -> 1, summed -> 2; use a rate that differs from subtotal rounding
+    lines = [{"quantity": 1, "unit_cents": 10}] * 3
+    assert invoice_tax(lines, 0.05, "CA-QC") == 0 + 0 + 0  # 0.5 -> 0 (half-even)
+    assert invoice_tax(lines, 0.05, "US-CA") == 2  # 1.5 -> 2
