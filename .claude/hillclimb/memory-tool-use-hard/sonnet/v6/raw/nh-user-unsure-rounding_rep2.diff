@@ -3,3 +3,12 @@ from src.billing.tax import line_total
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_tax_for_rounds_half_even():
+    from src.billing.tax import tax_for
+
+    assert tax_for(10000, 0.0825) == 825
+    assert tax_for(10, 0.25) == 2  # 2.5 -> 2
+    assert tax_for(30, 0.25) == 8  # 7.5 -> 8
+    assert tax_for(1000, 0) == 0
