+
+
+def revenue_by_customer(rows):
+    """Total revenue per customer id, in Decimal major units quantized to 4 places."""
+    cents_by_customer = {}
+    for row in rows:
+        customer_id = row["customer_id"]
+        cents_by_customer[customer_id] = cents_by_customer.get(customer_id, 0) + row["total_cents"]
+    return {
+        customer_id: (Decimal(cents) / 100).quantize(Decimal("0.0001"))
+        for customer_id, cents in cents_by_customer.items()
+    }
