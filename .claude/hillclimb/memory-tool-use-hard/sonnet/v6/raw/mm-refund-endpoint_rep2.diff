@@ -0,0 +1,87 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, key) -> (stored_at, body, status)
+_REPLAYS = {}
+
+
+def _money(cents):
+    return {"minor": cents, "ccy": "USD"}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "X-Acme-Idempotency is required")
+
+    now = time.time()
+    stored = _REPLAYS.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if isinstance(amount_cents, bool) or not isinstance(amount_cents, int) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_cents must be a positive integer")
+    if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+        return problem(422, "Refund exceeds invoice total")
+
+    actor_id = request.headers.get("X-Actor-Id", "unknown")
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Large refunds need a second approver in the admin tool; not issued here.
+        status = "pending_approval"
+        result = {"invoice_id": invoice.id, "refunded_cents": amount_cents}
+        http_status = 202
+        log.info(
+            "ledger.refund_requested",
+            actor_id=actor_id,
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            status=status,
+        )
+    else:
+        try:
+            result = refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Refund rejected", str(exc))
+        status = "issued"
+        http_status = 201
+        log.info(
+            "ledger.refund_issued",
+            actor_id=actor_id,
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+        )
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"]),
+        "status": status,
+    }
+    _REPLAYS[(invoice_id, key)] = (now, body, http_status)
+    resp = jsonify(body)
+    resp.status_code = http_status
+    return resp
