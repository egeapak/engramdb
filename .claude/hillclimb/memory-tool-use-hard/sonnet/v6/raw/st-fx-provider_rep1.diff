 """Currency conversion for multi-currency invoices."""
+import os
+import xml.etree.ElementTree as ET
 from decimal import Decimal
 
+import requests
+
+ECB_NS = {"e": "http://www.ecb.int/vocabulary/2002-08-01/eurofxref"}
+
 
 def fetch_rates(day):
     """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    iso = day if isinstance(day, str) else day.isoformat()
+    for cube in root.iterfind(".//e:Cube[@time]", ECB_NS):
+        if cube.get("time") == iso:
+            eur_rates = {c.get("currency"): Decimal(c.get("rate")) for c in cube.iterfind("e:Cube", ECB_NS)}
+            break
+    else:
+        raise LookupError(f"no ECB rates published for {iso}")
+
+    # The feed is EUR-based; divide by the USD rate to get rates against USD.
+    usd = eur_rates["USD"]
+    rates = {code: rate / usd for code, rate in eur_rates.items()}
+    rates["EUR"] = 1 / usd
+    return rates
 
 
