 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL), which is
+    EUR-based, so each rate is divided by the USD rate to get a USD cross rate.
+    """
+    day = day.isoformat() if hasattr(day, "isoformat") else str(day)
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    for node in ET.fromstring(resp.content).iter():
+        if node.tag.rpartition("}")[2] == "Cube" and node.get("time") == day:
+            eur_rates = {"EUR": Decimal(1)}
+            eur_rates.update({c.get("currency"): Decimal(c.get("rate")) for c in node})
+            break
+    else:
+        raise LookupError(f"no ECB rates for {day}")
+    usd = eur_rates.pop("USD")
+    return {code: rate / usd for code, rate in eur_rates.items()}
 
 
