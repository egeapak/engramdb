+def test_send_receipt_uses_new_template_when_flag_on(monkeypatch):
+    monkeypatch.setenv("NOTIFIER_FF_NEW_RECEIPT_EMAIL", "1")
+    with mock.patch.object(email, "render", return_value="<p>hi</p>") as render, \
