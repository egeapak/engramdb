diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..139a40a
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,82 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+_REFUNDS = {}
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Send the X-Actor-Id header.")
+
+    now = time.time()
+    stored = _IDEMPOTENT_RESPONSES.get((invoice_id, key))
+    if stored and now - stored["at"] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored["body"])
+        resp.status_code = stored["status"]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(400, "Invalid amount", "amount_cents must be a positive integer.")
+
+    try:
+        result = refund(invoice, amount_cents)
+    except ValueError as exc:
+        return problem(422, "Refund not allowed", str(exc))
+
+    # Large refunds need a second approver in the admin tool.
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        status, event = "pending_approval", "ledger.refund_requested"
+    else:
+        status, event = "issued", "ledger.refund_issued"
+
+    refund_id = str(uuid.uuid4())
+    _REFUNDS[refund_id] = {**result, "id": refund_id, "status": status}
+    log.info(
+        event,
+        actor_id=actor_id,
+        refund_id=refund_id,
+        invoice_id=invoice.id,
+        customer_id=invoice.customer_id,
+        refunded_cents=amount_cents,
+    )
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice.id,
+        "amount": _money(amount_cents, invoice.currency),
+        "status": status,
+    }
+    _IDEMPOTENT_RESPONSES[(invoice_id, key)] = {"at": now, "status": 201, "body": body}
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
