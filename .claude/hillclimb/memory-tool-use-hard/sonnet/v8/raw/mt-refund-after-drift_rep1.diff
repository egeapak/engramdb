diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..b1bcddb
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,81 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status_code)
+_REPLAYS = {}
+_REFUNDED_CENTS = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    now = time.time()
+    stored = _REPLAYS.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(400, "Actor required", "Send the X-Actor-Id header.")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    data = request.get_json(silent=True) or {}
+    amount = data.get("amount")
+    if not isinstance(amount, dict) or type(amount.get("minor")) is not int or amount["minor"] <= 0:
+        return problem(422, "Invalid amount", 'amount must be {"minor": <positive integer>, "ccy": "..."}.')
+    if amount.get("ccy", invoice.currency) != invoice.currency:
+        return problem(422, "Currency mismatch", f"Invoice is in {invoice.currency}.")
+    amount_cents = amount["minor"]
+
+    already = _REFUNDED_CENTS.get(invoice_id, 0)
+    try:
+        refund(invoice, already + amount_cents)
+    except ValueError:
+        return problem(422, "Refund exceeds invoice total")
+
+    status = "pending_approval" if amount_cents > APPROVAL_THRESHOLD_CENTS else "issued"
+    refund_id = str(uuid.uuid4())
+    if status == "issued":
+        _REFUNDED_CENTS[invoice_id] = already + amount_cents
+        event = "ledger.refund_issued"
+    else:
+        event = "ledger.refund_requested"
+    log.info(event, actor_id=actor_id, invoice_id=invoice_id, refund_id=refund_id,
+             refunded_cents=amount_cents, status=status)
+
+    body = {
+        "id": refund_id,
+        "invoice_id": invoice_id,
+        "amount": _money(amount_cents, invoice.currency),
+        "status": status,
+    }
+    _REPLAYS[(invoice_id, key)] = (now, body, 201)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
