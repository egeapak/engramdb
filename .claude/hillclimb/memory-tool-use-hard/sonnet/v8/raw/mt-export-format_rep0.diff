@@ -0,0 +1,29 @@
+import importlib.util
+from datetime import datetime
+from pathlib import Path
+
+_spec = importlib.util.spec_from_file_location("export", Path(__file__).resolve().parent.parent / "scripts" / "export.py")
+export = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(export)
+
+
+def test_csv_is_finance_import_format(tmp_path):
+    rows = [
+        ("inv_1", "cus_1", 1000, 80, datetime(2026, 9, 3, 12, 0)),
+        ("inv_2", "cus_2", 0, 0, "2026-09-30 23:59:59"),
+    ]
+    path = tmp_path / "invoices.csv"
+    assert export.write_csv(path, rows) == 2
+    raw = path.read_bytes()
+    assert not raw.startswith(b"\xef\xbb\xbf")
+    assert raw.decode().splitlines() == [
+        "invoice_id,customer_id,subtotal_cents,tax_cents,total_cents,finalized_date",
+        "inv_1,cus_1,1000,80,1080,2026-09-03",
+        "inv_2,cus_2,0,0,0,2026-09-30",
+    ]
+
+
+def test_month_bounds_and_previous_month():
+    assert export.month_bounds("2026-12")[1] == datetime(2027, 1, 1)
+    assert export.previous_month(datetime(2027, 1, 2)) == "2026-12"
+    assert export.previous_month(datetime(2026, 10, 2)) == "2026-09"
