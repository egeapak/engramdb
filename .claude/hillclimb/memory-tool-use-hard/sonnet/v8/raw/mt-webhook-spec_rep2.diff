+import hmac
+import hashlib
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_AGE_SECONDS = 120
+
+
+def _verify_psp_signature():
+    """Return an error response if the request is not authentic, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return problem(401, "Invalid signature")
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+
+    try:
+        age = time.time() - int(timestamp)
+    except ValueError:
+        return problem(401, "Invalid signature", "Missing or malformed timestamp")
+    if abs(age) > MAX_AGE_SECONDS:
+        return problem(401, "Invalid signature", "Timestamp outside allowed window")
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return problem(401, "Invalid signature")
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    error = _verify_psp_signature()
+    if error is not None:
+        log.warning("psp_webhook_rejected")
+        return error
+
