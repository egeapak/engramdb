+++ b/src/api/refunds.py
@@ -0,0 +1,88 @@
+import time
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this need a second approver (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+CURRENCY = "USD"
+
+# idempotency key -> (stored_at, body, status)
+_IDEMPOTENT_RESPONSES = {}
+
+
+def _money(cents):
+    return {"minor": cents, "ccy": CURRENCY}
+
+
+def _respond(body, status):
+    resp = jsonify(body)
+    resp.status_code = status
+    return resp
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Precondition Required", "X-Acme-Idempotency header is required")
+
+    # Scope the key to the invoice so one key can't replay another invoice's refund.
+    store_key = (invoice_id, key)
+    stored = _IDEMPOTENT_RESPONSES.get(store_key)
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        return _respond(stored[1], stored[2])
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(400, "Bad Request", "X-Actor-Id header is required")
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Not Found", "invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount_cents = payload.get("amount_cents")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Unprocessable Entity", "amount_cents must be a positive integer")
+
+    if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+        # refund() enforces this too, but pending refunds never reach it.
+        return problem(422, "Unprocessable Entity", "refund exceeds invoice total")
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Not issued: a second person approves it in the admin tool.
+        status = "pending_approval"
+        log.info(
+            "ledger.refund_requested",
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            actor_id=actor_id,
+        )
+    else:
+        try:
+            refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Unprocessable Entity", str(exc))
+        status = "issued"
+        log.info(
+            "ledger.refund_issued",
+            invoice_id=invoice.id,
+            customer_id=invoice.customer_id,
+            amount_cents=amount_cents,
+            actor_id=actor_id,
+        )
+
+    body = {"invoice_id": invoice.id, "amount": _money(amount_cents), "status": status}
+    _IDEMPOTENT_RESPONSES[store_key] = (time.time(), body, 201)
+    return _respond(body, 201)
