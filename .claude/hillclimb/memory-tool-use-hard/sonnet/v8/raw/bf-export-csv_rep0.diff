+"""Export a month's finalized invoices as the CSV Finance imports (German locale)."""
 import argparse
+import csv
 import os
+import sys
+from datetime import date
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from src.billing.periods import month_window  # noqa: E402
+
+ROOT = Path(__file__).resolve().parent.parent
+HEADER = ["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"]
+QUERY = (
+    "SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at FROM invoices "
+    "WHERE finalized_at >= %s AND finalized_at < %s ORDER BY finalized_at, id"
+)
+
+
+def previous_month(today):
+    year, month = (today.year - 1, 12) if today.month == 1 else (today.year, today.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(path, rows):
+    """Finance's import tool needs ';' delimiters, DD.MM.YYYY dates and UTF-8 without BOM."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\n")
+        writer.writerow(HEADER)
+        for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+            writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=previous_month(date.today()), help="YYYY-MM (default: last month)")
+    parser.add_argument("--output", type=Path, help="CSV path (default: var/exports/<month>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    print(f"exporting {args.month} for {args.env} to {bucket} (dry_run={args.dry_run})")
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    start, end = month_window(args.month)
+    rows = fetch_rows(database_url, start, end)
+    if args.dry_run:
+        print(f"would write {len(rows)} finalized invoices (nothing written)")
+        return 0
+    path = args.output or ROOT / "var" / "exports" / args.month / "invoices.csv"
+    write_csv(path, rows)
+    print(f"wrote {len(rows)} finalized invoices to {path}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
