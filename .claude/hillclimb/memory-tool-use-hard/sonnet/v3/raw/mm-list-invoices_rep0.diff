+from flask import Blueprint, jsonify, request
+
+from src.api.errors import problem
 
 bp = Blueprint("invoices", __name__)
 
 _INVOICES = {}
 
+DEFAULT_PAGE_SIZE = 50
+MAX_PAGE_SIZE = 250
+
+
+def _money(cents):
+    return {"minor": cents, "ccy": "USD"}
+
+
+def _encode_cursor(invoice_id):
+    return base64.urlsafe_b64encode(invoice_id.encode()).decode()
+
+
+def _decode_cursor(cursor):
+    return base64.urlsafe_b64decode(cursor.encode()).decode()
 
-@bp.get("/invoices/<invoice_id>")
+
+def _serialize_summary(invoice):
+    return {
+        "id": invoice.id,
+        "customer_id": invoice.customer_id,
+        "subtotal": _money(invoice.subtotal_cents),
+        "tax": _money(invoice.tax_cents),
+        "total": _money(invoice.subtotal_cents + invoice.tax_cents),
+    }
+
+
+@bp.route("/invoices/<invoice_id>", methods=["GET"])
 def get_invoice(invoice_id):
     invoice = _INVOICES.get(invoice_id)
     return jsonify(invoice.__dict__)
+
+
+@bp.route("/customers/<customer_id>/invoices", methods=["GET"])
+def list_customer_invoices(customer_id):
+    try:
+        page_size = int(request.args.get("page_size", DEFAULT_PAGE_SIZE))
+    except ValueError:
+        return problem(400, "Invalid page_size", "page_size must be an integer")
+    if not 1 <= page_size <= MAX_PAGE_SIZE:
+        return problem(400, "Invalid page_size", f"page_size must be between 1 and {MAX_PAGE_SIZE}")
+
+    after = None
+    cursor = request.args.get("cursor")
+    if cursor:
+        try:
+            after = _decode_cursor(cursor)
+        except ValueError:
+            return problem(400, "Invalid cursor")
+
+    invoices = sorted(
+        (i for i in _INVOICES.values() if i.customer_id == customer_id),
+        key=lambda i: i.id,
+    )
+    if after is not None:
+        invoices = [i for i in invoices if i.id > after]
+
+    page = invoices[:page_size]
+    next_cursor = _encode_cursor(page[-1].id) if len(invoices) > page_size else None
+    return jsonify({"items": [_serialize_summary(i) for i in page], "next_cursor": next_cursor})
