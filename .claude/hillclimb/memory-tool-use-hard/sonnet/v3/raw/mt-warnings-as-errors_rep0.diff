+import pytest
+
+from src.billing.invoices import Invoice
+from src.billing.refunds import refund
+
+
+def test_refund_rejects_amount_larger_than_invoice_total():
+    invoice = Invoice(id="inv_1", customer_id="cus_1", subtotal_cents=10_000, tax_cents=800)
+
+    with pytest.raises(ValueError, match="refund exceeds invoice total"):
+        refund(invoice, 10_801)
