 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL, XML, EUR-based).
+    ECB publishes no rates on weekends/holidays, so the latest earlier day is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    wanted = day if isinstance(day, str) else day.isoformat()
+
+    by_day = {}
+    for node in ET.fromstring(resp.content).iter():
+        if node.tag.rsplit("}", 1)[-1] == "Cube" and "time" in node.attrib:
+            by_day[node.attrib["time"]] = {
+                c.attrib["currency"]: Decimal(c.attrib["rate"])
+                for c in node
+                if "currency" in c.attrib
+            }
+
+    available = [d for d in by_day if d <= wanted]
+    if not available:
+        raise LookupError(f"no ECB rates on or before {wanted}")
+    eur_rates = by_day[max(available)]
+
+    usd = eur_rates["USD"]
+    rates = {code: rate / usd for code, rate in eur_rates.items() if code != "USD"}
+    rates["EUR"] = 1 / usd
+    return rates
 
 
