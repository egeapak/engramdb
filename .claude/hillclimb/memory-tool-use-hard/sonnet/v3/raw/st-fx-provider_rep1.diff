 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL). The feed is
+    EUR-based, so each rate is divided by the USD rate to get a USD cross rate.
+    """
+    day = day if isinstance(day, str) else day.isoformat()
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+
+    for cube in ET.fromstring(resp.content).iter():
+        if cube.tag.rsplit("}", 1)[-1] == "Cube" and cube.get("time") == day:
+            eur_rates = {c.get("currency"): Decimal(c.get("rate")) for c in cube}
+            break
+    else:
+        raise LookupError(f"no ECB rates published for {day}")
+
+    usd = eur_rates["USD"]
+    rates = {code: rate / usd for code, rate in eur_rates.items()}
+    rates["EUR"] = 1 / usd
+    log.info("fx_rates_fetched", day=day, currencies=len(rates))
+    return rates
 
 
