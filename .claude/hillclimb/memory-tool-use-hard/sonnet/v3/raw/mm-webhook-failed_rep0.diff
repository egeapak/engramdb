+def _verify_psp_signature():
+    """Return True if the request carries a valid, fresh PSP signature."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET", "")
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Timestamp", "")
+    if not secret or not signature or not timestamp:
+        return False
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        return False
+    if age > REPLAY_WINDOW_SECONDS:
+        return False
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    return hmac.compare_digest(expected, signature)
+
+
+@bp.route("/webhooks/psp", methods=["POST"])
 def psp_webhook():
+    if not _verify_psp_signature():
+        return problem(401, "Invalid webhook signature")
