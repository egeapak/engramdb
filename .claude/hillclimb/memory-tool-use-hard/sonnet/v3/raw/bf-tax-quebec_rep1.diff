diff --git a/src/billing/tax.py b/src/billing/tax.py
index 7f21856..745693e 100644
--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,12 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    if region == "CA-QC":
+        # QST must be shown per line: round each line's tax, then sum.
+        return sum(tax_for(line_total([line]), rate) for line in lines)
+    return tax_for(line_total(lines), rate)
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..4a60ec9 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -3,3 +3,28 @@ from src.billing.tax import line_total
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_invoice_tax_rounds_once_on_subtotal():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 10}] * 2
+    assert invoice_tax(lines, 0.0825, "US-TX") == 2  # 20 * 0.0825 = 1.65
+    assert invoice_tax(lines, 0, "US-TX") == 0
+
+
+def test_invoice_tax_half_even():
+    from src.billing.tax import invoice_tax
+
+    assert invoice_tax([{"quantity": 1, "unit_cents": 10}], 0.25, "US-TX") == 2  # 2.5 -> 2
+    assert invoice_tax([{"quantity": 1, "unit_cents": 30}], 0.25, "US-TX") == 8  # 7.5 -> 8
+
+
+def test_invoice_tax_quebec_per_line():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 10}] * 2
+    assert invoice_tax(lines, 0.0825, "CA-QC") == 2  # 0.825 -> 1 per line
+    lines = [{"quantity": 1, "unit_cents": 10}] * 3
+    assert invoice_tax(lines, 0.05, "CA-QC") == 0  # 0.5 -> 0 per line
+    assert invoice_tax(lines, 0.05, "US-TX") == 2  # 1.5 -> 2 on subtotal
