+++ b/src/db.py
@@ -0,0 +1,13 @@
+import os
+
+import psycopg
+
+
+def get_conn() -> psycopg.Connection:
+    """Open a connection to the database named by DATABASE_URL.
+
+    Deployed environments go through a transaction-mode pooler (port 6432),
+    where server-side prepared statements fail, so automatic preparing is off.
+    Keep transactions short; the pool is small.
+    """
+    return psycopg.connect(os.environ["DATABASE_URL"], prepare_threshold=None)
