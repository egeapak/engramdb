--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,58 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, key) -> (stored_at, status_code, body)
+_REPLAYS = {}
+
+
+@bp.route("/invoices/<invoice_id>/refunds", methods=["POST"])
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Missing X-Actor-Id header.")
+
+    now = time.time()
+    stored = _REPLAYS.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[2])
+        resp.status_code = stored[1]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    minor = amount.get("minor") if isinstance(amount, dict) else None
+    if not isinstance(minor, int) or isinstance(minor, bool) or minor <= 0:
+        return problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+
+    try:
+        result = refund(invoice, minor, actor_id=actor_id)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    body = {
+        "invoice_id": result["invoice_id"],
+        "status": result["status"],
+        "amount": {"minor": result["refunded_cents"], "ccy": "USD"},
+    }
+    status_code = 202 if result["status"] == "pending_approval" else 201
+    _REPLAYS[(invoice_id, key)] = (now, status_code, body)
+    resp = jsonify(body)
+    resp.status_code = status_code
+    return resp
