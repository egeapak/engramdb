 """Follow-up when a customer's payment fails."""
+from datetime import datetime, timedelta, timezone
 
+import structlog
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+from ..jobs import queue
+
+log = structlog.get_logger()
+
+# Contractual schedule (finance policy FP-12): days after the failure.
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `retry_charge` job per day in RETRY_DAYS and returns the
+    list of run times. Invoices with a refund in progress are never retried.
+    The retry job marks the invoice `uncollectible` if the final attempt
+    (`final=True` in the payload) fails.
+    """
+    if invoice.refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    run_times = []
+    for day in RETRY_DAYS:
+        run_at = failed_at + timedelta(days=day)
+        queue.enqueue(
+            "retry_charge",
+            {"invoice_id": invoice.id, "attempt_day": day, "final": day == RETRY_DAYS[-1]},
+            run_at=run_at,
+        )
+        run_times.append(run_at)
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id)
+    return run_times
