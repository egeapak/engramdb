diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..e128f97
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,85 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from src.billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+log = structlog.get_logger()
+
+bp = Blueprint("refunds", __name__)
+
+# Refunds above this need a second approver (agreed with Finance, June 2026).
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status)
+_REPLAYS = {}
+
+
+def _money(cents, currency):
+    return {"minor": cents, "ccy": currency}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(400, "Actor required", "Send the X-Actor-Id header.")
+
+    now = time.time()
+    stored = _REPLAYS.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount")
+    if not isinstance(amount, dict):
+        return problem(422, "Invalid amount", 'Expected {"amount": {"minor": <int>, "ccy": "USD"}}.')
+    minor, ccy = amount.get("minor"), amount.get("ccy")
+    if isinstance(minor, bool) or not isinstance(minor, int) or minor <= 0:
+        return problem(422, "Invalid amount", "amount.minor must be a positive integer.")
+    if ccy != invoice.currency:
+        return problem(422, "Currency mismatch", f"Invoice currency is {invoice.currency}.")
+
+    try:
+        result = refund(invoice, minor)
+    except ValueError as exc:
+        return problem(422, "Refund rejected", str(exc))
+
+    status = "pending_approval" if minor > APPROVAL_THRESHOLD_CENTS else "issued"
+    refund_id = str(uuid.uuid4())
+    body = {
+        "id": refund_id,
+        "invoice_id": result["invoice_id"],
+        "amount": _money(result["refunded_cents"], invoice.currency),
+        "status": status,
+    }
+
+    event = "ledger.refund_issued" if status == "issued" else "ledger.refund_requested"
+    log.info(
+        event,
+        actor_id=actor_id,
+        refund_id=refund_id,
+        invoice_id=invoice.id,
+        customer_id=invoice.customer_id,
+        status=status,
+    )
+
+    _REPLAYS[(invoice_id, key)] = (now, body, 201)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
