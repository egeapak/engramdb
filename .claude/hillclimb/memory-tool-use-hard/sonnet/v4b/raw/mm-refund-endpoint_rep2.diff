--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,67 @@
+import time
+import uuid
+
+import structlog
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+log = structlog.get_logger()
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, status_code, body)
+_REPLAYS = {}
+
+
+def _money(cents):
+    return {"minor": cents, "ccy": "USD"}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency key required", "Send the X-Acme-Idempotency header.")
+
+    actor_id = request.headers.get("X-Actor-Id")
+    if not actor_id:
+        return problem(401, "Unauthenticated", "Missing actor.")
+
+    stored = _REPLAYS.get((invoice_id, key))
+    if stored and time.time() - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[2])
+        resp.status_code = stored[1]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    amount_cents = (request.get_json(silent=True) or {}).get("amount_minor")
+    if not isinstance(amount_cents, int) or isinstance(amount_cents, bool) or amount_cents <= 0:
+        return problem(422, "Invalid amount", "amount_minor must be a positive integer.")
+
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        # Large refunds must not be issued directly; a second person approves them.
+        if amount_cents > invoice.subtotal_cents + invoice.tax_cents:
+            return problem(422, "Refund exceeds invoice total")
+        status = "pending_approval"
+        log.info("ledger.refund_requested", invoice_id=invoice.id, customer_id=invoice.customer_id, actor_id=actor_id, amount_cents=amount_cents)
+    else:
+        try:
+            refund(invoice, amount_cents)
+        except ValueError as exc:
+            return problem(422, "Refund exceeds invoice total", str(exc))
+        status = "issued"
+        log.info("ledger.refund_issued", invoice_id=invoice.id, customer_id=invoice.customer_id, actor_id=actor_id, amount_cents=amount_cents)
+
+    body = {"id": str(uuid.uuid4()), "invoice_id": invoice.id, "amount": _money(amount_cents), "status": status}
+    _REPLAYS[(invoice_id, key)] = (time.time(), 201, body)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
