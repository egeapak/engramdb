diff --git a/src/billing/tax.py b/src/billing/tax.py
index 7f21856..2c63716 100644
--- a/src/billing/tax.py
+++ b/src/billing/tax.py
@@ -1,4 +1,4 @@
-from decimal import Decimal
+from decimal import ROUND_HALF_EVEN, Decimal
 
 
 def line_total(lines):
@@ -9,4 +9,14 @@ def line_total(lines):
 
 
 def tax_for(amount_cents, rate):
-    raise NotImplementedError
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    if region == "CA-QC":
+        # QST must be shown per line: round each line's tax, then sum.
+        return sum(
+            tax_for(line["quantity"] * line["unit_cents"], rate) for line in lines
+        )
+    return tax_for(line_total(lines), rate)
diff --git a/tests/test_tax.py b/tests/test_tax.py
index 75e3de8..ebbf044 100644
--- a/tests/test_tax.py
+++ b/tests/test_tax.py
@@ -3,3 +3,22 @@ from src.billing.tax import line_total
 
 def test_line_total():
     assert line_total([{"quantity": 2, "unit_cents": 150}]) == 300
+
+
+def test_invoice_tax_subtotal_half_even():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 50}, {"quantity": 1, "unit_cents": 50}]
+    assert invoice_tax(lines, 0.0825, "US-CA") == 8  # 8.25 -> 8
+    assert invoice_tax(lines, 0, "US-CA") == 0
+
+
+def test_invoice_tax_quebec_per_line():
+    from src.billing.tax import invoice_tax
+
+    lines = [{"quantity": 1, "unit_cents": 50}, {"quantity": 1, "unit_cents": 50}]
+    assert invoice_tax(lines, 0.0825, "CA-QC") == 8  # 4.125->4, twice
+    lines = [{"quantity": 1, "unit_cents": 100}, {"quantity": 1, "unit_cents": 100}]
+    assert invoice_tax(lines, 0.0825, "CA-QC") == 16  # 8.25->8, twice
+    assert invoice_tax([{"quantity": 1, "unit_cents": 10}] * 3, 0.15, "CA-QC") == 6  # 1.5->2 x3
+    assert invoice_tax([{"quantity": 1, "unit_cents": 10}] * 3, 0.15, "US-CA") == 4  # 4.5->4
