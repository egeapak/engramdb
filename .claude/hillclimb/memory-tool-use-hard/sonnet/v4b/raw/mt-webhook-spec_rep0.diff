+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_signature():
+    """Return an error response if the request fails verification, else None."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return problem(401, "Invalid webhook signature")
+
+    signature = request.headers.get("Psp-Signature")
+    timestamp = request.headers.get("Psp-Signature-Timestamp")
+    if not signature or not timestamp:
+        return problem(401, "Invalid webhook signature", "Missing signature headers")
+
+    try:
+        age = abs(time.time() - int(timestamp))
+    except ValueError:
+        return problem(401, "Invalid webhook signature", "Malformed timestamp")
+    if age > MAX_EVENT_AGE_SECONDS:
+        return problem(401, "Invalid webhook signature", "Timestamp outside tolerance")
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        return problem(401, "Invalid webhook signature")
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    error = _verify_psp_signature()
+    if error is not None:
+        log.warning("psp_webhook_rejected")
+        return error
+
