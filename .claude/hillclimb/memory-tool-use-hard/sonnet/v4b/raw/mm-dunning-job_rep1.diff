@@ -1,6 +1,28 @@
 """Follow-up when a customer's payment fails."""
 
+from datetime import datetime, timedelta, timezone
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+log = structlog.get_logger()
+
+# Contractual retry offsets in days after the failure (finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Returns the datetimes at which to retry, at days 1, 3, 7 and 14 after
+    ``failed_at`` (default: now, UTC). An invoice with a refund in progress is
+    never retried, so the schedule is empty. If the final (day-14) retry also
+    fails, the caller must mark the invoice ``uncollectible`` and stop.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+    if failed_at is None:
+        failed_at = datetime.now(timezone.utc)
+    schedule = [failed_at + timedelta(days=d) for d in RETRY_DAYS]
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id, retries=len(schedule))
+    return schedule
