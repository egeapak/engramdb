 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+# finalized_at is stored as naive UTC, so the window is plain naive datetime arithmetic
+# and does not depend on the host's TZ (see docs/ops/backfills.md).
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(today=None):
+    today = today or datetime.utcnow()
+    return (today.replace(year=today.year - 1, month=12) if today.month == 1
+            else today.replace(month=today.month - 1)).strftime("%Y-%m")
+
+
+def render_csv(rows):
+    """Finance's import tool wants plain comma-separated files, ISO (YYYY-MM-DD) dates,
+    integer cents, UTF-8 without BOM. Zero-amount invoices are kept."""
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for inv_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([inv_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%Y-%m-%d")])
+    return out.getvalue()
+
+
+def fetch_rows(month):
+    import psycopg  # imported lazily so --dry-run without a database still works
+
+    start, end = month_window(month)
+    with psycopg.connect(os.environ["DATABASE_URL"]) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", help="YYYY-MM (default: previous month, UTC)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+    month = args.month or previous_month()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    print(f"exporting {args.env} {month} to {bucket}/{key} (dry_run={args.dry_run})")
+    if not os.environ.get("DATABASE_URL"):
+        print("no DATABASE_URL set; nothing exported", file=sys.stderr)
+        return 1
+    body = render_csv(fetch_rows(month))
+    if args.dry_run:
+        print(f"dry run: would write {body.count(chr(10)) - 1} invoices")
+        return 0
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body.encode("utf-8"), ContentType="text/csv")
+    print(f"wrote {key}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
