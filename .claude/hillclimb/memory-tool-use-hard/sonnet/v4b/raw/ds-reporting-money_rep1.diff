+def revenue_by_customer(rows):
+    """Total revenue per customer_id, in Decimal major units (4 places)."""
+    totals = {}
+    for row in rows:
+        amount = Decimal(row["total_cents"]) / 100
+        totals[row["customer_id"]] = totals.get(row["customer_id"], Decimal(0)) + amount
+    return {cid: t.quantize(Decimal("0.0001")) for cid, t in totals.items()}
