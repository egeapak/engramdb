 def fetch_rates(day):
     """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    wanted = day.isoformat() if hasattr(day, "isoformat") else str(day)
+    # The ECB feed is EUR-based: <Cube time="YYYY-MM-DD"><Cube currency=".." rate=".."/>...
+    for cube in ET.fromstring(resp.content).iter():
+        if cube.tag.rpartition("}")[2] != "Cube" or cube.get("time") != wanted:
+            continue
+        eur_rates = {"EUR": Decimal(1)}
+        for child in cube:
+            eur_rates[child.get("currency")] = Decimal(child.get("rate"))
+        usd = eur_rates["USD"]
+        return {code: rate / usd for code, rate in eur_rates.items()}
+    raise LookupError(f"no ECB rates published for {wanted}")
 
 
