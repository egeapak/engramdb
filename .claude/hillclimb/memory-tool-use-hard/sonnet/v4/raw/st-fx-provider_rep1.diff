 """Currency conversion for multi-currency invoices."""
+import os
+import urllib.request
+import xml.etree.ElementTree as ET
 from decimal import Decimal
 
 
 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL, no API key). The feed
+    is EUR-based, so each rate is divided by the USD rate to get a USD cross rate.
+    """
+    with urllib.request.urlopen(os.environ["ECB_FEED_URL"], timeout=10) as resp:
+        root = ET.fromstring(resp.read())
+
+    wanted = str(day)
+    for cube in root.iter():
+        if cube.tag.rsplit("}", 1)[-1] == "Cube" and cube.get("time") == wanted:
+            eur_rates = {c.get("currency"): Decimal(c.get("rate")) for c in cube}
+            break
+    else:
+        raise LookupError(f"no ECB rates published for {wanted}")
+
+    usd = eur_rates["USD"]
+    rates = {code: rate / usd for code, rate in eur_rates.items()}
+    rates["EUR"] = 1 / usd
+    return rates
 
 
