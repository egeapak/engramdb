     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=None, help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--output", type=Path, help="CSV path (default: exports/<month>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    month = args.month or previous_month()
+    start, end = month_window(month)
+    print(f"exporting {args.env} {month} to {bucket} (dry_run={args.dry_run})")
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    rows = fetch_invoices(database_url, start, end)
+    if args.dry_run:
+        print(f"would write {len(rows)} invoices (nothing written)")
+        return 0
+
+    output = args.output or Path("exports") / month / "invoices.csv"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("w", encoding="utf-8", newline="") as out:  # UTF-8, no BOM
+        write_csv(rows, out)
+    print(f"wrote {len(rows)} invoices to {output}")
+    return 0
 
 
