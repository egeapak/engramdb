 def tax_for(amount_cents, rate):
     raise NotImplementedError
+
+
+def _round_tax(amount_cents, rate):
+    tax = Decimal(amount_cents) * Decimal(str(rate))
+    return int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
+
+
+def invoice_tax(lines, rate, region):
+    """Tax in cents for a whole invoice; rate is a decimal fraction (0.0825)."""
+    if region == "CA-QC":
+        # QST must be shown per line: round each line's tax, then sum.
+        return sum(_round_tax(line_total([line]), rate) for line in lines)
+    return _round_tax(line_total(lines), rate)
