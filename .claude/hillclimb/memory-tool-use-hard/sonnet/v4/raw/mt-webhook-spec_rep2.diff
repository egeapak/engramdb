+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from .errors import problem
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 120
+
+
+def _verify_psp_request():
+    """Return None if the request is authentic, else a problem response."""
+    secret = os.environ.get("PSP_WEBHOOK_SECRET")
+    if not secret:
+        log.error("psp_webhook_secret_missing")
+        return problem(401, "Invalid signature", "Webhook verification failed")
+
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Signature-Timestamp", "")
+
+    expected = hmac.new(
+        secret.encode(), request.get_data(), hashlib.sha256
+    ).hexdigest()
+    if not hmac.compare_digest(expected, signature):
+        log.warning("psp_webhook_bad_signature")
+        return problem(401, "Invalid signature", "Webhook verification failed")
+
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        age = None
+    if age is None or age > MAX_EVENT_AGE_SECONDS:
+        log.warning("psp_webhook_stale_or_bad_timestamp")
+        return problem(401, "Invalid timestamp", "Webhook verification failed")
+
+    return None
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
+    failure = _verify_psp_request()
+    if failure is not None:
+        return failure
+
