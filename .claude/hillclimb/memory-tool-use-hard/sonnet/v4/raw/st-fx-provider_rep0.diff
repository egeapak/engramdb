 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (ECB_FEED_URL), which is
+    EUR-based; USD cross rates are derived by dividing by the USD rate. ECB
+    publishes no rates on weekends/holidays, so the latest published day on or
+    before `day` is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    by_day = {}
+    for cube in root.iter():
+        if cube.tag.rpartition("}")[2] == "Cube" and "time" in cube.attrib:
+            by_day[cube.attrib["time"]] = {
+                c.attrib["currency"]: Decimal(c.attrib["rate"])
+                for c in cube
+                if "currency" in c.attrib
+            }
+
+    wanted = str(day)
+    available = [d for d in by_day if d <= wanted]
+    if not available:
+        raise LookupError(f"no ECB rates published on or before {wanted}")
+    eur_rates = by_day[max(available)]
+    eur_rates["EUR"] = Decimal(1)
+
+    usd = eur_rates["USD"]
+    return {code: rate / usd for code, rate in eur_rates.items() if code != "USD"}
 
 
