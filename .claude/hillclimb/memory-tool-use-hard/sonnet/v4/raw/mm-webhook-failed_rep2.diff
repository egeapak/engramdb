+import hashlib
+import hmac
+import os
+import time
+
+import structlog
 from flask import Blueprint, request
 
+from src.api.errors import problem
+from src.jobs import queue
+
 bp = Blueprint("webhooks", __name__)
+log = structlog.get_logger()
+
+MAX_EVENT_AGE_SECONDS = 300
+
+
+def _verified():
+    secret = os.environ.get("PSP_WEBHOOK_SECRET", "")
+    signature = request.headers.get("Psp-Signature", "")
+    timestamp = request.headers.get("Psp-Timestamp", "")
+    if not secret or not signature or not timestamp:
+        return False
+    try:
+        age = abs(time.time() - float(timestamp))
+    except ValueError:
+        return False
+    if age > MAX_EVENT_AGE_SECONDS:
+        return False
+    expected = hmac.new(secret.encode(), request.get_data(), hashlib.sha256).hexdigest()
+    return hmac.compare_digest(expected, signature)
 
 
 @bp.post("/webhooks/psp")
 def psp_webhook():
-    event = request.get_json()
-    # TODO: verify the event, then dispatch on event["type"]
+    # Verify against the raw body before parsing anything.
+    if not _verified():
+        log.warning("psp_webhook_rejected")
+        return problem(401, "Invalid webhook signature")
+
+    event = request.get_json(silent=True) or {}
+    if event.get("type") == "payment.failed":
+        invoice_id = (event.get("data") or {}).get("invoice_id")
+        if not invoice_id:
+            return problem(400, "Missing invoice_id", "payment.failed event has no data.invoice_id")
+        # The job owns the FP-12 schedule (days 1, 3, 7, 14) and the
+        # "no retry while a refund is in progress" check; this starts attempt 1.
+        queue.enqueue(
+            "invoices.retry_payment",
+            {"invoice_id": invoice_id, "attempt": 1},
+            dedupe_key=f"dunning:{invoice_id}:1",
+        )
+        log.info("payment_retry_enqueued", invoice_id=invoice_id)
     return "", 204
