 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    Rates come from the ECB euro reference feed (``ECB_FEED_URL``), which is
+    EUR-based, so each rate is divided by the USD rate. The ECB publishes no
+    rates on weekends/holidays, so the latest published date on or before
+    ``day`` is used.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    root = ET.fromstring(resp.content)
+
+    by_date = {}
+    for cube in root.iter():
+        if cube.tag.rsplit("}", 1)[-1] == "Cube" and "time" in cube.attrib:
+            by_date[cube.attrib["time"]] = {
+                c.attrib["currency"]: Decimal(c.attrib["rate"])
+                for c in cube
+                if "currency" in c.attrib
+            }
+
+    wanted = day.isoformat()
+    dates = [d for d in by_date if d <= wanted]
+    if not dates:
+        raise ValueError(f"no ECB rates published on or before {wanted}")
+    eur_rates = by_date[max(dates)]
+    if "USD" not in eur_rates:
+        raise ValueError("ECB feed has no USD rate")
+
+    usd = eur_rates["USD"]
+    rates = {cur: rate / usd for cur, rate in eur_rates.items()}
+    rates["EUR"] = Decimal(1) / usd
+    rates["USD"] = Decimal(1)
+    return rates
 
 
