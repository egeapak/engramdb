+"""Write the month's finalized invoices to a CSV that Finance imports."""
 import argparse
+import csv
 import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+# finalized_at is stored as naive UTC; see docs/ops/backfills.md
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(now=None):
+    now = now or datetime.now(timezone.utc)
+    return f"{now.year - 1}-12" if now.month == 1 else f"{now.year}-{now.month - 1:02d}"
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def write_csv(rows, path):
+    """Finance's German-locale import wants ';' delimiters, DD.MM.YYYY dates, UTF-8 without BOM."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\n")
+        writer.writerow(["invoice_id", "customer_id", "subtotal_cents", "tax_cents", "total_cents", "finalized_date"])
+        for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+            writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%d.%m.%Y")])
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--output", type=Path, help="CSV path (default: exports/<YYYY-MM>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    month = args.month or previous_month()
+    start, end = month_window(month)
+    print(f"exporting {args.env} {month} to {bucket} (dry_run={args.dry_run})")
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    rows = fetch_rows(database_url, start, end)
+    output = args.output or Path("exports") / month / "invoices.csv"
+    if args.dry_run:
+        print(f"would write {len(rows)} invoices to {output} (nothing written)")
+        return 0
+    write_csv(rows, output)
+    print(f"wrote {len(rows)} invoices to {output}")
+    return 0
 
 
 if __name__ == "__main__":
-    main()
