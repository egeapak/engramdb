 """Follow-up when a customer's payment fails."""
+from datetime import datetime, timedelta, timezone
 
+import structlog
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+from src.jobs.queue import enqueue
+
+log = structlog.get_logger()
+
+# Days after the failure on which to retry the charge (finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None, refund_in_progress=False):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `dunning.retry_charge` job per day in RETRY_DAYS, counted from
+    `failed_at` (defaults to now, UTC). Returns the list of run times. An
+    invoice with a refund in progress is never retried.
+    """
+    if refund_in_progress:
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    run_times = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        enqueue(
+            "dunning.retry_charge",
+            {"invoice_id": invoice.id, "attempt": attempt},
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        run_times.append(run_at)
+
+    log.info("dunning_retries_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id, attempts=len(run_times))
+    return run_times
