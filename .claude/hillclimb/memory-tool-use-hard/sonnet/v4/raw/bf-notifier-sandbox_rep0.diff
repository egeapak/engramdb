+"""Integration test: sends one real email through the provider sandbox.
+
+Needs MAIL_API_KEY (sandbox key) and SINK_INBOX_URL (the sink inbox API
+endpoint that lists messages for a recipient). Skipped when either is unset.
+
+The sandbox silently drops mail to anything outside @sink.acme.test and is
+capped at 500 messages/day for the whole team, so this sends exactly one.
+"""
+import os
+import time
+import uuid
+
+import pytest
+import requests
+
+from notifier import email
+
+SINK_ADDR = "receipts@sink.acme.test"
+
+pytestmark = pytest.mark.skipif(
+    not (os.environ.get("MAIL_API_KEY") and os.environ.get("SINK_INBOX_URL")),
+    reason="MAIL_API_KEY and SINK_INBOX_URL are required",
+)
+
+
+def _find_message(invoice_id, timeout=30, interval=2):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["SINK_INBOX_URL"],
+            params={"to": SINK_ADDR},
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        # Assumed response shape: a JSON list of {"id", "to", "subject", "html"}.
+        for msg in resp.json():
+            if invoice_id in msg.get("html", ""):
+                return msg
+        time.sleep(interval)
+    return None
+
+
+def test_send_receipt_is_delivered_to_sandbox_sink():
+    # Unique id so we match our message, not one left by an earlier run.
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+
+    message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+    assert message_id
+
+    msg = _find_message(invoice_id)
+    assert msg is not None, f"receipt for {invoice_id} not delivered to {SINK_ADDR}"
+    assert msg["subject"] == "Your receipt"
