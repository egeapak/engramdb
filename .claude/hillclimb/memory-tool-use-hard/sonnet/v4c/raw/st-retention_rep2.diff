diff --git a/scripts/purge_invoices.py b/scripts/purge_invoices.py
new file mode 100644
index 0000000..c53289b
--- /dev/null
+++ b/scripts/purge_invoices.py
@@ -0,0 +1,66 @@
+"""Delete invoices (with their lines and settled refunds) past the retention period.
+
+Dry-run by default: prints what would be purged. Pass --execute to delete.
+"""
+import argparse
+import os
+import sys
+
+RETENTION_DAYS = 3650  # legal defines the period in days (10 years after finalization)
+MAX_SAFE_BATCH = 500  # larger batches hold row locks long enough to time out checkout (INC-2291)
+
+# Finalized before the cutoff, and no open refund. Unfinalized invoices (NULL) never match.
+ELIGIBLE = """
+    FROM invoices i
+    WHERE i.finalized_at < now() - make_interval(days => %(days)s)
+      AND NOT EXISTS (SELECT 1 FROM refunds r WHERE r.invoice_id = i.id AND r.status = 'open')
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
+    parser.add_argument("--batch-size", type=int, default=MAX_SAFE_BATCH)
+    args = parser.parse_args()
+    if not 0 < args.batch_size <= MAX_SAFE_BATCH:
+        print(f"--batch-size must be between 1 and {MAX_SAFE_BATCH}", file=sys.stderr)
+        return 3
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        print(f"no DATABASE_URL set; would purge invoices finalized more than {RETENTION_DAYS} days ago "
+              "(nothing written)")
+        return 0
+
+    import psycopg
+
+    params = {"days": RETENTION_DAYS}
+    # Deployed DBs sit behind a transaction-mode pooler: no server-side prepared statements.
+    with psycopg.connect(url, prepare_threshold=None) as conn:
+        if not args.execute:
+            (count,) = conn.execute("SELECT count(*) " + ELIGIBLE, params).fetchone()
+            print(f"dry run: {count} invoices finalized more than {RETENTION_DAYS} days ago would be purged; "
+                  "pass --execute to delete")
+            return 0
+
+        purged = 0
+        while True:
+            # One short transaction per batch; never held open across other work.
+            with conn.transaction():
+                ids = [row[0] for row in conn.execute(
+                    "SELECT i.id " + ELIGIBLE + " ORDER BY i.id LIMIT %(n)s FOR UPDATE OF i SKIP LOCKED",
+                    {**params, "n": args.batch_size})]
+                if not ids:
+                    break
+                # Re-check for open refunds at delete time via the FOR UPDATE lock above;
+                # settled refunds and lines reference the invoice, so they go first.
+                conn.execute("DELETE FROM invoice_lines WHERE invoice_id = ANY(%s)", (ids,))
+                conn.execute("DELETE FROM refunds WHERE invoice_id = ANY(%s) AND status = 'settled'", (ids,))
+                conn.execute("DELETE FROM invoices WHERE id = ANY(%s)", (ids,))
+            purged += len(ids)
+            print(f"purged {purged} invoices so far")
+        print(f"done: purged {purged} invoices finalized more than {RETENTION_DAYS} days ago")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
