+"""Export one month's finalized invoices as a CSV for Finance's accounting import."""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime
+
+# Finance's accounting tool (switched from the German-locale one) takes plain
+# comma-separated files with ISO dates. UTF-8 without BOM. Amounts are integer cents.
+DELIMITER = ","
+DATE_FORMAT = "%Y-%m-%d"
+HEADER = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+QUERY = """
+    SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+    FROM invoices
+    WHERE finalized_at >= %s AND finalized_at < %s
+    ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC; see docs/ops/backfills.md
+    if os.environ.get("TZ") != "UTC":
+        raise RuntimeError(f"month window for {month} is ambiguous (zone not pinned); run with TZ=UTC")
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(today=None):
+    today = today or datetime.utcnow()
+    return f"{today.year - 1}-12" if today.month == 1 else f"{today.year}-{today.month - 1:02d}"
+
+
+def fetch_rows(start, end):
+    import psycopg
+
+    url = os.environ.get("DATABASE_URL")
+    if not url:
+        raise RuntimeError("DATABASE_URL is not set")
+    # Deployed DBs sit behind a transaction-mode pooler: no server-side prepared statements.
+    with psycopg.connect(url, prepare_threshold=None) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    buf = io.StringIO()
+    writer = csv.writer(buf, delimiter=DELIMITER, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime(DATE_FORMAT)])
+    return buf.getvalue()
+
+
+def upload(bucket, key, body):
+    import boto3
+
+    boto3.client("s3").put_object(Bucket=bucket, Key=key, Body=body.encode("utf-8"), ContentType="text/csv; charset=utf-8")
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
-    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--month", help="YYYY-MM (default: previous month)")
+    parser.add_argument("--dry-run", action="store_true", help="print the CSV instead of uploading it")
     args = parser.parse_args()
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    month = args.month or previous_month()
+    start, end = month_window(month)
+    print(f"exporting {args.env} {month} to {bucket} (dry_run={args.dry_run})", file=sys.stderr)
+
+    body = render_csv(fetch_rows(start, end))
+    if args.dry_run:
+        sys.stdout.write(body)
+        return 0
+    key = f"exports/{month}/invoices.csv"
+    upload(bucket, key, body)
+    print(f"wrote s3://{bucket}/{key} ({body.count(chr(10)) - 1} invoices)", file=sys.stderr)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
