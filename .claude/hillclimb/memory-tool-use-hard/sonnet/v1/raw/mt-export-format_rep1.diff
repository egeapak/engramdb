+"""Export the month's finalized invoices as a CSV for Finance's accounting import.
+
+Finance's accounting tool takes plain comma-separated files with ISO (YYYY-MM-DD)
+dates, UTF-8 without BOM. Amounts are integer cents. Drafts (finalized_at IS NULL)
+are excluded; zero-amount invoices are included.
+"""
 import argparse
+import csv
+import io
 import os
+import sys
+from datetime import datetime
+from pathlib import Path
+
+COLUMNS = ["invoice_id", "customer_id", "subtotal", "tax", "total", "finalized_date"]
+
+QUERY = """
+SELECT id, customer_id, subtotal_cents, tax_cents, finalized_at
+FROM invoices
+WHERE finalized_at >= %s AND finalized_at < %s
+ORDER BY finalized_at, id
+"""
+
+
+def month_window(month):
+    # finalized_at is stored as naive UTC, so the window is naive too (no host zone involved)
+    start = datetime.strptime(month, "%Y-%m")
+    end = start.replace(year=start.year + 1, month=1) if start.month == 12 else start.replace(month=start.month + 1)
+    return start, end
+
+
+def previous_month(today=None):
+    today = today or datetime.utcnow()
+    year, month = (today.year - 1, 12) if today.month == 1 else (today.year, today.month - 1)
+    return f"{year:04d}-{month:02d}"
+
+
+def fetch_rows(database_url, start, end):
+    import psycopg
+
+    with psycopg.connect(database_url) as conn:
+        return conn.execute(QUERY, (start, end)).fetchall()
+
+
+def render_csv(rows):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice_id, customer_id, subtotal, tax, finalized_at in rows:
+        writer.writerow([invoice_id, customer_id, subtotal, tax, subtotal + tax, finalized_at.strftime("%Y-%m-%d")])
+    return out.getvalue()
 
 
 def main():
     parser = argparse.ArgumentParser(description="Export monthly invoice reports.")
     parser.add_argument("--env", default="dev", choices=["dev", "staging", "prod"])
+    parser.add_argument("--month", default=None, help="YYYY-MM (default: previous month, UTC)")
+    parser.add_argument("--out", type=Path, default=None, help="local file to write (default: exports/<YYYY-MM>/invoices.csv)")
     parser.add_argument("--dry-run", action="store_true")
     args = parser.parse_args()
+    month = args.month or previous_month()
+    start, end = month_window(month)
     bucket = os.environ.get("EXPORT_BUCKET", "ledgerline-exports-dev")
-    print(f"exporting {args.env} to {bucket} (dry_run={args.dry_run})")
+    key = f"exports/{month}/invoices.csv"
+    print(f"exporting {args.env} {month} to {bucket}/{key} (dry_run={args.dry_run})")
+
+    database_url = os.environ.get("DATABASE_URL")
+    if not database_url:
+        print("DATABASE_URL is not set", file=sys.stderr)
+        return 1
+    rows = fetch_rows(database_url, start, end)
+    data = render_csv(rows)
+    print(f"{len(rows)} finalized invoices in {month}")
+    if args.dry_run:
+        return 0
+
+    out = args.out or Path(key)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_bytes(data.encode("utf-8"))
+    print(f"wrote {out}")
+    return 0
 
 
