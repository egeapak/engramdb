 """Follow-up when a customer's payment fails."""
 
+from datetime import datetime, timedelta, timezone
 
-def schedule_retries(invoice):
-    """Plan the payment retries for an invoice whose charge just failed."""
-    raise NotImplementedError
+import structlog
+
+from src.jobs import queue
+
+log = structlog.get_logger()
+
+# Days after the failure on which the charge is retried (finance policy FP-12).
+RETRY_DAYS = (1, 3, 7, 14)
+
+
+def schedule_retries(invoice, failed_at=None):
+    """Plan the payment retries for an invoice whose charge just failed.
+
+    Enqueues one `invoices.retry_payment` job per retry day and returns the
+    list of (attempt, run_at) pairs. The last attempt's job is responsible for
+    marking the invoice `uncollectible` if it also fails. Nothing is scheduled
+    when a refund is in progress for the invoice.
+    """
+    if getattr(invoice, "refund_in_progress", False):
+        log.info("dunning_skipped_refund_in_progress", invoice_id=invoice.id)
+        return []
+
+    failed_at = failed_at or datetime.now(timezone.utc)
+    plan = []
+    for attempt, days in enumerate(RETRY_DAYS, start=1):
+        run_at = failed_at + timedelta(days=days)
+        queue.enqueue(
+            "invoices.retry_payment",
+            {
+                "invoice_id": invoice.id,
+                "attempt": attempt,
+                "final": attempt == len(RETRY_DAYS),
+            },
+            dedupe_key=f"dunning:{invoice.id}:{attempt}",
+            run_at=run_at,
+        )
+        plan.append((attempt, run_at))
+    log.info("dunning_scheduled", invoice_id=invoice.id, customer_id=invoice.customer_id)
+    return plan
