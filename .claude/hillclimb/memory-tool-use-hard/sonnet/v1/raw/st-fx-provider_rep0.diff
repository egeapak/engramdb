 def fetch_rates(day):
-    """Return {currency: Decimal rate against USD} for the given date."""
-    raise NotImplementedError
+    """Return {currency: Decimal rate against USD} for the given date.
+
+    `day` is an ISO date string (YYYY-MM-DD). Rates come from the ECB euro
+    reference feed at ECB_FEED_URL, which is EUR-based, so each rate is divided
+    by the feed's USD rate to give units of currency per 1 USD.
+    """
+    resp = requests.get(os.environ["ECB_FEED_URL"], timeout=10)
+    resp.raise_for_status()
+    for cube in ET.fromstring(resp.content).iter():
+        if cube.tag.rpartition("}")[2] == "Cube" and cube.get("time") == str(day):
+            quotes = {c.get("currency"): Decimal(c.get("rate")) for c in cube if c.get("currency")}
+            break
+    else:
+        raise LookupError(f"no ECB rates published for {day}")
+    if "USD" not in quotes:
+        raise LookupError(f"ECB feed has no USD rate for {day}")
+    usd = quotes.pop("USD")
+    rates = {code: rate / usd for code, rate in quotes.items()}
+    rates["EUR"] = 1 / usd
+    return rates
 
 
