diff --git a/src/api/refunds.py b/src/api/refunds.py
new file mode 100644
index 0000000..a520942
--- /dev/null
+++ b/src/api/refunds.py
@@ -0,0 +1,51 @@
+import time
+
+from flask import Blueprint, jsonify, request
+
+from ..billing.refunds import refund
+from .errors import problem
+from .invoices import _INVOICES
+
+bp = Blueprint("refunds", __name__)
+
+APPROVAL_THRESHOLD_CENTS = 50_000
+IDEMPOTENCY_TTL_SECONDS = 24 * 60 * 60
+
+# (invoice_id, idempotency key) -> (stored_at, body, status_code)
+_REPLAY = {}
+
+
+@bp.post("/invoices/<invoice_id>/refunds")
+def create_refund(invoice_id):
+    key = request.headers.get("X-Acme-Idempotency")
+    if not key:
+        return problem(428, "Idempotency header required", "X-Acme-Idempotency is required")
+
+    now = time.time()
+    stored = _REPLAY.get((invoice_id, key))
+    if stored and now - stored[0] < IDEMPOTENCY_TTL_SECONDS:
+        resp = jsonify(stored[1])
+        resp.status_code = stored[2]
+        return resp
+
+    invoice = _INVOICES.get(invoice_id)
+    if invoice is None:
+        return problem(404, "Invoice not found")
+
+    payload = request.get_json(silent=True) or {}
+    amount = payload.get("amount_cents")
+    if isinstance(amount, bool) or not isinstance(amount, int) or amount <= 0:
+        return problem(422, "Invalid refund", "amount_cents must be a positive integer")
+
+    try:
+        result = refund(invoice, amount)
+    except ValueError as exc:
+        return problem(422, "Invalid refund", str(exc))
+
+    # Large refunds need a second approver; they are not issued directly.
+    status = "pending_approval" if amount > APPROVAL_THRESHOLD_CENTS else "issued"
+    body = {**result, "status": status}
+    _REPLAY[(invoice_id, key)] = (now, body, 201)
+    resp = jsonify(body)
+    resp.status_code = 201
+    return resp
