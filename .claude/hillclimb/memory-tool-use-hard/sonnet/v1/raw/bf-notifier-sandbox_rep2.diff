+"""Integration test: sends one real message through the provider sandbox.
+
+Needs MAIL_API_KEY (sandbox key from the dev secrets store) and
+MAIL_SINK_INBOX_URL (the sink inbox API endpoint for receipts@sink.acme.test).
+Skipped when either is missing.
+
+The sandbox is capped at 500 messages/day for the whole team and silently
+drops mail to any domain other than @sink.acme.test, so this sends exactly one
+message, to that domain.
+"""
+import os
+import time
+import uuid
+from unittest import mock
+
+import pytest
+import requests
+
+from notifier import email
+
+pytestmark = pytest.mark.skipif(
+    not (os.environ.get("MAIL_API_KEY") and os.environ.get("MAIL_SINK_INBOX_URL")),
+    reason="MAIL_API_KEY and MAIL_SINK_INBOX_URL required for sandbox integration test",
+)
+
+SINK_ADDR = "receipts@sink.acme.test"
+
+
+def _find_in_sink(marker, timeout=30):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        resp = requests.get(
+            os.environ["MAIL_SINK_INBOX_URL"],
+            headers={"Authorization": f"Bearer {os.environ['MAIL_API_KEY']}"},
+            timeout=10,
+        )
+        resp.raise_for_status()
+        for msg in resp.json():
+            if marker in str(msg):
+                return msg
+        time.sleep(2)
+    return None
+
+
+def test_send_receipt_is_delivered_to_sandbox_sink():
+    invoice_id = f"inv_it_{uuid.uuid4().hex[:12]}"
+    # render() is not implemented yet, so stub only the template step; the
+    # provider call and delivery are real.
+    body = f"<p>Receipt for {invoice_id}</p>"
+    with mock.patch.object(email, "render", return_value=body):
+        message_id = email.send_receipt(invoice_id, SINK_ADDR, 1200)
+
+    assert message_id
+
+    delivered = _find_in_sink(invoice_id)
+    assert delivered is not None, f"{invoice_id} not found in sink inbox"
