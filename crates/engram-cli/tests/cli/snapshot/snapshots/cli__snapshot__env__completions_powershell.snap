            [CompletionResult]::new('--decay-half-life', '--decay-half-life', [CompletionResultType]::ParameterName, 'Half-life in seconds for decay')
            [CompletionResult]::new('--decay-ttl', '--decay-ttl', [CompletionResultType]::ParameterName, 'TTL in seconds for decay')
