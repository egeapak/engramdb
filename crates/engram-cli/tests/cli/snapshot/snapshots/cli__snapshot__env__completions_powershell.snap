---
source: crates/engram-cli/tests/cli/snapshot/env.rs
expression: "f.run_bare(&[\"completions\", shell])"
---
$ engramdb completions powershell
exit: 0
--- stdout ---

using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'engramdb' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'engramdb'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'engramdb' {
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format')
            [CompletionResult]::new('--dir', '--dir', [CompletionResultType]::ParameterName, 'Working directory (default: current directory)')
            [CompletionResult]::new('--embedding-backend', '--embedding-backend', [CompletionResultType]::ParameterName, 'Embedding backend: auto, onnx, or ollama')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Output as JSON')
            [CompletionResult]::new('-q', '-q', [CompletionResultType]::ParameterName, 'Suppress non-essential output')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Suppress non-essential output')
            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'Verbose output')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'Verbose output')
            [CompletionResult]::new('--no-color', '--no-color', [CompletionResultType]::ParameterName, 'No colored output')
            [CompletionResult]::new('--in-process', '--in-process', [CompletionResultType]::ParameterName, 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1')
            [CompletionResult]::new('--spawn-daemon', '--spawn-daemon', [CompletionResultType]::ParameterName, 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)')
            [CompletionResult]::new('--no-maintenance', '--no-maintenance', [CompletionResultType]::ParameterName, 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Initialize a new EngramDB store')
            [CompletionResult]::new('add', 'add', [CompletionResultType]::ParameterValue, 'Add a new memory')
            [CompletionResult]::new('get', 'get', [CompletionResultType]::ParameterValue, 'Get a memory by ID')
            [CompletionResult]::new('query', 'query', [CompletionResultType]::ParameterValue, 'Query memories (unified ranked / filtered retrieval)')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'List all memories')
            [CompletionResult]::new('update', 'update', [CompletionResultType]::ParameterValue, 'Update an existing memory')
            [CompletionResult]::new('delete', 'delete', [CompletionResultType]::ParameterValue, 'Delete a memory')
            [CompletionResult]::new('task', 'task', [CompletionResultType]::ParameterValue, 'Task lifecycle: declare or complete the task this session works on')
            [CompletionResult]::new('verify', 'verify', [CompletionResultType]::ParameterValue, 'Confirm a memory is still accurate (stamps verified_at; clears doctor-flagged needs_review)')
            [CompletionResult]::new('config', 'config', [CompletionResultType]::ParameterValue, 'Show effective config values, thresholds, and the store''s top tags')
            [CompletionResult]::new('stats', 'stats', [CompletionResultType]::ParameterValue, 'Show statistics')
            [CompletionResult]::new('doctor', 'doctor', [CompletionResultType]::ParameterValue, 'Check environment and store health')
            [CompletionResult]::new('projects', 'projects', [CompletionResultType]::ParameterValue, 'Manage registered EngramDB projects')
            [CompletionResult]::new('harvest', 'harvest', [CompletionResultType]::ParameterValue, 'Inspect past Claude Code sessions for knowledge worth remembering')
            [CompletionResult]::new('groups', 'groups', [CompletionResultType]::ParameterValue, 'Manage multi-project memory groups and this project''s subscriptions')
            [CompletionResult]::new('challenge', 'challenge', [CompletionResultType]::ParameterValue, 'Challenge a memory''s validity')
            [CompletionResult]::new('gc', 'gc', [CompletionResultType]::ParameterValue, 'Run garbage collection on low-relevance memories')
            [CompletionResult]::new('compress', 'compress', [CompletionResultType]::ParameterValue, 'List compression candidates (actual compression requires MCP mode)')
            [CompletionResult]::new('serve', 'serve', [CompletionResultType]::ParameterValue, 'Start the MCP server')
            [CompletionResult]::new('daemon', 'daemon', [CompletionResultType]::ParameterValue, 'Run the shared embedding daemon (normally auto-spawned by MCP)')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Generate shell completions')
            [CompletionResult]::new('migrate', 'migrate', [CompletionResultType]::ParameterValue, 'Migrate memory files to the latest format version')
            [CompletionResult]::new('rollback', 'rollback', [CompletionResultType]::ParameterValue, 'Roll back memory files to a previous format version')
            [CompletionResult]::new('reindex', 'reindex', [CompletionResultType]::ParameterValue, 'Rebuild index and re-embed memories')
            [CompletionResult]::new('hook', 'hook', [CompletionResultType]::ParameterValue, 'Claude Code plugin hook handler')
            [CompletionResult]::new('setup', 'setup', [CompletionResultType]::ParameterValue, 'Set up Claude Code integration (hooks, MCP, ENGRAM.md, CLAUDE.md)')
            [CompletionResult]::new('review', 'review', [CompletionResultType]::ParameterValue, 'Interactive review of challenged/stale memories')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'engramdb;init' {
            [CompletionResult]::new('--template', '--template', [CompletionResultType]::ParameterName, 'Path to a config template file')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Output format')
            [CompletionResult]::new('--dir', '--dir', [CompletionResultType]::ParameterName, 'Working directory (default: current directory)')
            [CompletionResult]::new('--embedding-backend', '--embedding-backend', [CompletionResultType]::ParameterName, 'Embedding backend: auto, onnx, or ollama')
            [CompletionResult]::new('--no-embeddings', '--no-embeddings', [CompletionResultType]::ParameterName, 'Skip embedding model initialization')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Output as JSON')
            [CompletionResult]::new('-q', '-q', [CompletionResultType]::ParameterName, 'Suppress non-essential output')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Suppress non-essential output')
            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'Verbose output')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'Verbose output')
            [CompletionResult]::new('--no-color', '--no-color', [CompletionResultType]::ParameterName, 'No colored output')
            [CompletionResult]::new('--in-process', '--in-process', [CompletionResultType]::ParameterName, 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1')
            [CompletionResult]::new('--spawn-daemon', '--spawn-daemon', [CompletionResultType]::ParameterName, 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)')
            [CompletionResult]::new('--no-maintenance', '--no-maintenance', [CompletionResultType]::ParameterName, 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'engramdb;add' {
            [CompletionResult]::new('-t', '-t', [CompletionResultType]::ParameterName, 'Type of memory')
            [CompletionResult]::new('--type', '--type', [CompletionResultType]::ParameterName, 'Type of memory')
            [CompletionResult]::new('-c', '-c', [CompletionResultType]::ParameterName, 'Memory content')
            [CompletionResult]::new('--content', '--content', [CompletionResultType]::ParameterName, 'Memory content')
            [CompletionResult]::new('-s', '-s', [CompletionResultType]::ParameterName, 'Brief summary (required; prompted for in an interactive terminal)')
            [CompletionResult]::new('--summary', '--summary', [CompletionResultType]::ParameterName, 'Brief summary (required; prompted for in an interactive terminal)')
            [CompletionResult]::new('-T', '-T ', [CompletionResultType]::ParameterName, 'Short title (a few words) for human-readable filenames')
            [CompletionResult]::new('--title', '--title', [CompletionResultType]::ParameterName, 'Short title (a few words) for human-readable filenames')
            [CompletionResult]::new('-p', '-p', [CompletionResultType]::ParameterName, 'Physical scope (file paths or globs, can be repeated)')
            [CompletionResult]::new('--physical', '--physical', [CompletionResultType]::ParameterName, 'Physical scope (file paths or globs, can be repeated)')
            [CompletionResult]::new('-l', '-l', [CompletionResultType]::ParameterName, 'Logical scope (dot-notation domains, can be repeated)')
            [CompletionResult]::new('--logical', '--logical', [CompletionResultType]::ParameterName, 'Logical scope (dot-notation domains, can be repeated)')
            [CompletionResult]::new('--tags', '--tags', [CompletionResultType]::ParameterName, 'Tags (comma-separated or repeated)')
            [CompletionResult]::new('--criticality', '--criticality', [CompletionResultType]::ParameterName, 'Criticality score (0.0 to 1.0)')
            [CompletionResult]::new('--confidence', '--confidence', [CompletionResultType]::ParameterName, 'Confidence score (0.0 to 1.0)')
            [CompletionResult]::new('--details', '--details', [CompletionResultType]::ParameterName, 'Extended details')
            [CompletionResult]::new('--visibility', '--visibility', [CompletionResultType]::ParameterName, 'Visibility (shared or personal)')
            [CompletionResult]::new('--audience', '--audience', [CompletionResultType]::ParameterName, 'Audience for a group/global share: project and/or group ids that may see this memory (comma-separated). Omit for whole-group visibility. Only meaningful with --group or --global')
