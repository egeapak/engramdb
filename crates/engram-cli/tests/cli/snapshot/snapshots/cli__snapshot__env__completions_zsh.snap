---
source: crates/engram-cli/tests/cli/snapshot/env.rs
expression: "f.run_bare(&[\"completions\", shell])"
---
$ engramdb completions zsh
exit: 0
--- stdout ---
#compdef engramdb

autoload -U is-at-least

_engramdb() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(--json)--format=[Output format]:FORMAT:((pretty\:"Human-friendly colored output with formatting"
json\:"JSON output for programmatic parsing"
plain\:"Plain text output without colors"))' \
'--dir=[Working directory (default\: current directory)]:DIR:_files' \
'--embedding-backend=[Embedding backend\: auto, onnx, or ollama]:EMBEDDING_BACKEND:_default' \
'--json[Output as JSON]' \
'-q[Suppress non-essential output]' \
'--quiet[Suppress non-essential output]' \
'-v[Verbose output]' \
'--verbose[Verbose output]' \
'--no-color[No colored output]' \
'--in-process[Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1]' \
'--spawn-daemon[Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)]' \
'--no-maintenance[Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_engramdb_commands" \
"*::: :->engramdb" \
&& ret=0
    case $state in
    (engramdb)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:engramdb-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--template=[Path to a config template file]:TEMPLATE:_files' \
'(--json)--format=[Output format]:FORMAT:((pretty\:"Human-friendly colored output with formatting"
json\:"JSON output for programmatic parsing"
plain\:"Plain text output without colors"))' \
'--dir=[Working directory (default\: current directory)]:DIR:_files' \
'--embedding-backend=[Embedding backend\: auto, onnx, or ollama]:EMBEDDING_BACKEND:_default' \
'--no-embeddings[Skip embedding model initialization]' \
'--json[Output as JSON]' \
'-q[Suppress non-essential output]' \
