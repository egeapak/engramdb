(( $+functions[_engramdb__subcmd__groups_commands] )) ||
_engramdb__subcmd__groups_commands() {
    local commands; commands=(
'create:Create a named group store (idempotent; prints its group id)' \
'subscribe:Subscribe the current project to a group (creating the group if needed)' \
'unsubscribe:Unsubscribe the current project from a group (forgiving if not subscribed)' \
'list:List all known groups and the current project'\''s subscriptions' \
'members:List the projects subscribed to a group (its blast radius) and how many memories the group holds' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'engramdb groups commands' commands "$@"
}
