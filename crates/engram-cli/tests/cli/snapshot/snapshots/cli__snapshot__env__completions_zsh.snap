(( $+functions[_engramdb__subcmd__harvest_commands] )) ||
_engramdb__subcmd__harvest_commands() {
    local commands; commands=(
'list:List past sessions in scope, newest activity first' \
'show:Print a budgeted digest of one session' \
'mark:Record that a session has been reviewed, so it is not offered again' \
'index:Index one or more sessions for \`harvest search\`' \
'search:Search indexed past conversations' \
'summary:Set or replace a session'\''s curated summary, re-embedding only it' \
'reset:Forget a session'\''s harvest record so it is offered again' \
'ledger:Inspect and manage the harvest ledger and its transcript archives' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'engramdb harvest commands' commands "$@"
}
