(( $+functions[_engramdb__subcmd__daemon_commands] )) ||
_engramdb__subcmd__daemon_commands() {
    local commands; commands=(
'run:Run the daemon event loop (this is what MCP auto-spawns)' \
'status:Show whether a daemon is running and its request metrics' \
'stop:Ask a running daemon to exit gracefully' \
'restart:Stop a running daemon (if any) and start a fresh one' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'engramdb daemon commands' commands "$@"
}
