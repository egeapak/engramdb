            cand --stale-only 'Only show Status::NeedsReview memories'
            cand --global 'Review the global (cross-project) memory store instead of the current project'
            cand --json 'Output as JSON'
            cand -q 'Suppress non-essential output'
            cand --quiet 'Suppress non-essential output'
            cand -v 'Verbose output'
            cand --verbose 'Verbose output'
            cand --no-color 'No colored output'
            cand --in-process 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1'
            cand --spawn-daemon 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)'
            cand --no-maintenance 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'engramdb;help'= {
            cand init 'Initialize a new EngramDB store'
            cand add 'Add a new memory'
            cand get 'Get a memory by ID'
            cand query 'Query memories (unified ranked / filtered retrieval)'
            cand list 'List all memories'
            cand update 'Update an existing memory'
            cand delete 'Delete a memory'
            cand task 'Task lifecycle: declare or complete the task this session works on'
            cand verify 'Confirm a memory is still accurate (stamps verified_at; clears doctor-flagged needs_review)'
            cand config 'Show effective config values, thresholds, and the store''s top tags'
            cand stats 'Show statistics'
            cand doctor 'Check environment and store health'
            cand projects 'Manage registered EngramDB projects'
            cand harvest 'Inspect past Claude Code sessions for knowledge worth remembering'
            cand groups 'Manage multi-project memory groups and this project''s subscriptions'
            cand challenge 'Challenge a memory''s validity'
            cand gc 'Run garbage collection on low-relevance memories'
            cand compress 'List compression candidates (actual compression requires MCP mode)'
            cand serve 'Start the MCP server'
            cand daemon 'Run the shared embedding daemon (normally auto-spawned by MCP)'
            cand completions 'Generate shell completions'
            cand migrate 'Migrate memory files to the latest format version'
            cand rollback 'Roll back memory files to a previous format version'
            cand reindex 'Rebuild index and re-embed memories'
            cand hook 'Claude Code plugin hook handler'
            cand setup 'Set up Claude Code integration (hooks, MCP, ENGRAM.md, CLAUDE.md)'
            cand review 'Interactive review of challenged/stale memories'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
