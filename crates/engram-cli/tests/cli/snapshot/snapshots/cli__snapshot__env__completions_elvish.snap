---
source: crates/engram-cli/tests/cli/snapshot/env.rs
expression: "f.run_bare(&[\"completions\", shell])"
---
$ engramdb completions elvish
exit: 0
--- stdout ---

use builtin;
use str;

set edit:completion:arg-completer[engramdb] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'engramdb'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'engramdb'= {
            cand --format 'Output format'
            cand --dir 'Working directory (default: current directory)'
            cand --embedding-backend 'Embedding backend: auto, onnx, or ollama'
            cand --json 'Output as JSON'
            cand -q 'Suppress non-essential output'
            cand --quiet 'Suppress non-essential output'
            cand -v 'Verbose output'
            cand --verbose 'Verbose output'
            cand --no-color 'No colored output'
            cand --in-process 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1'
            cand --spawn-daemon 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)'
            cand --no-maintenance 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand init 'Initialize a new EngramDB store'
            cand add 'Add a new memory'
            cand get 'Get a memory by ID'
            cand query 'Query memories (unified ranked / filtered retrieval)'
            cand list 'List all memories'
            cand update 'Update an existing memory'
            cand delete 'Delete a memory'
            cand task 'Task lifecycle: declare or complete the task this session works on'
            cand verify 'Confirm a memory is still accurate (stamps verified_at; clears doctor-flagged needs_review)'
            cand config 'Show effective config values, thresholds, and the store''s top tags'
            cand stats 'Show statistics'
            cand doctor 'Check environment and store health'
            cand projects 'Manage registered EngramDB projects'
            cand harvest 'Inspect past Claude Code sessions for knowledge worth remembering'
            cand groups 'Manage multi-project memory groups and this project''s subscriptions'
            cand challenge 'Challenge a memory''s validity'
            cand gc 'Run garbage collection on low-relevance memories'
            cand compress 'List compression candidates (actual compression requires MCP mode)'
            cand serve 'Start the MCP server'
            cand daemon 'Run the shared embedding daemon (normally auto-spawned by MCP)'
            cand completions 'Generate shell completions'
            cand migrate 'Migrate memory files to the latest format version'
            cand rollback 'Roll back memory files to a previous format version'
            cand reindex 'Rebuild index and re-embed memories'
            cand hook 'Claude Code plugin hook handler'
            cand setup 'Set up Claude Code integration (hooks, MCP, ENGRAM.md, CLAUDE.md)'
            cand review 'Interactive review of challenged/stale memories'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'engramdb;init'= {
            cand --template 'Path to a config template file'
            cand --format 'Output format'
            cand --dir 'Working directory (default: current directory)'
            cand --embedding-backend 'Embedding backend: auto, onnx, or ollama'
            cand --no-embeddings 'Skip embedding model initialization'
            cand --json 'Output as JSON'
            cand -q 'Suppress non-essential output'
            cand --quiet 'Suppress non-essential output'
            cand -v 'Verbose output'
            cand --verbose 'Verbose output'
            cand --no-color 'No colored output'
            cand --in-process 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1'
            cand --spawn-daemon 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)'
            cand --no-maintenance 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'engramdb;add'= {
            cand -t 'Type of memory'
            cand --type 'Type of memory'
            cand -c 'Memory content'
            cand --content 'Memory content'
            cand -s 'Brief summary (required; prompted for in an interactive terminal)'
            cand --summary 'Brief summary (required; prompted for in an interactive terminal)'
            cand -T 'Short title (a few words) for human-readable filenames'
            cand --title 'Short title (a few words) for human-readable filenames'
            cand -p 'Physical scope (file paths or globs, can be repeated)'
            cand --physical 'Physical scope (file paths or globs, can be repeated)'
            cand -l 'Logical scope (dot-notation domains, can be repeated)'
            cand --logical 'Logical scope (dot-notation domains, can be repeated)'
            cand --tags 'Tags (comma-separated or repeated)'
            cand --criticality 'Criticality score (0.0 to 1.0)'
            cand --confidence 'Confidence score (0.0 to 1.0)'
            cand --details 'Extended details'
            cand --visibility 'Visibility (shared or personal)'
            cand --audience 'Audience for a group/global share: project and/or group ids that may see this memory (comma-separated). Omit for whole-group visibility. Only meaningful with --group or --global'
            cand --supersedes 'IDs of memories this one supersedes (comma-separated)'
            cand --epistemic 'Epistemic class: fact, observation, or decision (defaults from type)'
            cand --premise 'Premise this memory depends on (e.g. "while we pin ort rc.12")'
            cand --invalidated-by 'Paths/globs whose change invalidates this memory (repeatable)'
            cand --origin-task 'Task/feature this memory was created for'
            cand --generality 'Generality: project (default) or task'
            cand --valid-from 'Valid-time start (RFC3339) — backdate when the claim became true'
            cand --decay-strategy 'Decay strategy: none, linear, exponential, or step'
            cand --decay-half-life 'Half-life in seconds for decay'
            cand --decay-ttl 'TTL in seconds for decay'
            cand --decay-floor 'Minimum decay factor (0.0-1.0)'
            cand --details-file 'Read details from file'
            cand --group 'Write the memory into the named group store instead of the current project. Repo-relative physical scope is stripped on group writes (see the multi-project-memories design). Mutually exclusive with `--global`'
            cand --format 'Output format'
            cand --dir 'Working directory (default: current directory)'
            cand --embedding-backend 'Embedding backend: auto, onnx, or ollama'
            cand -i 'Launch interactive TUI prompts'
            cand --interactive 'Launch interactive TUI prompts'
            cand -e 'Open $EDITOR for content entry'
            cand --editor 'Open $EDITOR for content entry'
            cand --global 'Operate on the global (cross-project) memory store instead of the current project'
            cand --json 'Output as JSON'
            cand -q 'Suppress non-essential output'
            cand --quiet 'Suppress non-essential output'
            cand -v 'Verbose output'
            cand --verbose 'Verbose output'
            cand --no-color 'No colored output'
            cand --in-process 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1'
            cand --spawn-daemon 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)'
            cand --no-maintenance 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'engramdb;get'= {
            cand --format 'Output format'
            cand --dir 'Working directory (default: current directory)'
            cand --embedding-backend 'Embedding backend: auto, onnx, or ollama'
            cand -f 'Show complete details without truncation'
            cand --full 'Show complete details without truncation'
            cand --raw 'Output the raw markdown file contents'
            cand --path 'Print the memory''s file path instead of content'
            cand --global 'Operate on the global (cross-project) memory store instead of the current project'
            cand --json 'Output as JSON'
            cand -q 'Suppress non-essential output'
            cand --quiet 'Suppress non-essential output'
            cand -v 'Verbose output'
            cand --verbose 'Verbose output'
            cand --no-color 'No colored output'
            cand --in-process 'Force in-process model loading — never contact the shared embedding daemon. Equivalent to setting ENGRAMDB_IN_PROCESS=1'
            cand --spawn-daemon 'Spawn the shared embedding daemon if it is not already running, then route through it. By default the CLI only uses a daemon that is already running (connect-only)'
            cand --no-maintenance 'Skip the automatic main-worktree maintenance pass (orphan-project cleanup + a quick store health check) for this invocation. Equivalent to setting ENGRAMDB_DISABLE_AUTO_MAINTENANCE=1'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'engramdb;query'= {
            cand --mode 'Retrieval mode. Required'
            cand --query 'Search query text (explicit flag; overrides positional when both set)'
            cand -p 'Physical path context (scoring signal)'
            cand --path 'Physical path context (scoring signal)'
            cand -l 'Logical scope context — dot-notation; scoring signal, not a filter. Repeatable'
            cand --logical 'Logical scope context — dot-notation; scoring signal, not a filter. Repeatable'
            cand -t 'Filter by type (repeatable)'
            cand --type 'Filter by type (repeatable)'
            cand --tags 'Filter by tags (comma-separated or repeated)'
            cand --min-criticality 'Minimum criticality threshold'
